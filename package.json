{
  "name": "ukcounciltax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/inject_csp_hashes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs",
    "test:text": "node scripts/check-text.mjs",
    "test:e2e": "playwright test",
    "test:csp": "playwright test --config playwright.csp.config.ts",
    "data:council-tax": "node scripts/fetch-council-tax.mjs",
    "data:registry": "node scripts/sync-registry.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "data:devolved": "python3 scripts/import-devolved.py",
    "data:local-bills": "python3 scripts/import-local-bills.py",
    "data:national": "node scripts/import-national.mjs && node scripts/import-band-stock.mjs && node scripts/import-collection-rates.mjs && node scripts/import-ra-budget.mjs && node scripts/import-population.mjs",
    "diff:numbers": "node scripts/diff-numbers.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@observablehq/plot": "0.6.17",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.5",
    "d3-geo": "^3.1.1",
    "jsdom": "29.1.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "read-excel-file": "^9.3.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "4.156.1"
  }
}
