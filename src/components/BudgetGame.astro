---
import {scoreTemplate} from '../lib/budget-game-score-template';
import {gapRowSvg} from '../lib/budget-game-geometry';
import BudgetPublishedChart from './BudgetPublishedChart.astro';
import {scenarioData} from '../lib/budget-game-scenario-data';
import {gameData} from '../lib/budget-game-data';
import {waffle} from '../vendor/estate-kit/dist/src/charts/waffle.js';
import {jsonLd} from '../lib/site';
import BudgetDoors from './BudgetDoors.astro';
import DeskBand from './DeskBand.astro';
import {budgetSetEntry} from '../lib/budget-set-entry';
interface Props {gss: string; slug: string; name: string}
const teaser = waffle({grid: true, size: 'small', site: 'ukcounciltax'});
const {name} = Astro.props;
const setEntry = budgetSetEntry(Astro.props.gss);
const data = gameData(Astro.props.gss, Astro.props.slug, Astro.props.name);
const scenario = scenarioData(data, Astro.props.gss, name);
/** The opening rail: what each round asks. The published split is the answer to round one, so no figure is drawn here. */
function routeStop(kind: string, index: number) {
  if (kind === 'split') return index === 0
    ? {name: 'Council services', task: `Split each pound ${name} spends on services.`}
    : {name: 'County services', task: 'Split each pound the county council spends on services.'};
  if (kind === 'bill') return {name: 'Your bill', task: 'Guess who takes each part of a Band D bill.'};
  if (kind === 'funding') return {name: 'Funding', task: 'Guess where the money comes from.'};
  return {name: 'Reserves', task: 'Guess what happens to reserves.'};
}
---
{data && <section id="budget-game" class="section budget-game" data-budget-game data-council-name={name} aria-labelledby="game-heading">
  <DeskBand id="game-heading" level={1} hero top as="div" class="game-desk" layout="split"
    eyebrow={`Explore the published budget | ${data.year}`} title="Could you set" accent={`${name}'s budget?`}
    lede={data.rounds.length === 5 ? `Five rounds of guessing: how ${name} splits each pound it spends on services, how the county council splits its own, who takes your Band D bill, where the money comes from, and what happens to reserves.` : `Four rounds of guessing: how ${name} splits each pound it spends on services, who takes your Band D bill, where the money comes from, and what happens to reserves.`}>
    <Fragment slot="copy">
      <noscript><p>The game needs JavaScript. {name}'s published budget, with the same figures, is in the tables below.</p></noscript>
      <p>Each round can be skipped. Answers and sources follow each round; the full published tables remain below.</p>
    </Fragment>
    <div class="game-route-wrap">
    <p class="desk-kicker" aria-hidden="true">The rounds</p>
    <ol class="game-route" data-game-route aria-label={`The ${data.rounds.length} rounds`}>
      {data.rounds.map((round, index) => { const stop = routeStop(round.kind, index); return (
        <li><span class="game-stop-number" aria-hidden="true">{index + 1}</span><span class="game-route-text"><strong>{stop.name}</strong><span>{stop.task}</span></span></li>
      ); })}
    </ol>
    </div>
    <BudgetDoors slot="foot" gss={Astro.props.gss} slug={Astro.props.slug} />
  </DeskBand>
  <div id="game-start" class="game-play" data-game-play>
  <ol class="game-rail" data-game-rail aria-label="Game progress" tabindex="0" hidden>
    {data.rounds.map((round,index)=><li><span class="game-stop-number">{index+1}</span><span class="game-stop-name">{round.kind === 'split' ? index === 0 ? 'Council' : 'County' : round.kind === 'bill' ? 'Bill' : round.kind === 'funding' ? 'Funding' : 'Reserves'}</span><span data-step-status></span></li>)}
  </ol>
  <div data-game-stage></div>
  </div>
  <template data-game-score><Fragment set:html={scoreTemplate(data,name)} /></template>
  {setEntry?.href?.endsWith('/set/') && <template data-game-set-next><a href={setEntry.href}>Now set it yourself</a></template>}
  <template data-game-gap><span set:html={gapRowSvg} /></template>
  {data.rounds.map((round, index) => (round.kind === 'split' || round.kind === 'bill') && <template data-game-grid={index}><div class="game-grid" set:html={teaser.svg.replace('A grid of 100 empty squares.', 'Your split. Each filled square is one penny.')} /></template>)}
  {data.rounds.map((round, index) => <template data-game-published={index}><BudgetPublishedChart round={round} index={index} slug={Astro.props.slug} location="reveal" /></template>)}
  <button type="button" class="button secondary" data-scenario-entry hidden>Try your version</button>
  <script type="application/json" data-budget-scenario-data set:html={jsonLd(scenario)} />
  <script type="application/json" data-budget-game-data set:html={jsonLd(data)} />
</section>}
<script>
  import '../scripts/budget-game';
</script>
<style is:global>
  .budget-game{padding-block:0 var(--space-lg);margin-top:var(--space-sm)}
  /* The hero is the shared desk band (DeskBand); only the game's own parts are styled here. */
  .budget-game .game-desk{margin-block:0;align-items:start}
  .game-desk .desk-copy > p:not(.desk-eyebrow):not(.desk-lede){margin:var(--space-sm) 0 0}
  /* W4: the opening rail as step cards on the desk. Without script it is the static route of the game. */
  .game-route-wrap{min-width:0}
  .game-route-wrap .desk-kicker{margin:0 0 var(--space-sm)}
  .game-route{list-style:none;margin:0;padding:0;display:grid;gap:.6rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr))}
  .game-route li{display:grid;grid-template-columns:2.25rem minmax(0,1fr);gap:.75rem;align-items:start;padding:.85rem 1rem;border-radius:14px;color:var(--desk-ink);background:color-mix(in srgb,var(--ground-ink) 7%,transparent);border:1px solid color-mix(in srgb,var(--ground-ink) 16%,transparent)}
  .game-route li:last-child:nth-child(odd){grid-column:1/-1}
  /* On a phone the doors, the one start control, come before the round cards so play is one tap from the first screen. */
  @media(max-width:899px){.game-desk > .game-route-wrap{order:2}.game-desk > .desk-foot{order:1}.game-desk .budget-doors{margin-top:0}.game-route li{padding:.7rem .85rem}}
  .game-route .game-stop-number{width:2.25rem;height:2.25rem;border-color:var(--accent-bright);color:var(--accent-bright);background:transparent;font-variant-numeric:tabular-nums}
  .game-route-text{display:block;padding-top:.15rem}
  .game-route-text strong{display:block;font-family:var(--font-display);font-size:var(--text-lg);line-height:1.15}
  .game-route-text span{display:block;margin-top:.2rem;color:var(--desk-soft);font-size:var(--text-sm)}
  /* The play frame: a sticky pill stepper under the site header. It scrolls inside itself on a phone,
     and turns static on a short screen or at 200% zoom so it never covers the focused control. */
  .game-play{scroll-margin-top:5rem}
  .game-rail{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;margin:var(--space-lg) 0;padding:.6rem 0}
  [data-game-rail]{position:sticky;top:calc(3.75rem + 5px);z-index:5;flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;background:var(--bg);border-bottom:1px solid var(--border)}
  .game-rail li{flex:none;display:flex;align-items:center;gap:.5rem;min-height:44px;padding:.25rem .9rem .25rem .3rem;border:1px solid var(--border-strong);border-radius:999px;background:var(--bg-card);font-size:var(--text-sm);font-weight:600;white-space:nowrap}
  .game-rail .game-stop-number{width:2rem;height:2rem;font-size:var(--text-sm)}
  .game-rail [aria-current=step]{background:var(--text);border-color:var(--text);color:var(--bg)}
  .game-rail [aria-current=step] .game-stop-number{background:var(--bg);border-color:var(--bg);color:var(--text)}
  .game-rail .done .game-stop-number{background:var(--accent);color:var(--bg);border-color:var(--accent)}
  .game-rail [data-step-status]:not(:empty){font-weight:400;color:var(--text-muted)}
  .game-rail [aria-current=step] [data-step-status]:not(:empty){color:inherit}
  .game-rail:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
  @media(max-height:34rem){[data-game-rail]{position:static}}
  @media print{[data-game-rail]{position:static;border:0}}
  .game-rail li:has(> .game-scenario-stop){padding:0}
  .game-rail .game-scenario-stop{flex-direction:row;gap:.5rem;min-height:44px;padding:.25rem .9rem .25rem .3rem;border-radius:999px}
  .game-move{display:flex;flex-wrap:wrap;gap:.4rem .75rem;align-items:baseline;max-width:44rem;margin-block:var(--space-md);padding:.85rem 1.1rem;border:2px solid var(--text);border-radius:12px;background:var(--bg-card);font-weight:600}
  .game-move strong{flex:none;padding:0 .5rem;border-radius:4px;background:var(--text);color:var(--bg);font-size:var(--text-xs);letter-spacing:.12em;text-transform:uppercase;line-height:1.9}
  @media(forced-colors:active){.game-route li,.game-rail li,.game-move{border:1px solid CanvasText}.game-rail [aria-current=step]{outline:2px solid Highlight}}
  .game-score-card a{display:inline-flex;align-items:center;min-height:44px;font-weight:600}
  .game-stop-number{display:grid;place-items:center;width:2.75rem;height:2.75rem;border:2px solid var(--border-strong);border-radius:50%;font-weight:600}


  .budget-game [hidden]{display:none!important}
  .game-score-card{max-width:40rem;padding:var(--space-lg);background:var(--accent-wash);border-radius:var(--radius)}
  .game-score-card .game-score{margin-block:.25rem}
  .game-summary-rows{list-style:none;padding:0;display:grid;gap:var(--space-sm);max-width:40rem}
  .game-score-track{display:block;height:.75rem;background:var(--bg-subtle);border:1px solid var(--border-strong);border-radius:var(--radius-sm);overflow:hidden;margin-top:.5rem}
  .game-score-fill{display:block;height:100%;background:var(--accent)}
  .budget-game h3:focus{outline:2px solid var(--accent);outline-offset:4px}
  .budget-game h3:focus:not(:focus-visible){outline:none}
  [data-scenario-stage] h2,[data-scenario-stage] h3{scroll-margin-top:6rem}
  .budget-game [data-scenario-heading]:focus{outline:2px solid var(--accent);outline-offset:4px}
  .budget-game [data-scenario-heading]:focus:not(:focus-visible){outline:none}
  .game-scenario-stop{display:flex;flex-direction:column;align-items:center;gap:.25rem;background:none;border:0;color:inherit;padding:0;cursor:pointer;font:inherit}
  .game-rows{list-style:none;padding:0;display:grid;gap:.75rem}
  .game-row{padding:1rem;border:1px solid var(--border);border-radius:8px;min-width:0}
  .game-row label,.game-row strong{display:block;margin-bottom:.5rem}
  .game-stepper{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
  .game-stepper input[type=number]{width:4.5rem;min-height:44px;text-align:center}
  .game-stepper input[type=range]{flex:1;min-width:3rem;min-height:44px;width:100%;accent-color:var(--accent)}
  .game-split{display:grid;gap:var(--space-md);align-items:start}
  .game-grid-panel{min-width:0;max-width:343px}
  .game-grid{width:100%;max-width:343px}
  .game-grid svg{display:block;width:100%;height:auto}
  .game-grid .sq-empty>rect{stroke:var(--border-strong)}
  .game-placed,.game-score{font-family:var(--font-display);font-size:var(--text-2xl);font-weight:600}
  .game-meter{width:100%;height:.4rem;accent-color:var(--accent)}
  .game-swatch{display:inline-block;width:1.25rem;height:1.25rem;border:1px solid var(--border-strong);vertical-align:middle;margin-right:.5rem;background:var(--part-paint)}
  .game-swatch.hatch-1{background-image:repeating-linear-gradient(135deg,transparent 0 5px,var(--bg) 5px 7px)}
  .game-swatch.hatch-2{background-image:repeating-linear-gradient(135deg,transparent 0 5px,var(--bg) 5px 7px),repeating-linear-gradient(45deg,transparent 0 5px,var(--bg) 5px 7px)}
  .game-check-bar{position:sticky;bottom:0;z-index:2;background:var(--bg);border-top:1px solid var(--border-strong);padding:.5rem;display:flex;gap:.5rem;align-items:center;justify-content:space-between}
  .game-check-bar p{margin:0;font-weight:600}
  .game-check-reason{font-size:var(--text-sm)}
  @media(min-width:800px){.game-split{grid-template-columns:343px minmax(0,1fr)}.game-grid-panel{position:sticky;top:1rem}.game-check-bar{position:static;justify-content:flex-start;gap:1rem}}

  .game-stepper button{min-width:44px;min-height:44px}
  .game-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1rem}
  .budget-game .source-line,.game-share{overflow-wrap:anywhere}
  .game-reveal-waffles{display:grid;gap:var(--space-md);align-items:start;margin-block:var(--space-md)}
  .game-reveal-waffles>*{min-width:0}
  .game-reveal-waffles .ek-figure{max-width:343px}
  .game-gap-row{margin-block:1rem}
  .game-gap-row p{margin:0 0 .25rem;font-size:var(--text-sm)}
  .game-gap-svg{display:block;width:100%;max-width:600px;height:auto}
  .game-gap-track{height:1rem;position:relative;background:var(--bg-subtle)}
  .game-gap-track:before{content:"";position:absolute;left:50%;height:100%;border-left:1px solid var(--border-strong)}
  .game-gap-bar{position:absolute;height:100%;background:var(--accent)}
  @media(min-width:800px){.game-reveal-waffles{grid-template-columns:1fr 1fr}}
  .game-scenario-table{max-width:100%;overflow-x:auto;margin-block:var(--space-md)}
  .game-scenario-table table{width:100%;table-layout:fixed}
  .game-scenario-table th,.game-scenario-table td{padding:.4rem;white-space:normal;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
  .game-scenario-table th:first-child{width:28%;text-align:left}
  .game-scenario-table thead th:nth-child(2){width:14%}
  .game-scenario-table [data-record-type=observation]{background:var(--bg-subtle)}
  .game-scenario-table [data-scenario-pence]{background:var(--accent-wash)}
  @media(max-width:599px){.game-scenario-table table{font-size:.75rem}}
  .game-result{background:var(--accent-wash);padding:1rem;border-radius:8px;margin-block:1rem}
  .game-result li{margin-block:.75rem}
  .game-direction{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin-block:var(--space-sm)}
  .game-direction label{display:flex;gap:.25rem;align-items:center;min-height:44px;padding:.5rem;border:1px solid var(--border-strong);border-radius:var(--radius-sm);font-weight:600;cursor:pointer}
  .game-direction label:has(:checked){background:var(--accent-wash);border-color:var(--accent)}
  .game-direction input{accent-color:var(--accent);flex-shrink:0}
  .budget-game fieldset{min-width:0;margin-block:1rem;border:1px solid var(--border);padding:1rem}
  .budget-game select{max-width:100%;width:100%;min-height:44px}
  .budget-game legend{font-weight:600}
  .game-status{font-weight:600}
</style>
