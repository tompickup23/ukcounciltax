---
import {gameChart, gameChartPng} from '../lib/budget-game-charts';
import ChartFigure from '../vendor/estate-kit/src/components/ChartFigure.astro';
import ChartActions from './kit/ChartActions.astro';
import type {GameRound} from '../lib/budget-game';
interface Props {round: GameRound; index: number; slug: string; location: string}
const {round, index, slug, location} = Astro.props;
const id = `${location}-round-${index}`;
const {out, keys, captionHtml} = gameChart(round, `budget-${slug}-${index}`);
---
<div id={id} data-fact data-published-round={index} data-round-kind={round.kind}>
  <ChartFigure out={out} keys={keys} id={`${id}-table`} />
  <ChartActions target={id} captionHtml={captionHtml} pngs={{light: gameChartPng(slug,index,'light'), dark: gameChartPng(slug,index,'dark')}} />
</div>
