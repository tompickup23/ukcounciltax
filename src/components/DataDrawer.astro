---
/** Adapted from UK Demographics' DataDrawer: keep the heading outside summary. */
interface Props {id: string; title: string; tableCount: number; open?: boolean; summary?: string; headingLevel?: "h2" | "h3"; lede?: string; pageBreak?: boolean}
const {id, title, tableCount, open = false, summary = `Show the published tables (${tableCount})`, headingLevel: Heading = "h2", lede, pageBreak = false} = Astro.props;
---
<section class:list={['section', 'data-drawer-section', {'data-drawer-break': pageBreak}]} aria-labelledby={`${id}-heading`}>
  <Heading id={`${id}-heading`}>{title}</Heading>
  {lede && <p class="data-drawer-lede">{lede}</p>}
  <details id={id} class="data-drawer" open={open}>
    <summary>{summary}</summary>
    <div class="data-drawer-body"><slot /></div>
  </details>
</section>
<script>
  function openDrawersForHash() {
    let id: string;
    try {id = decodeURIComponent(location.hash.slice(1));} catch {return;}
    const target = document.getElementById(id);
    if (!target) return;
    for (let parent: HTMLElement | null = target; parent; parent = parent.parentElement) {
      if (parent instanceof HTMLDetailsElement) parent.open = true;
    }
    if (target.closest('.data-drawer')) target.scrollIntoView();
  }
  window.addEventListener('hashchange', openDrawersForHash);
  openDrawersForHash();
</script>
<style>
  summary{cursor:pointer;font-weight:600;min-height:44px;padding-block:var(--space-sm)}
  .data-drawer{border-block:1px solid var(--border)}
  .data-drawer-body{padding-block:var(--space-sm)}
  /* W4: a break that ends the game and starts the reference record (D5). */
  .data-drawer-break{margin-top:var(--space-xl);padding-top:var(--space-lg);border-top:4px solid var(--text)}
  .data-drawer-break h2{font-size:var(--text-2xl);margin:0}
  .data-drawer-lede{max-width:44rem;margin:var(--space-xs) 0 var(--space-md);color:var(--text-muted)}
  .data-drawer-break summary{display:flex;align-items:center;gap:.6rem;padding:.75rem 1.1rem;border:1px solid var(--border-strong);border-radius:999px;background:var(--bg-card);width:fit-content;max-width:100%;list-style:none}
  .data-drawer-break summary::-webkit-details-marker{display:none}
  .data-drawer-break summary::before{content:"+";display:grid;place-items:center;width:1.5rem;height:1.5rem;border-radius:50%;background:var(--text);color:var(--bg);font-weight:700;line-height:1}
  .data-drawer-break details[open] > summary::before{content:"\2212"}
  .data-drawer-break .data-drawer{border:0}
  .data-drawer-break summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
</style>
