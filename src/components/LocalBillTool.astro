---
import {localBills} from '../lib/local-bill-data';
import {taxRows} from '../lib/tax-view-data';
import {jsonLd} from '../lib/site';
---
<section data-local-bill class="section">
<form data-local-postcode class="card"><label class="field">Your postcode<input name="postcode" autocomplete="postal-code" maxlength="10" placeholder="e.g. BB11 1DU" required /></label><button class="button" type="submit" disabled>Find charging area</button><p class="small muted">Sent only to postcodes.io. Never stored or added to a share link. <a href="/privacy/">Privacy</a>.</p><p data-postcode-status role="status"></p></form>
<p class="caveat">Postcodes can cross boundaries. The result suggests an area; confirm your parish or locality against your bill before using its charge.</p>
<form data-local-controls class="card section"><div class="task-grid"><label class="field">Council with a complete imported schedule<select name="council"><option value="">Choose an imported council</option>{localBills.map(b=><option value={b.gss}>{b.name}</option>)}</select></label><label class="field">Parish or locality<select name="locality"><option value="">Choose and confirm your locality</option>{localBills[0].localities.map(l=><option value={l.id}>{l.name}</option>)}</select></label><label class="field">Property band<select name="band">{'ABCDEFGH'.split('').map(b=><option selected={b==='D'}>{b}</option>)}</select></label></div><label class="confirm-locality"><input name="confirmed" type="checkbox" /> I have checked that this is my property's charging locality.</label><button class="button" type="submit" disabled>Show the published breakdown</button></form>
<div data-bill-result hidden aria-live="polite"><h2 data-bill-title></h2><p class="lede" data-bill-total></p><p data-bill-source class="source-line"></p><div class="table-wrap" tabindex="0" role="region" aria-label="Bill components"><table class="data"><caption>Published annual charge by collecting body, before discounts and premiums</caption><thead><tr><th scope="col">Body</th><th scope="col">Component</th><th scope="col" class="num">Annual charge</th><th scope="col" class="num">Share of bill</th></tr></thead><tbody data-components></tbody></table></div><p data-other-charges class="caveat"></p><p data-instalments></p>
<details class="card section"><summary>Model different increases for each component</summary><p>Illustrative assumptions, not published decisions. Each body can change its share at a different rate. Bundled services stay together; fire or police charges already included in a mayoral precept must not be added again.</p><form data-component-model><div data-rate-fields class="task-grid"></div><label class="field">Years ahead<select name="years"><option>1</option><option>3</option><option selected>5</option><option>10</option></select></label><button class="button" type="submit" disabled>Model these changes</button></form><p data-component-result role="status"></p></details>
</div><p data-bill-error role="status"></p>
<noscript><p>The postcode and modelling tools need JavaScript. The <a href="/precepts/">published Burnley schedule</a> below remains readable.</p></noscript>
<script type="application/json" data-bill-data set:html={jsonLd({localBills,rows:taxRows().map(({gss,slug,name})=>({gss,slug,name}))})} />
</section>
<script>
import {resolveBill,modelComponents,type LocalBill} from '../lib/local-bill';
import {moneyPence,type TaxRow} from '../lib/tax-view';
const root=document.querySelector('[data-local-bill]')!;
const data=JSON.parse(root.querySelector('[data-bill-data]')!.textContent!) as {localBills:LocalBill[];rows:TaxRow[]};
const form=root.querySelector<HTMLFormElement>('[data-local-controls]')!;
const field=(n:string)=>form.elements.namedItem(n) as HTMLInputElement|HTMLSelectElement;
const confirmed=field('confirmed') as HTMLInputElement;
root.querySelectorAll<HTMLButtonElement>('button[type=submit]').forEach(b=>b.disabled=false);
const result=root.querySelector<HTMLElement>('[data-bill-result]')!;
const error=root.querySelector('[data-bill-error]')!;
let parts:{id:string;name:string;pence:number;kind:string}[]=[];let baseline=0;
const invalidate=()=>{result.hidden=true;parts=[];baseline=0;error.textContent='';};
form.addEventListener('change',e=>{invalidate();if(e.target===field('locality')||e.target===field('council'))confirmed.checked=false;if(e.target===field('council')){const bill=data.localBills.find(b=>b.gss===field('council').value);const select=field('locality') as HTMLSelectElement;select.replaceChildren(new Option('Choose and confirm your locality',''),...(bill?.localities??[]).map(l=>new Option(l.name,l.id)));}});
form.addEventListener('submit',e=>{e.preventDefault();invalidate();try{
 if(!confirmed.checked)throw new Error('Confirm the charging locality against your property before viewing the breakdown.');
 const bill=data.localBills.find(b=>b.gss===field('council').value);if(!bill)throw new Error('Choose a council with an imported schedule.');const band=field('band').value;
 const resolved=resolveBill(bill,field('locality').value,band);parts=resolved.parts;baseline=resolved.total;
 root.querySelector('[data-bill-title]')!.textContent=`${bill.name}: ${resolved.locality.name}, Band ${band}`;
 root.querySelector('[data-bill-total]')!.textContent=`${moneyPence(baseline)} in ${bill.year.replace('-','/')}, before discounts and premiums.`;
 const source=root.querySelector('[data-bill-source]')!;source.replaceChildren();const a=document.createElement('a');a.href=bill.source.url;a.textContent=`${bill.source.publisher}, ${bill.source.title}`;source.append('Source: ',a,`. Retrieved ${bill.source.retrieved}. All components reconcile to the published locality total.`);
 const body=root.querySelector('[data-components]')!;body.replaceChildren();const rates=root.querySelector('[data-rate-fields]')!;rates.replaceChildren();
 for(const p of parts){const tr=document.createElement('tr');[p.name,p.kind,moneyPence(p.pence),(p.pence/baseline*100).toFixed(1)+'%'].forEach((v,i)=>{const td=document.createElement(i===0?'th':'td');td.textContent=v;if(i===0)td.setAttribute('scope','row');if(i>1)td.className='num';tr.append(td);});body.append(tr);const label=document.createElement('label');label.className='field';label.textContent=`${p.name}: assumed annual change (%)`;const input=document.createElement('input');input.type='number';input.name=p.id;input.value='5';input.min='-50';input.max='50';input.step='0.01';input.required=true;label.append(input);rates.append(label);}
 root.querySelector('[data-other-charges]')!.textContent=bill.otherCharges.map(c=>c.note).join(' ')+(resolved.locality.parishPence?'':' No parish addition in this published unparished schedule.');
 root.querySelector('[data-instalments]')!.textContent=`Budgeting equivalents: ${moneyPence(Math.round(baseline/10))} over ten payments or ${moneyPence(Math.round(baseline/12))} over twelve. Rounded illustrations; your council sets the actual instalments.`;
 root.querySelector('[data-component-result]')!.textContent='';result.hidden=false;
 }catch(err){error.textContent=(err as Error).message;}});
root.querySelector<HTMLFormElement>('[data-component-model]')!.addEventListener('submit',e=>{e.preventDefault();const f=e.currentTarget as HTMLFormElement;const output=root.querySelector('[data-component-result]')!;try{const rates=Object.fromEntries(parts.map(p=>{const el=f.elements.namedItem(p.id) as HTMLInputElement;return[p.id,el.value.trim()===''?NaN:Number(el.value)];}));const years=Number((f.elements.namedItem('years') as HTMLSelectElement).value);const projected=modelComponents(parts,rates,years).reduce((sum,p)=>sum+p.projectedPence,0);output.textContent=`Illustrative annual charge after ${years} years: ${moneyPence(projected)}. Change from the published baseline: ${moneyPence(projected-baseline)} (${((projected/baseline-1)*100).toFixed(2)}%). Each component compounds separately and is rounded to pennies before summing.`;}catch(err){output.textContent=(err as Error).message;}});
let requestId=0;
root.querySelector<HTMLFormElement>('[data-local-postcode]')!.addEventListener('submit',async e=>{e.preventDefault();const id=++requestId;invalidate();confirmed.checked=false;field('locality').value='';const postcode=((e.currentTarget as HTMLFormElement).elements.namedItem('postcode') as HTMLInputElement).value.trim().toUpperCase();const status=root.querySelector('[data-postcode-status]')!;status.replaceChildren();if(!/^[A-Z]{1,2}[0-9][A-Z0-9]?\s?[0-9][A-Z]{2}$/.test(postcode)){status.textContent='Enter a full UK postcode.';return;}status.textContent='Looking up the charging area...';try{const response=await fetch(`https://api.postcodes.io/postcodes/${encodeURIComponent(postcode)}`);if(!response.ok)throw new Error('Postcode lookup unavailable or postcode not found. You can choose an imported area manually.');const {result:r}=await response.json();if(id!==requestId)return;const bill=data.localBills.find(b=>b.gss===r.codes?.admin_district);if(!bill){field('council').value='';const row=data.rows.find(v=>v.gss===r.codes?.admin_district);status.textContent=`${r.admin_district}: a complete local precept breakdown is not yet imported. Missing fire, police, mayoral or parish amounts are not treated as zero. `;if(row){const link=document.createElement('a');link.href=`/councils/${row.slug}/`;link.textContent='View the published area average';status.append(link);}return;}
 field('council').value=bill.gss;const select=field('locality') as HTMLSelectElement;select.replaceChildren(new Option('Choose and confirm your locality',''),...bill.localities.map(l=>new Option(l.name,l.id)));const match=bill.localities.find(l=>l.parishNames.some(n=>n.toLowerCase()===String(r.parish).toLowerCase()));if(match)select.value=match.id;status.textContent=`${bill.name}. Postcode geography suggests ${r.parish??'an unconfirmed locality'}. ${match?'Check the suggested locality below.':'Choose your locality below.'} A postcode is not an exact property match.`;
 }catch(err){if(id===requestId)status.textContent=(err as Error).message;}});
</script>
<style>.confirm-locality{display:block;margin:1rem 0;}.confirm-locality input{margin-right:.5rem;} [data-local-postcode]{max-width:40rem;} [data-local-controls] button{margin-top:1rem;}</style>
