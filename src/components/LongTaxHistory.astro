---
import {national} from '../lib/national-data';
import BandDLine from './BandDLine.astro';
import DataDrawer from './DataDrawer.astro';
import SourceLine from './SourceLine.astro';
import {pounds, wholePounds, yearLabel} from '../lib/council-tax';
interface Props {gss: string; name: string; view: 'chart'}
const {gss, name} = Astro.props;
const series = national.history[gss];
const source = national.sources.history;
const years = series ? Object.keys(series.area.values) : [];
const available = years.filter(year => series.area.values[year] !== null);
const precision = available.some(year => !Number.isInteger(series.area.values[year])) ? 'at the published precision' : 'in whole pounds';
const historyPounds = (value: number) => Number.isInteger(value) ? wholePounds(value) : pounds(value);
const first = available[0], last = available.at(-1);
const reference = {publisher: source.publisher, title: source.title, url: source.fileUrl, table: 'Area_CT', retrieved: source.retrieved};
---
{series && <>
  <div class="fact" data-fact>
    <BandDLine id={`band-d-line-${gss}`} series={years.map(year => ({year, value: series.area.values[year]}))} format={historyPounds} title={`Band D area council tax in ${name}, ${first?.replace('-', '/')} to ${last?.replace('-', '/')}`} basis={`Band D area council tax, including average parish precepts, as published each year ${precision}`} table={false}>
      <SourceLine source={reference} />
      <p class="caveat">Cash figures, not adjusted for inflation. Includes average parish precepts, so the Band D bill in any one parish or unparished part of {name} can differ from this figure.</p>
    </BandDLine>
  </div>
  <DataDrawer id="history-values" title="Published Band D values" headingLevel="h3" tableCount={1} summary={`Show the ${available.length} published values`}>
    <div class="fact" data-fact>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Published Band D history">
        <table class="data"><caption>Area Band D in {name}, as published each year {precision}</caption>
          <thead><tr><th scope="col">Year</th><th scope="col" class="num">Band D</th></tr></thead>
          <tbody>{available.map(year => <tr><th scope="row">{yearLabel(year)}</th><td class="num" data-figure>{historyPounds(series.area.values[year]!)}</td></tr>)}</tbody>
        </table>
      </div>
      <SourceLine source={reference} />
    </div>
  </DataDrawer>
</>}
