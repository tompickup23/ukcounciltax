---
/**
 * Anchor navigation adapted from UK Demographics, using this site's tokens.
 *
 * rail (W9): the contents sit in a details element, closed on phones. From 1100px
 * wide the summary is hidden and the list is always shown, so the page can hold
 * it in a sticky side rail. At 200% zoom a 1440px window is 720 CSS pixels wide,
 * so the rail falls back to the details element there too. A browser without
 * ::details-content keeps the summary at every width, so the list is never lost.
 */
interface Item { id: string; label: string }
interface Props { items?: Item[]; groups?: {label: string; items: Item[]}[]; rail?: boolean }
const {items = [], groups = [], rail = false} = Astro.props;
---
{rail ? (
  <nav aria-label="On this page" class="page-contents page-contents--rail">
    <details class="contents-details">
      <summary class="contents-summary">On this page</summary>
      <div class="contents-groups">{groups.filter(group => group.items.length).map(group => <div data-contents-group>
        <h2>{group.label}</h2>
        <ul>{group.items.map(item => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul>
      </div>)}</div>
    </details>
  </nav>
) : (
<nav aria-label="On this page" class="page-contents">
  <p class="eyebrow">On this page</p>
  {groups.length ? <div class="contents-groups">{groups.filter(group => group.items.length).map(group => <div data-contents-group>
    <h2>{group.label}</h2>
    <ul class="pill-nav">{group.items.map(item => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul>
  </div>)}</div> : <ul class="pill-nav">{items.map(item => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul>}
</nav>
)}
<style>
  .page-contents { margin: 1.5rem 0; padding: 1rem 0; border-block: 1px solid var(--border); }
  .contents-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.5rem; }
  .contents-groups h2 { margin: 0 0 0.35rem; font-family: var(--font-sans); font-size: 1rem; }
  .contents-groups ul { list-style: none; margin: 0; padding: 0; }
  @media (max-width: 599px) { .contents-groups { grid-template-columns: 1fr; } }

  .page-contents--rail { margin: 0 0 var(--space-lg); padding: 0; }
  .contents-summary { display: list-item; min-height: 44px; box-sizing: border-box; padding-block: 0.7rem; cursor: pointer; font-weight: 600; font-size: var(--text-sm); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .contents-details[open] > .contents-summary { border-bottom: 1px solid var(--border); }
  .page-contents--rail .contents-groups { padding-block: var(--space-sm) var(--space-md); }
  .page-contents--rail .contents-groups h2 { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
  .page-contents--rail li a { display: block; padding-block: 0.3rem; line-height: 1.3; text-decoration: none; }
  .page-contents--rail li a:hover { text-decoration: underline; }
  @media (min-width: 600px) and (max-width: 1099px) { .page-contents--rail .contents-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) {
    .page-contents--rail { border: 0; }
    .page-contents--rail .contents-groups { grid-template-columns: 1fr; gap: var(--space-md); padding-top: 0; }
    .page-contents--rail li a { font-size: var(--text-sm); padding-block: 0.25rem; }
    @supports selector(::details-content) {
      .contents-details > .contents-summary { display: none; }
      .contents-details::details-content { display: block; content-visibility: visible; }
    }
  }
</style>
