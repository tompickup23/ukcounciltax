---
/**
 * The page's one Sources block (F1, plan section 11.5). Every record line on the
 * page links to one of these entries, which carries the method in full and each
 * source's publisher, full title, table, publication and retrieval dates.
 * An optional slot named for an entry key preserves bespoke legacy citations
 * verbatim. Without a slot, existing callers render the same reference markup.
 */
import { longDate, sourceEntryId, type SourceRef } from "../lib/sources";

export interface SourceEntry {
  key: string;
  /** What the entry covers, as a short label. */
  label: string;
  method?: string;
  sources: readonly SourceRef[];
  /** Licence or attribution words required with the sources. */
  note?: string;
}

interface Props {
  entries: readonly SourceEntry[];
}

const { entries } = Astro.props;
const tail = (s: SourceRef) => {
  const published = longDate(s.date);
  const retrieved = longDate(s.retrieved);
  return `${s.table ? `, ${s.table}` : ""}${published ? `, published ${published}` : ""}${retrieved ? `, retrieved ${retrieved}` : ""}`;
};
---
<section class="page-sources" id="sources" aria-labelledby="sources-heading" data-page-sources>
  <h2 id="sources-heading">Sources</h2>
  <ol>
    {entries.map((e) => (
      <li id={sourceEntryId(e.key)}>
        <p><strong>{e.label}.</strong>{e.method && ` ${e.method}.`}</p>
        <slot name={e.key}><p>{e.sources.map((s, i) => <>{i > 0 && "; "}<a href={s.url}>{s.publisher}, {s.title}</a>{tail(s)}</>)}.{e.note && ` ${e.note}`}</p></slot>
      </li>
    ))}
  </ol>
</section>
