---
/**
 * The budget band (W0, design audit of 15 November 2026): the two ways into a
 * council's budget, the game and set mode, as two equal doors on a dark band.
 * Static anchors, so it works without JavaScript; no figure is printed except
 * the two coverage counts, which come from the budget returns and the set mode
 * eligibility manifest. Both doors lead to the picker on the budget hub, where
 * a council's name opens its game and its Set link opens set mode.
 */
import DeskBand from "./DeskBand.astro";
import manifest from "../../data/pilots/budget-freeze-eligibility.json";
import { councilPages } from "../lib/paths";
import { budgetFor, budgetYear } from "../lib/budget";

interface Props {
  /** The heading level, so the band sits under the page's own outline. */
  level?: 2 | 3;
  guessHref?: string;
}

const { level = 2, guessHref = '/tools/budget/' } = Astro.props;
const pages = councilPages();
const games = pages.filter(({ council }) => budgetFor(council.gss).council.status === "available").length;
const sets = manifest.councils.filter((row) => row.eligible).length;
const setHref = "/tools/budget/#set-the-budget";
---
<DeskBand id="play-band-heading" level={level} class="play-band" data-play-band data-pagefind-ignore
  eyebrow={`Council budgets | ${budgetYear}`} title="Could you set your council's" accent="budget?"
  lede="Two ways in, both built from each council's own published budget return. Every answer shows its source.">
  <div class="play-doors">
    <a class="play-door desk-card" href={guessHref} data-play-door="guess">
      <span class="desk-kicker">Guess</span>
      <strong>Play the budget game</strong>
      <span class="play-text">Guess how each pound is spent, who takes your bill, where the money comes from and what happens to reserves, then see what the council published.</span>
      <span class="play-foot"><span class="play-count">{games} councils</span><span class="play-go" aria-hidden="true">Choose a council</span></span>
    </a>
    <a class="play-door desk-card" href={setHref} data-play-door="set">
      <span class="desk-kicker">Set</span>
      <strong>Set the budget yourself</strong>
      <span class="play-text">Start from last year's own council charge, change tax and service spending and see what is left to find. An exploration with its assumptions shown, not a forecast.</span>
      <span class="play-foot"><span class="play-count">{sets} councils</span><span class="play-go" aria-hidden="true">Choose a council</span></span>
    </a>
  </div>
</DeskBand>

<style>
/* The band itself is the shared desk (DeskBand and the .desk classes in global.css). */
.play-doors{display:grid;gap:var(--space-md)}
@media(min-width:600px){.play-doors{grid-template-columns:repeat(2,minmax(0,1fr))}}
.play-door strong{font-family:var(--font-display);font-weight:600;font-size:var(--text-lg);line-height:1.15;color:var(--ground-ink)}
.play-text{color:color-mix(in srgb,var(--ground-ink) 82%,transparent);font-size:var(--text-base)}
.play-foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:var(--space-xs);margin-top:auto;padding-top:var(--space-sm)}
.play-count{font-size:var(--text-sm);color:color-mix(in srgb,var(--ground-ink) 75%,transparent)}
.play-go{display:inline-flex;align-items:center;padding:.5rem 1rem;border-radius:999px;background:var(--accent-bright);color:var(--ground);font-weight:600;font-size:var(--text-sm)}
.play-go::after{content:"\2192";margin-left:.4rem}
@media print{.play-go{display:none}}
@media(forced-colors:active){.play-go{border:1px solid ButtonText}}
</style>
