---
/**
 * The budget band (W0, design audit of 15 November 2026): the two ways into a
 * council's budget, the game and set mode, as two equal doors on a dark band.
 * Static anchors, so it works without JavaScript; no figure is printed except
 * the two coverage counts, which come from the budget returns and the set mode
 * eligibility manifest. Both doors lead to the picker on the budget hub, where
 * a council's name opens its game and its Set link opens set mode.
 */
import manifest from "../../data/pilots/budget-freeze-eligibility.json";
import { councilPages } from "../lib/paths";
import { budgetFor, budgetYear } from "../lib/budget";

interface Props {
  /** The heading level, so the band sits under the page's own outline. */
  level?: 2 | 3;
}

const { level = 2 } = Astro.props;
const pages = councilPages();
const games = pages.filter(({ council }) => budgetFor(council.gss).council.status === "available").length;
const sets = manifest.councils.filter((row) => row.eligible).length;
const guessHref = "/tools/budget/";
const setHref = "/tools/budget/#set-the-budget";
const Heading = level === 2 ? "h2" : "h3";
---
<section class="play-band" aria-labelledby="play-band-heading" data-play-band data-pagefind-ignore>
  <div class="play-copy">
    <p class="play-eyebrow">Council budgets | {budgetYear}</p>
    <Heading id="play-band-heading" class="play-title">Could you set your council's <span>budget?</span></Heading>
    <p class="play-lede">Two ways in, both built from each council's own published budget return. Every answer shows its source.</p>
  </div>
  <div class="play-doors">
    <a class="play-door" href={guessHref} data-play-door="guess">
      <span class="play-kicker">Guess</span>
      <strong>Play the budget game</strong>
      <span class="play-text">Guess how each pound is spent, who takes your bill, where the money comes from and what happens to reserves, then see what the council published.</span>
      <span class="play-foot"><span class="play-count">{games} councils</span><span class="play-go" aria-hidden="true">Choose a council</span></span>
    </a>
    <a class="play-door" href={setHref} data-play-door="set">
      <span class="play-kicker">Set</span>
      <strong>Set the budget yourself</strong>
      <span class="play-text">Start from last year's own council charge, change tax and service spending and see what is left to find. An exploration with its assumptions shown, not a forecast.</span>
      <span class="play-foot"><span class="play-count">{sets} councils</span><span class="play-go" aria-hidden="true">Choose a council</span></span>
    </a>
  </div>
</section>

<style>
/* A dark band in the site's accent: the one flagship action on the page (Ledger and Desk). */
.play-band{
  --play-ground:color-mix(in srgb,var(--accent) 26%,var(--ground));
  display:grid;gap:var(--space-lg);align-items:center;
  margin-block:var(--space-xl);padding:clamp(1.5rem,1rem + 3vw,3rem);
  border-radius:18px;background:var(--play-ground);color:var(--ground-ink);
  border:1px solid color-mix(in srgb,var(--accent-bright) 30%,transparent);
}
@media(min-width:900px){.play-band{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:var(--space-2xl)}}
.play-eyebrow{display:flex;align-items:center;gap:.6rem;margin:0 0 var(--space-sm);font-size:var(--text-xs);font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-bright)}
.play-eyebrow::before{content:"";width:28px;height:2px;background:currentColor;flex:none}
.play-band .play-title{margin:0;color:var(--ground-ink);font-size:clamp(2rem,1.4rem + 2.6vw,3.4rem);line-height:1.04;letter-spacing:-.02em;text-wrap:balance}
.play-title span{color:var(--accent-bright)}
.play-lede{margin:var(--space-md) 0 0;max-width:30rem;font-size:var(--text-md);color:color-mix(in srgb,var(--ground-ink) 88%,transparent)}
.play-doors{display:grid;gap:var(--space-md)}
@media(min-width:600px){.play-doors{grid-template-columns:repeat(2,minmax(0,1fr))}}
.play-door{
  display:flex;flex-direction:column;gap:var(--space-xs);min-width:0;min-height:44px;
  padding:var(--space-lg);border-radius:14px;text-decoration:none;color:var(--ground-ink);
  background:color-mix(in srgb,var(--ground-ink) 7%,transparent);
  border:1px solid color-mix(in srgb,var(--ground-ink) 16%,transparent);
}
.play-door:hover{border-color:var(--accent-bright);background:color-mix(in srgb,var(--ground-ink) 11%,transparent)}
.play-door:focus-visible{outline:3px solid var(--accent-bright);outline-offset:3px}
.play-kicker{font-size:var(--text-xs);font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-bright)}
.play-door strong{font-family:var(--font-display);font-weight:600;font-size:var(--text-lg);line-height:1.15;color:var(--ground-ink)}
.play-text{color:color-mix(in srgb,var(--ground-ink) 82%,transparent);font-size:var(--text-base)}
.play-foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:var(--space-xs);margin-top:auto;padding-top:var(--space-sm)}
.play-count{font-size:var(--text-sm);color:color-mix(in srgb,var(--ground-ink) 75%,transparent)}
.play-go{display:inline-flex;align-items:center;padding:.5rem 1rem;border-radius:999px;background:var(--accent-bright);color:var(--ground);font-weight:600;font-size:var(--text-sm)}
.play-go::after{content:"\2192";margin-left:.4rem}
@media(prefers-reduced-motion:no-preference){.play-door{transition:transform .15s ease,border-color .15s ease,background-color .15s ease}.play-door:hover{transform:translateY(-2px)}}
@media print{.play-band{background:none;color:inherit;border:1px solid}.play-band *{color:inherit!important}.play-go{display:none}}
@media(forced-colors:active){.play-band,.play-door{border:1px solid CanvasText}.play-go{border:1px solid ButtonText}}
</style>
