---
/**
 * The postcode door. The postcode goes to api.postcodes.io and nowhere else:
 * it is never written into this site's own address, a query string or
 * storage. The district code that comes back is looked up in an index of
 * councils embedded in the page as JSON data (not script, so the CSP has no
 * say over it), and the visitor lands on that council's page at the section
 * asked for.
 *
 * Without JavaScript the form does nothing, and the list of councils is one
 * link away.
 */
import { councilPages, councilPath } from "../lib/paths";
import {devolved,nationPath} from '../lib/devolved';
import { loadRegistry } from "../lib/registry";

interface Props {
  id?: string;
  heading?: string;
}

const { id = "postcode", heading = "Find your council by postcode" } = Astro.props;
const withPage = new Map(councilPages().map(({ council, tax }) => [council.gss, { href: councilPath(council), name: tax.name }]));
for (const edition of devolved.editions.filter(e=>e.year==='2026-27')) for (const row of edition.records) withPage.set(row.gss,{href:nationPath(edition.nation,row.slug),name:row.name});
const index = Object.fromEntries(
  Object.values(loadRegistry().councils).map((c) => [
    c.gss,
    withPage.get(c.gss) ?? { href: null, name: c.name, country: c.country },
  ]),
);
---
<form class="postcode-door card" data-postcode-door data-section="council-tax" novalidate>
  <label for={id} class="door-label">{heading}</label>
  <div class="door-row">
    <input
      id={id}
      data-postcode-input
      type="text"
      inputmode="text"
      autocomplete="postal-code"
      autocapitalize="characters"
      spellcheck="false"
      placeholder="e.g. BB11 1DU"
      maxlength="10"
      required
      aria-describedby={`${id}-status ${id}-note`}
    />
    <button type="submit" disabled>Find</button>
  </div>
  <p class="door-status" id={`${id}-status`} role="status" aria-live="polite" data-door-status></p>
  <p class="door-note" id={`${id}-note`}>
    Your postcode is sent to postcodes.io to find the council for it, and is not stored.
    <a href="/privacy/">Privacy</a>. Or <a href="/councils/">choose from the list</a>.
  </p>
  <noscript><p>Postcode lookup needs JavaScript. <a href="/councils/">Browse all councils</a>.</p></noscript>
  <script type="application/json" data-council-index set:html={JSON.stringify(index).replace(/</g, "\\u003c")} />
</form>

<script>
  interface Entry {
    href: string | null;
    name: string;
    country?: string;
  }

  const POSTCODE = /^[A-Z]{1,2}[0-9][A-Z0-9]?\s?[0-9][A-Z]{2}$/;

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-postcode-door]")) {
    const input = form.querySelector<HTMLInputElement>("[data-postcode-input]");
    const status = form.querySelector<HTMLElement>("[data-door-status]");
    const indexEl = form.querySelector<HTMLScriptElement>("[data-council-index]");
    if (!input || !status || !indexEl) continue;
    form.querySelector<HTMLButtonElement>("button")!.disabled = false;
    const index = JSON.parse(indexEl.textContent ?? "{}") as Record<string, Entry>;
    const say = (text: string) => {
      status.textContent = text;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const postcode = input.value.toUpperCase().replace(/\s+/g, " ").trim();
      if (!POSTCODE.test(postcode)) {
        say("That does not look like a UK postcode. Try the full postcode, for example BB11 1DU.");
        return;
      }
      say("Finding your council...");
      let code: string | undefined;
      try {
        const response = await fetch(`https://api.postcodes.io/postcodes/${encodeURIComponent(postcode)}`);
        if (response.status === 404) {
          say("postcodes.io does not know that postcode. Check it, or choose your council from the list.");
          return;
        }
        if (!response.ok) throw new Error(String(response.status));
        const body = (await response.json()) as { result?: { codes?: { admin_district?: string } } };
        code = body.result?.codes?.admin_district;
      } catch {
        say("The postcode lookup did not answer. Try again, or choose your council from the list.");
        return;
      }
      const entry = code ? index[code] : undefined;
      if (!entry) {
        say("That postcode is not in a council this site holds. Choose your council from the list.");
        return;
      }
      if (!entry.href) {
        say(`${entry.name} is in ${entry.country}. Northern Ireland uses domestic rates rather than council tax. See UK coverage for official rate-bill guidance.`);
        return;
      }
      say(`Opening ${entry.name}...`);
      window.location.assign(`${entry.href}#${form.dataset.section ?? "council-tax"}`);
    });
  }
</script>

<style>
  .postcode-door { max-width: 34rem; }
  .door-label { display: block; font-weight: 600; font-size: 1.05rem; margin-bottom: 0.5rem; }
  .door-row { display: flex; gap: 0.5rem; }
  .door-row input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1.1rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    text-transform: uppercase;
  }
  .door-row input::placeholder { text-transform: none; color: var(--text-faint); }
  .door-row button {
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .door-status { min-height: 1.4em; margin: 0.5rem 0 0; }
  .door-note { margin: 0.25rem 0 0; font-size: 0.85rem; color: var(--text-muted); }
</style>
