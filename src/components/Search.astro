---
/** Native dialog and lazy Pagefind pattern adapted from UK Elections. */
---
<a href="/councils/" class="search-trigger button secondary" data-search-open aria-haspopup="dialog">Search</a>
<dialog class="site-search" aria-labelledby="search-title" data-site-search data-pagefind-ignore>
  <form method="dialog"><button class="button secondary" aria-label="Close search">Close</button></form>
  <h2 id="search-title">Search UK Council Tax</h2>
  <label class="field" for="site-search-input">Council, region or topic<input id="site-search-input" type="search" autocomplete="off" placeholder="Try Burnley or council tax" /></label>
  <p role="status" data-search-status>Type to search council pages and guides.</p>
  <section data-search-councils hidden aria-labelledby="search-councils-title">
    <h3 id="search-councils-title">Councils</h3>
    <ul class="search-councils" data-search-council-results></ul>
    <button type="button" class="button secondary" data-search-councils-more hidden>Show more councils</button>
  </section>
  <ol data-search-results></ol>
  <button type="button" class="button secondary" data-search-more hidden>Show more results</button>
  <button type="button" class="button secondary" data-search-retry hidden>Retry search</button>
  <p class="small muted">Search runs in your browser. <a href="/councils/">Browse all councils</a> or <a href="/your-area/">find your area by postcode</a>.</p>
</dialog>
<script>
  import { COUNCILS_SHOWN, matchesCouncil, matchingRegion, normalise, rankCouncils, searchStatus } from "../lib/council-search";
  import type { CouncilIndexRow } from "../lib/council-index";
  import { pageTypeLabel } from "../lib/page-type";
  type Hit = {data: () => Promise<{url: string; meta: {title?: string; type?: string}; excerpt: string}>};
  type Index = {destroy: () => Promise<void>; search: (term: string) => Promise<{results: Hit[]}>};
  const trigger = document.querySelector<HTMLAnchorElement>('[data-search-open]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-site-search]')!;
  const input = dialog.querySelector<HTMLInputElement>('input')!;
  const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
  const results = dialog.querySelector<HTMLOListElement>('[data-search-results]')!;
  const retry = dialog.querySelector<HTMLButtonElement>('[data-search-retry]')!;
  const more = dialog.querySelector<HTMLButtonElement>('[data-search-more]')!;
  const councilsSection = dialog.querySelector<HTMLElement>('[data-search-councils]')!;
  const councilResults = dialog.querySelector<HTMLUListElement>('[data-search-council-results]')!;
  let councils: Promise<CouncilIndexRow[]> | undefined;
  let index: Index | undefined;
  const councilsMore = dialog.querySelector<HTMLButtonElement>('[data-search-councils-more]')!;
  let councilMatches: CouncilIndexRow[] = [];
  let councilsListed = 0;
  let searching = false;
  let counts: { councils: number | null; pages: number | null } = { councils: 0, pages: 0 };
  function councilPage() {
    for (const row of councilMatches.slice(councilsListed, councilsListed + COUNCILS_SHOWN)) {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = row.url; link.textContent = row.name; link.dataset.councilProfile = '';
      const detail = document.createElement('span');
      detail.className = 'council-detail';
      detail.textContent = row.nation === 'England' ? `${row.type} · ${row.region}` : `${row.type} · ${row.nation}`;
      item.append(link, detail);
      if (row.budgetUrl || row.parishUrl) {
        const destinations = document.createElement('div'); destinations.className = 'council-destinations';
        for (const [url, label] of [[row.budgetUrl, 'Budget game'], [row.parishUrl, 'Parish precepts']]) {
          if (!url) continue;
          const action = document.createElement('a'); action.href = url; action.textContent = label!;
          action.setAttribute('aria-label', `${label} for ${row.name}`); destinations.append(action);
        }
        item.append(destinations);
      }
      councilResults.append(item);
    }
    councilsListed = councilResults.childElementCount;
    councilsMore.hidden = councilsListed >= councilMatches.length;
    councilsSection.hidden = councilsListed === 0;
  }
  /** Both searches can finish independently; stale responses never paint. */
  async function councilSearch(term: string, token: number): Promise<number | null> {
    const query = normalise(term);
    if (query.length < 2) return 0;
    try {
      councils ??= fetch('/council-index.json').then(response => {
        if (!response.ok) throw new Error('Council index unavailable');
        return response.json() as Promise<CouncilIndexRow[]>;
      }).catch(error => { councils = undefined; throw error; });
      const rows = await councils;
      if (token !== sequence || !dialog.open) return null;
      const region = matchingRegion(query, rows.map(row => row.region));
      councilMatches = rankCouncils(query, rows.filter(row => matchesCouncil(query, row.search)
        && (!region || normalise(row.region) === region)));
      councilPage();
      return councilMatches.length;
    } catch {
      return null;
    }
  }
  let hits: Hit[] = []; let offset = 0; let sequence = 0; let timer: ReturnType<typeof setTimeout>;
  let focusBefore: HTMLElement | null = null;
  async function page(token: number) {
    const slice = await Promise.all(hits.slice(offset, offset + 8).map(hit => hit.data()));
    if (token !== sequence || !dialog.open) return;
    for (const hit of slice) {
      const item = document.createElement('li'); const link = document.createElement('a');
      link.href = hit.url; link.textContent = hit.meta.title ?? hit.url;
      const excerpt = document.createElement('p');
      excerpt.textContent = new DOMParser().parseFromString(hit.excerpt, 'text/html').body.textContent;
      item.append(link);
      const type = pageTypeLabel(hit.meta.type);
      if (type) {
        const label = document.createElement('p');
        label.dataset.searchType = hit.meta.type;
        label.textContent = type;
        item.append(label);
      }
      item.append(excerpt); results.append(item);
    }
    offset += slice.length; more.hidden = offset >= hits.length;
  }
  async function search() {
    const token = ++sequence; const term = input.value.trim();
    searching = false;
    councilResults.replaceChildren(); councilsSection.hidden = true; councilsMore.hidden = true; councilMatches = []; councilsListed = 0;
    results.replaceChildren(); more.hidden = true; retry.hidden = true; hits = []; offset = 0;
    if (!term) {status.textContent = 'Type to search council pages and guides.'; return;}
    if (normalise(term).length < 2) {status.textContent = 'Enter at least two letters to search.'; return;}
    const councilCount = councilSearch(term, token);
    searching = true;
    status.textContent = 'Searching…';
    try {
      const modulePath = '/pagefind/pagefind.js';
      index ??= await import(/* @vite-ignore */ modulePath) as Index;
      const found = await index.search(term);
      if (token !== sequence || !dialog.open) return;
      hits = found.results;
      await page(token);
      if (token !== sequence || !dialog.open) return;
      const count = await councilCount;
      if (token !== sequence || !dialog.open) return;
      counts = { councils: count, pages: hits.length };
      searching = false;
      status.textContent = searchStatus(count, hits.length, councilsListed);
      retry.hidden = count !== null;
    } catch {
      if (token !== sequence || !dialog.open) return;
      results.replaceChildren(); more.hidden = true;
      const count = await councilCount;
      if (token !== sequence || !dialog.open) return;
      counts = { councils: count, pages: null };
      searching = false;
      status.textContent = searchStatus(count, null, councilsListed); retry.hidden = false;
    }
  }
  function open() {focusBefore = document.activeElement as HTMLElement; dialog.showModal(); input.focus(); if (input.value) void search();}
  trigger.addEventListener('click', event => {event.preventDefault(); open();});
  dialog.addEventListener('keydown', event => {if (event.key === 'Escape') {event.preventDefault(); event.stopPropagation(); dialog.close();}});
  dialog.addEventListener('close', () => {sequence++; clearTimeout(timer); focusBefore?.focus();});
  input.addEventListener('input', () => {
    sequence++; councilResults.replaceChildren(); councilsSection.hidden = true; councilsMore.hidden = true;
    results.replaceChildren(); more.hidden = true; retry.hidden = true;
    clearTimeout(timer); timer = setTimeout(() => void search(), 180);
  });
  councilsMore.addEventListener('click', () => {
    councilPage();
    if (!searching) status.textContent = searchStatus(counts.councils, counts.pages, councilsListed);
  });
  retry.addEventListener('click', async () => {retry.disabled = true; try {await index?.destroy(); index = undefined; await search();} finally {retry.disabled = false;}});
  more.addEventListener('click', async () => {
    more.disabled = true; const token = sequence;
    try {await page(token);} catch {if (token === sequence && dialog.open) status.textContent = 'More results could not load. Try again.';} finally {more.disabled = false;}
  });
  document.addEventListener('keydown', event => {
    const target = event.target as HTMLElement;
    if (event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey && !dialog.open && !target.closest('input, textarea, select, [contenteditable]')) {event.preventDefault(); open();}
  });
</script>
<style>
  .search-trigger { min-height: 2.5rem; padding: 0.45rem 0.65rem; }
  .site-search { width: 92vw; max-width: 42rem; max-height: 85dvh; padding: clamp(1rem, 4vw, 2rem); border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--bg); color: var(--text); box-shadow: var(--shadow); }
  .site-search::backdrop { background: color-mix(in srgb, var(--ground) 75%, transparent); }
  .search-councils { list-style: none; padding: 0; margin: 0 0 1rem; }
  .search-councils :global(li) { padding: 0.65rem 0; border-top: 1px solid var(--border); overflow-wrap: anywhere; }
  .search-councils :global(a[data-council-profile]) { display: block; font-weight: 600; padding: 0.2rem 0; }
  .search-councils :global(.council-detail) { display: block; color: var(--text-muted); font-size: 0.85rem; }
  .search-councils :global(.council-destinations) { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-top: 0.25rem; }
  .search-councils :global(.council-destinations a) { font-size: 0.9rem; padding: 0.35rem 0; }
  ol :global(a) { overflow-wrap: anywhere; }
  form { display: flex; justify-content: end; }
  h2 { margin-top: 0.5rem; }
  ol { list-style: none; padding: 0; }
  ol :global(li) { padding: 1rem 0; border-top: 1px solid var(--border); }
  ol :global(a) { font-weight: 600; }
  ol :global(p) { font-size: 0.9rem; color: var(--text-muted); margin: 0.3rem 0 0; }
  ol :global(p[data-search-type]) { font-size: 0.8rem; line-height: 1.3; margin: 0.15rem 0 0; }
</style>
