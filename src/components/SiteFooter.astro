---
/**
 * The footer at D8 option B (decided 19 November 2026): four columns, then the
 * sister sites from the one link table in src/lib/sister-sites.ts with UK
 * Councils first as a card, then the imprint and the theme choice. It names no
 * person and takes no position: the imprint is the site's own name and what it does.
 */
import { FOOTER_COLUMNS, SITE_NAME } from "../lib/site";
import { SISTER_SITE_LINKS } from "../lib/sister-sites";
import ThemeSelect from "./ThemeSelect.astro";

interface Props { ephemeral?: boolean }
const {ephemeral = false} = Astro.props;

const [lead, ...rest] = SISTER_SITE_LINKS;
const year = new Date().getUTCFullYear();
---
<footer class="site-footer" data-pagefind-ignore>
  <div class="shell">
    <nav class="footer-cols" aria-label="Footer">
      {FOOTER_COLUMNS.map((column, i) => (
        <div>
          <p id={`footer-col-${i + 1}`} class="footer-eyebrow">{column.label}</p>
          <ul aria-labelledby={`footer-col-${i + 1}`}>
            {column.items.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
    <section aria-labelledby="footer-sisters" data-sister-sites>
      <h2 id="footer-sisters" class="footer-eyebrow">Sister sites</h2>
      <ul class="footer-sisters">
        <li class="footer-sister footer-sister-lead">
          <span class="footer-sister-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="32" height="32"><rect width="64" height="64" rx="12" fill="var(--ground-ink)"></rect><path d="M14 50V28L32 16l18 12v22H38V36H26v14z" fill="var(--ground)"></path></svg>
          </span>
          <div><a href={lead.url}>{lead.name}</a><span>{lead.blurb}</span></div>
        </li>
        {rest.map((s) => (
          <li class="footer-sister"><div><a href={s.url}>{s.name}</a><span>{s.blurb}</span></div></li>
        ))}
      </ul>
    </section>
    <div class="footer-base">
      <p class="footer-imprint">
        An independent reference site, not a council or government service.{' '}
        {SITE_NAME} republishes official figures about local authorities in the UK. Every figure carries its
        source and date. Council tax figures are from MHCLG, the Scottish Government and the Welsh Government under the Open Government Licence v3.0. &copy; {year} {SITE_NAME}.
      </p>
      {!ephemeral && <div class="footer-theme"><ThemeSelect label="Theme" /></div>}
    </div>
  </div>
</footer>

<style>
  /* The footer sits on the band green in both themes, so its focus ring takes the highlight: the link colour is 1.47 to 1 there in light. */
  .site-footer :global(:focus-visible) { outline-color: var(--accent-bright); }
  .site-footer {
    margin-top: 3rem;
    background: var(--ground);
    color: var(--ground-muted);
    padding: 2rem 0;
    font-size: 0.92rem;
  }
  .site-footer a { color: var(--ground-ink); text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }
  /* Column labels are not headings: a page's own "Your bill" heading stays the only one by that name. */
  .footer-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ground-muted);
    margin: 0 0 0.6rem;
  }
  .footer-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 1.5rem; }
  .footer-cols ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.05rem; }
  .footer-cols a { display: inline-block; padding: 0.15rem 0; }
  /* Desktop: UK Councils spans two rows at the start, the other six sit beside it in two rows of three. */
  .footer-sisters { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin: 0 0 1.25rem; padding: 0; list-style: none; }
  .footer-sister { display: flex; gap: 0.7rem; align-items: center; padding: 0.6rem 0.75rem; border: 1px solid var(--ground-rule); border-radius: var(--radius); min-width: 0; }
  .footer-sister-lead { grid-row: span 2; border-top: 3px solid var(--accent-bright); }
  .footer-sister-mark { flex: none; display: inline-flex; }
  .footer-sister-mark svg { width: 32px; height: 32px; display: block; }
  .footer-sister a { display: block; font-weight: 600; overflow-wrap: anywhere; }
  .footer-sister span { display: block; font-size: 0.85rem; }
  .footer-imprint { max-width: 48rem; margin: 0; line-height: 1.5; }
  .footer-base { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.75rem 2rem; padding-top: 1rem; border-top: 1px solid var(--ground-rule); }
  .footer-theme { color: var(--ground-ink); }
  @media (max-width: 760px) {
    .footer-cols { grid-template-columns: 1fr 1fr; }
    .footer-sisters { grid-template-columns: 1fr; }
    .footer-sister-lead { grid-row: auto; }
  }
</style>
