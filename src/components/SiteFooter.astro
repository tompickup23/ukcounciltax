---
/**
 * The footer. It names no person and takes no position: the imprint is the
 * site's own name and what it does.
 */
import { FOOTER_LINKS, SITE_NAME } from "../lib/site";
import ThemeSelect from "./ThemeSelect.astro";

const SISTERS = [
  {name: "UK Councils", url: "https://ukcouncils.co.uk/", blurb: "The wider picture of your local council"},
  {name: "UK Places", url: "https://ukplaces.co.uk/", blurb: "Explore places and their local context"},
  { name: "UK Elections", url: "https://ukelections.co.uk/", blurb: "Results and seats for every council" },
  { name: "UK Demographics", url: "https://ukdemographics.co.uk/", blurb: "Population and census for every place" },
  { name: "UK School Holiday Dates", url: "https://ukschoolholidaydates.co.uk/", blurb: "Term dates for every education authority" },
  { name: "AI DOGE", url: "https://aidoge.co.uk/", blurb: "What public bodies publish about their spending" },
];
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="shell">
    <section aria-labelledby="footer-sisters">
      <h2 id="footer-sisters" class="footer-eyebrow">Sister sites</h2>
      <ul class="footer-sisters">
        {SISTERS.map((s) => (
          <li><a href={s.url}>{s.name}</a><span>{s.blurb}</span></li>
        ))}
      </ul>
    </section>
    <p class="footer-imprint">
      An independent reference site, not a council or government service.{' '}
      {SITE_NAME} republishes official figures about local authorities in the UK. Every figure carries its
      source and date. Council tax figures are from MHCLG, the Scottish Government and the Welsh Government under the Open Government Licence v3.0. &copy; {year} {SITE_NAME}.
    </p>
    <nav class="footer-links" aria-label="About this site">
      <ul>{FOOTER_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </nav>
    <div class="footer-theme"><ThemeSelect label="Theme" /></div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    background: var(--ground);
    color: var(--ground-muted);
    padding: 2rem 0 2.5rem;
    font-size: 0.92rem;
  }
  .footer-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ground-muted);
    margin: 0 0 0.75rem;
  }
  .footer-sisters {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem 1.25rem;
  }
  .footer-sisters li { display: flex; flex-direction: column; }
  .footer-sisters a { color: var(--ground-ink); font-weight: 600; }
  .footer-sisters span { font-size: 0.85rem; }
  .footer-imprint { max-width: 48rem; margin: 0; line-height: 1.5; }
  .footer-links ul { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; }
  .footer-links a { color: var(--ground-ink); }
  .footer-theme { margin-top: 1rem; color: var(--ground-ink); }
</style>
