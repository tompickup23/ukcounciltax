---
/**
 * The line under a figure that says where it came from. Every figure on the
 * site has one, directly under it, never only on a methodology page.
 */
import { longDate, type SourceRef } from "../lib/sources";

interface Props {
  source: SourceRef;
}

const { source } = Astro.props;
const date = longDate(source.date);
const retrieved = longDate(source.retrieved);
---
<p class="source-line">
  {source.method ? `${source.method}. ` : ""}Source: <a href={source.url}>{source.publisher}, {source.title}</a>{source.table ? `, ${source.table}` : ""}{date ? `, published ${date}` : ""}{retrieved ? `, retrieved ${retrieved}` : ""}.
</p>
