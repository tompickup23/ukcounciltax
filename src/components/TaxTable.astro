---
import SourceLine from './SourceLine.astro';
import TaxTableControls from './TaxTableControls.astro';
import {CURRENT_YEAR, PREVIOUS_YEAR, BANDS, yearLabel} from '../lib/council-tax';
import {taxRows, taxSources} from '../lib/tax-view-data';
import {completeClass, moneyPence, monthlyPence, type TaxBand} from '../lib/tax-view';
import {changeSource} from '../lib/sources';
import {jsonLd} from '../lib/site';
interface Props { id: string; region?: string; band?: TaxBand; caption: string; controlsId?: string }
const {id, region, band = 'D', caption, controlsId} = Astro.props;
const all = taxRows();
const rows = all.filter(row => !region || row.region === region);
const classes = [...new Map(rows.map(row => [row.classCode, row.classLabel])).entries()];
const complete = Object.fromEntries([...new Set(all.map(row => row.classCode))].map(code => [code, Object.fromEntries(BANDS.map(b => [b, completeClass(all, code, CURRENT_YEAR, b)]))]));
const source = taxSources()[CURRENT_YEAR];
function change(current: number | undefined, previous: number | undefined) {
  if (!current || !previous) return null;
  const difference = current - previous;
  return difference === 0 ? 'Unchanged' : `${difference > 0 ? 'Up' : 'Down'} ${moneyPence(Math.abs(difference))} (${(Math.abs(difference) / previous * 100).toFixed(1)}%)`;
}
---
<section data-tax-table data-year={CURRENT_YEAR} data-previous={PREVIOUS_YEAR} data-initial-band={band} data-region={region} data-controls-id={controlsId}>
  {!controlsId && <TaxTableControls id={`${id}-controls`} caption={caption} classes={classes} band={band} />}
  <p class="small" data-table-status role={controlsId ? undefined : 'status'}>{rows.length} councils, Band {band}, {yearLabel(CURRENT_YEAR)}.</p>
  <div class="fact" data-fact>
    <div class="table-wrap" tabindex="0" role="region" aria-label={caption}>
      <table class="data compact-tax" data-pagefind-ignore>
        <caption data-table-caption>{caption}: Band {band}, {yearLabel(CURRENT_YEAR)}</caption>
        <thead><tr><th scope="col">Council</th><th scope="col" class="num">Annual area charge</th></tr></thead>
        <tbody>{rows.map(row => {
          const amount = row.years[CURRENT_YEAR]?.[band];
          const annualChange = change(amount, row.years[PREVIOUS_YEAR]?.[band]);
          return <tr data-ons={row.gss} data-slug={row.slug}>
            <th scope="row"><a href={`/councils/${row.slug}/#band-${band}`}>{row.name}</a><span class="row-detail">{row.classLabel}</span>
              <span class="row-detail" data-row-change hidden={!annualChange}>{annualChange ? `${annualChange} on ${yearLabel(PREVIOUS_YEAR)}` : ''}</span>
            </th>
            <td class="num"><strong data-row-annual data-figure>{amount ? moneyPence(amount) : 'n/a'}</strong><span class="row-detail" data-row-monthly hidden={!amount}>{amount ? `${moneyPence(monthlyPence(amount))} a month` : ''}</span></td>
          </tr>;
        })}</tbody>
      </table>
    </div>
    <SourceLine source={source} />
    <SourceLine source={changeSource(PREVIOUS_YEAR, CURRENT_YEAR)} />
    <p class="caveat">Whole-area charges include average parish precepts. Your bill and discounts can differ. Monthly equivalents divide the annual charge by ten and round to pennies.</p>
  </div>
  <script type="application/json" data-table-data set:html={jsonLd({rows, complete, caption})} />
</section>
<script>
  import {moneyPence, monthlyPence, type TaxRow, type TaxBand} from '../lib/tax-view';
  import {matchesCouncil} from '../lib/council-search';
  for (const root of document.querySelectorAll<HTMLElement>('[data-tax-table]')) {
    const {rows, complete, caption} = JSON.parse(root.querySelector('[data-table-data]')!.textContent!) as {rows: TaxRow[]; complete: Record<string, Record<TaxBand, boolean>>; caption: string};
    const year = root.dataset.year!; const previous = root.dataset.previous!;
    const body = root.querySelector('tbody')!;
    const elements = new Map([...body.querySelectorAll<HTMLTableRowElement>('tr')].map(row => [row.dataset.slug!, row]));
    const controls = root.dataset.controlsId ? document.getElementById(root.dataset.controlsId)! : root.querySelector<HTMLElement>('[data-table-controls]')!;
    const band = controls.querySelector<HTMLSelectElement>('[data-table-band]');
    const type = controls.querySelector<HTMLSelectElement>('[data-table-class]')!;
    const sort = controls.querySelector<HTMLSelectElement>('[data-table-sort]')!;
    const filter = controls.querySelector<HTMLInputElement>('[data-table-filter]')!;
    // With shared controls, the heading and table of a region with no match leave the page.
    const group = root.dataset.controlsId ? root.parentElement!.closest<HTMLElement>('section') : null;
    function update() {
      const b = (band?.value ?? root.dataset.initialBand) as TaxBand;
      const sortable = Boolean(type.value && complete[type.value]?.[b]);
      for (const option of [...sort.options]) if (option.value !== 'name') option.disabled = !sortable;
      if (!sortable) sort.value = 'name';
      controls.querySelector('[data-sort-note]')!.textContent = sortable ? 'Numeric sorting compares one council type in the same complete published year.' : 'Choose one council type to sort by annual charge.';
      const visible = rows.filter(row => (!type.value || row.classCode === type.value) && matchesCouncil(filter.value, row.name));
      visible.sort((a,c) => sort.value === 'name' ? a.name.localeCompare(c.name) : (sort.value === 'high' ? -1 : 1) * ((a.years[year][b] as number) - (c.years[year][b] as number)) || a.name.localeCompare(c.name));
      for (const element of elements.values()) element.hidden = true;
      for (const row of visible) {
        const element = elements.get(row.slug)!; element.hidden = false;
        const amount = row.years[year]?.[b]; const before = row.years[previous]?.[b];
        element.querySelector('[data-row-annual]')!.textContent = amount ? moneyPence(amount) : 'n/a';
        const monthly = element.querySelector<HTMLElement>('[data-row-monthly]')!;
        monthly.hidden = !amount; monthly.textContent = amount ? `${moneyPence(monthlyPence(amount))} a month` : '';
        const change = element.querySelector<HTMLElement>('[data-row-change]')!;
        change.hidden = !amount || !before;
        if (amount && before) {
          const delta = amount - before;
          change.textContent = `${delta === 0 ? 'Unchanged' : `${delta > 0 ? 'Up' : 'Down'} ${moneyPence(Math.abs(delta))} (${(Math.abs(delta) / before * 100).toFixed(1)}%)`} on ${previous.replace('-', '/')}`;
        }
        element.querySelector<HTMLAnchorElement>('a')!.href = `/councils/${row.slug}/#band-${b}`;
        body.append(element);
      }
      root.querySelector('[data-table-status]')!.textContent = visible.length ? `${visible.length} ${visible.length === 1 ? 'council' : 'councils'}, Band ${b}, ${year.replace('-', '/')}.` : 'No matching councils. Clear the name filter or choose another council type.';
      root.querySelector('[data-table-caption]')!.textContent = `${caption}: Band ${b}, ${year.replace('-', '/')}`;
      root.dataset.shown = String(visible.length);
      if (group) group.hidden = visible.length === 0;
    }
    if (controls.hidden) {
      controls.hidden = false;
      controls.querySelector<HTMLFieldSetElement>('fieldset')!.disabled = false;
      const print = controls.querySelector<HTMLButtonElement>('[data-table-print]')!;
      print.disabled = false; print.addEventListener('click', () => window.print());
      const requestedType = new URLSearchParams(location.search).get('type');
      if (requestedType && [...type.options].some(option => option.value === requestedType)) type.value = requestedType;
    }
    if (type.value) update();
    filter.addEventListener('input', update);
    for (const control of [band,type,sort]) control?.addEventListener('change', update);
  }
  // One status line for tables that share controls. Its listeners are added after every
  // table's own, so each table has already updated when the line is written.
  for (const status of document.querySelectorAll<HTMLElement>('[data-controls-status]')) {
    const controls = status.closest<HTMLElement>('[data-table-controls]')!;
    const tables = [...document.querySelectorAll<HTMLElement>(`[data-tax-table][data-controls-id="${controls.id}"]`)];
    const summarise = () => {
      const counts = tables.map(table => table.dataset.shown === undefined ? table.querySelectorAll('tbody tr').length : Number(table.dataset.shown));
      const total = counts.reduce((sum, count) => sum + count, 0);
      const regions = tables.filter((_, index) => counts[index] > 0).map(table => table.dataset.region!);
      status.textContent = total === 0 ? 'No matching councils. Clear the name filter or choose another council type.'
        : `${total} ${total === 1 ? 'council' : 'councils'} shown, in ${regions.length <= 3 ? regions.join(regions.length === 2 ? ' and ' : ', ').replace(/, ([^,]+)$/, ' and $1') : regions.length === tables.length ? `all ${tables.length} regions` : `${regions.length} of ${tables.length} regions`}.`;
      tables.forEach((table, index) => {
        const section = table.parentElement!.closest<HTMLElement>('section');
        const jump = section?.id ? document.querySelector<HTMLElement>(`[data-region-jump] a[href="#${section.id}"]`)?.closest('li') : null;
        if (jump) jump.hidden = counts[index] === 0;
      });
    };
    summarise();
    controls.querySelector('[data-table-filter]')!.addEventListener('input', summarise);
    for (const select of controls.querySelectorAll('select')) select.addEventListener('change', summarise);
  }
</script>
<style>
  .row-detail { display: block; font-size: 0.8rem; color: var(--text-muted); font-weight: 400; white-space: normal; }
  .compact-tax th:first-child { width: 58%; }
  @media(max-width: 640px) { .compact-tax th:first-child { min-width: 0; } }
</style>
