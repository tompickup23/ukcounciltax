---
/**
 * System, light or dark. The choice is stored under ukcounciltax-theme and
 * public/theme-init.js applies it before first paint on the next load. Without
 * JavaScript the select would do nothing, so it stays hidden until
 * public/theme-init.js has put the js class on the html element, and the
 * system preference stands, which is a correct page.
 */
interface Props {
  /** The visible label. */
  label?: string;
}
const { label = "Theme" } = Astro.props;
---
<label class="theme-select">
  <span class="theme-select-label">{label}</span>
  <select data-theme-select>
    <option value="system">System theme</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
</label>

<script>
  const KEY = "ukcounciltax-theme";
  for (const select of document.querySelectorAll<HTMLSelectElement>("[data-theme-select]")) {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {
      saved = null;
    }
    select.value = saved === "light" || saved === "dark" ? saved : "system";
    select.addEventListener("change", () => {
      const value = select.value;
      try {
        if (value === "system") localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, value);
      } catch {
        // Storage refused: the choice still applies to this page.
      }
      if (value === "system") document.documentElement.removeAttribute("data-theme");
      else document.documentElement.setAttribute("data-theme", value);
    });
  }
</script>

<style>
  .theme-select { display: none; align-items: center; gap: 0.5rem; }
  :global(html.js) .theme-select { display: inline-flex; }
  .theme-select select {
    font: inherit;
    font-size: 0.9rem;
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.5rem;
  }
</style>
