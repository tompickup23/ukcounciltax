---
interface Props { id: string }
const {id} = Astro.props;
---
<div class="view-actions" data-view-actions data-pagefind-ignore>
  <div class="action-links">
    <button class="button secondary" type="button" data-share-view disabled>Share this view</button>
    <button class="button secondary" type="button" data-print-view disabled>Print</button>
  </div>
  <p class="small" role="status" data-share-status></p>
  <input id={`${id}-share-link`} type="text" readonly hidden aria-label="Link to this view" data-share-fallback />
</div>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print-view]')) {
    button.disabled = false; button.addEventListener('click', () => window.print());
  }
</script>
