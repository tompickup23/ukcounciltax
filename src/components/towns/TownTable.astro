---
/**
 * Every parish and unparished area in a scope, as one static table that reads in
 * full without JavaScript: rows with a figure in position order, then rows without
 * one with their status, never as zero and never in the order. A league table
 * (src/styles/league.css): position, place, where it is, a mark for where its
 * full Band D sits between the scope's lowest and highest, then the figures. A
 * long region table is split into parts (src/lib/towns-parts.ts), each a page,
 * with the part links as plain anchors. One bundled script (hashed by
 * inject_csp_hashes.mjs, no inline permission) adds the council and constituency
 * selects, a place search, the larger places toggle, sortable columns and a live
 * count. Below 600px each row becomes a card.
 */
import TownsSources from './TownsSources.astro';
import '../../styles/league.css';
import {national} from '../../lib/national-data';
import {noteText, townByCode, townsData, type Town, type TownStatus} from '../../lib/towns';
import {councilHref, money, noFigure, parishChange, parishPart, placeName, printedName, scopeIn, signedMoney, STATUS_CHIPS, townConstituencyPath, POSITION_METHOD, type TownScope} from '../../lib/towns-pages';
import {tidy} from '../../lib/towns-pages';
import type {TableRow, TownPart} from '../../lib/towns-parts';

interface Props {
  scope: TownScope;
  rows: TableRow[];
  /** Counts for the whole scope, which the opening paragraph states. */
  rankedCount: number; unplacedCount: number;
  /** The scope's lowest and highest full Band D, in pence: the ends of every range mark. */
  min: number | null; max: number | null;
  part: TownPart; parts: TownPart[];
  /** Every row in the scope, for the counts that describe the whole table (status legend, larger places). */
  scopeRows: readonly Town[];
}
const {scope, rows, rankedCount, unplacedCount, min, max, part, parts, scopeRows} = Astro.props;
const showCounty = scope.kind !== 'county';
const all = rows.map(r => r.town);
const councils = [...new Map(all.map(t => [t.councilGss, tidy(t.councilName)])).entries()].sort((a, b) => a[1].localeCompare(b[1], 'en-GB'));
const pcons = [...new Map(all.flatMap(t => t.constituencies.map(c => [c.code, c.name] as const))).entries()].sort((a, b) => a[1].localeCompare(b[1], 'en-GB'));
const larger = scopeRows.filter(t => t.largerPlace).length;
const statuses = (Object.keys(STATUS_CHIPS) as TownStatus[]).map(status => ({status, count: scopeRows.filter(t => t.status === status).length, here: all.some(t => t.status === status)})).filter(s => s.count > 0 && s.here);
const noteIds = [...new Set(all.flatMap(t => t.noteIds))].filter(id => id !== 'calculated' && id !== 'rounding');
const mhclgNotes = [...new Set(all.flatMap(t => t.mhclgNotes))].sort();
const mhclgText = (id: string) => (national.parishNotes as Record<string, string>)[id] ?? null;
const letter = (id: string) => id.replace(/^\[(?:note )?|\]$/g, '');
const lookups = all.some(t => t.constituencies.length > 0);
const paged = parts.length > 1;
const caption = `Full Band D by parish and unparished area ${scope.kind === 'england' ? 'in England' : `in ${scope.kind === 'constituency' ? `the ${scope.name} constituency` : scope.name}`}, ${townsData.year.replace('-', '/')}, lowest first`;
const carrierName = (code: string) => { const t = townByCode.get(code); return t ? placeName(t) : code; };
// Where the row's figure sits between the scope's lowest and highest, for the mark only.
const at = (pence: number | null) => pence === null || min === null || max === null ? null : max === min ? 0 : Math.round(((pence - min) / (max - min)) * 1000) / 10;
const partLabel = (p: TownPart) => p.ranked === 0 ? 'Not placed' : p.ranked === p.rows.length ? `${p.first} to ${p.last}` : `${p.first} to ${p.last}, then not placed`;
const firstUnplaced = rows.find(r => r.position === null)?.town.code;
const lastPlaced = rows.filter(r => r.position !== null).at(-1)?.town.code;
---
<section class="section towns-table-section" aria-labelledby="towns-table-heading" data-towns-table>
  <h2 id="towns-table-heading">Every parish and unparished area, lowest to highest</h2>
  <p>{rankedCount.toLocaleString('en-GB')} areas{paged ? ` ${scopeIn(scope)}, across every part of this table,` : ''} have a full Band D and are in position order. {unplacedCount > 0 ? `${unplacedCount.toLocaleString('en-GB')} more are listed after them with their status: their full Band D is not published in the national tables, so they are not in the order.` : 'Every area here has a full Band D.'} Full Band D is the whole Band D bill in that area: the billing council, the county or GLA, police, fire and combined authority, and the parish. It is before discounts, reductions and premiums.</p>
  {paged && (
    <nav class="league-jump towns-parts" aria-label="Parts of this table">
      <span>Positions</span>
      {parts.map(p => <>{' '}{p.index === part.index ? <span aria-current="page">{partLabel(p)}</span> : <a href={`${p.path}#towns-table`}>{partLabel(p)}</a>}</>)}
    </nav>
  )}
  {!paged && rows.length > 30 && (
    <nav class="league-jump" aria-label="Jump within this table">
      <span>Jump to</span>
      <a href="#towns-table">Lowest</a>
      {lastPlaced && <a href={`#${lastPlaced}`}>Highest</a>}
      {firstUnplaced && <a href={`#${firstUnplaced}`}>Not placed</a>}
    </nav>
  )}
  <div class="town-filters" data-town-filters hidden>
    <label class="field town-search">Find a place{paged ? ' in this part' : ''}<input type="search" autocomplete="off" placeholder="Type part of a name" data-f-q /></label>
    <details class="town-more" data-f-more open>
      <summary>Council, constituency, sort and larger places</summary>
      <div class="town-more-grid">
        {councils.length > 1 && <label class="field">Council<select data-f-council><option value="">All councils ({councils.length})</option>{councils.map(([gss, name]) => <option value={gss}>{name}</option>)}</select></label>}
        {scope.kind !== 'constituency' && pcons.length > 1 && <label class="field">Constituency<select data-f-pcon><option value="">All constituencies ({pcons.length})</option>{pcons.map(([code, name]) => <option value={code}>{name}</option>)}</select></label>}
        <label class="field">Sort by<select data-f-sort>
          <option value="pos:1">Position, lowest first</option>
          <option value="v:-1">Full Band D, highest first</option>
          <option value="place:1">Place, A to Z</option>
          <option value="place:-1">Place, Z to A</option>
          <option value="pp:-1">Parish part, highest first</option>
          <option value="pp:1">Parish part, lowest first</option>
          <option value="ch:-1">Parish change, highest first</option>
          <option value="ch:1">Parish change, lowest first</option>
        </select></label>
        {larger > 0 && <label class="town-check"><input type="checkbox" data-f-larger /> <span>Larger places only: a tax base of 2,000 Band D equivalents or more ({larger.toLocaleString('en-GB')} {paged ? scopeIn(scope) : 'here'}; a tax base, not a population)</span></label>}
      </div>
    </details>
  </div>
  <p class="league-count town-count" data-f-count role="status">All {all.length.toLocaleString('en-GB')} areas{paged ? ' in this part' : ''} shown.</p>
  <div class="fact" data-fact id="towns-table">
    <div class="league-wrap town-wrap" tabindex="0" role="region" aria-label={caption}>
      <table class:list={["league town-table", {"town-county": showCounty}]} data-town-table>
        <caption>{caption}{paged && `: part ${part.index} of ${parts.length}`}</caption>
        <thead><tr>
          <th scope="col" class="num" data-sort="pos">Position</th>
          <th scope="col" data-sort="place">Place</th>
          <th scope="col">{showCounty ? 'Council, county and constituency' : 'Council and constituency'}</th>
          <th scope="col" class="lg-range"><span class="lg-scale"><span>Lowest</span><span>Highest</span></span><span class="visually-hidden">Where the full Band D sits between the lowest and highest {scope.kind === 'england' ? 'in England' : `in ${scope.kind === 'constituency' ? `the ${scope.name} constituency` : scope.name}`}</span></th>
          <th scope="col" class="num" data-sort="v">Full Band D</th>
          <th scope="col" class="num" data-sort="pp">Parish part</th>
          <th scope="col" class="num" data-sort="ch">Parish change</th>
          <th scope="col">Status</th>
        </tr></thead>
        <tbody>
          {rows.map(({town: t, position}) => { const pp = parishPart(t); const ch = parishChange(t); const printed = printedName(t); const p = at(t.fullBandDPence); return (
            <tr id={t.code} data-v={t.fullBandDPence ?? undefined} data-pp={pp ?? undefined} data-ch={ch ?? undefined} data-c={t.councilGss} data-k={t.constituencies.map(c => c.code).join(' ') || undefined} data-l={t.largerPlace ? '1' : undefined} data-unresolved={t.status === 'group-member-unresolved' ? '' : undefined} class:list={[{'t-none': position === null}]}>
              <td data-figure>{position ?? 'Not placed'}</td>
              <th scope="row">{placeName(t)}<small>{t.kind === 'unparished' ? (t.taxBaseBasis === 'calculated' ? 'Unparished area' : 'Unparished area, tax base not published separately') : t.type}{t.groupCarrier && `, group carried by ${carrierName(t.groupCarrier)}`}{t.groupLabel && `, group: ${t.groupLabel}`}{printed && <>, printed as <q>{printed}</q></>}{t.mhclgNotes.map(n => <>, <a href={`#mhclg-${letter(n)}`}>MHCLG note {letter(n)}</a></>)}</small></th>
              <td><a href={councilHref(t.councilGss)}>{tidy(t.councilName)}</a>{showCounty && <span>{tidy(t.county)}</span>}<span>{t.constituencies.length ? <>{t.constituencies.map((c, i) => <>{i > 0 && '; '}<a href={townConstituencyPath(c.slug)}>{c.name}</a></>)}{t.constituencySplit && <small> (split, not apportioned)</small>}</> : <span class="muted">Not matched</span>}</span></td>
              <td>{p !== null && <i style={`--p:${p}%`}></i>}</td>
              <td data-figure>{t.fullBandDPence === null ? noFigure(t) : money(t.fullBandDPence)}</td>
              <td data-figure>{pp === null ? (t.kind === 'unparished' ? 'No parish' : 'Not published') : money(pp)}</td>
              <td data-figure>{ch === null ? (t.status === 'group-member-unresolved' ? 'Not published' : 'Not comparable') : signedMoney(ch)}</td>
              <td class={t.status === 'calculated' ? 't-calc' : undefined}>{t.status === 'calculated' ? 'Calculated' : <span class="town-chip">{STATUS_CHIPS[t.status]}</span>}</td>
            </tr>
          ); })}
        </tbody>
      </table>
    </div>
    <TownsSources rows={all} lookups={lookups} method={POSITION_METHOD} />
  </div>
  {paged && (
    <nav class="league-jump towns-parts" aria-label="Parts of this table, again">
      <span>Positions</span>
      {parts.map(p => <>{' '}{p.index === part.index ? <span aria-current="page">{partLabel(p)}</span> : <a href={`${p.path}#towns-table`}>{partLabel(p)}</a>}</>)}
    </nav>
  )}
  <div class="town-legend">
    <h3>What each status means</h3>
    <dl>
      {statuses.map(s => <div><dt><span class="town-chip">{STATUS_CHIPS[s.status]}</span> <span class="muted">{s.count.toLocaleString('en-GB')} {s.count === 1 ? 'area' : 'areas'}{paged ? ` ${scopeIn(scope)}` : ''}</span></dt><dd>{townsData.statusLabels[s.status]}.</dd></div>)}
    </dl>
    {noteIds.length > 0 && <><h3>Notes on these rows</h3><ul class="small">{noteIds.map(id => noteText(id) && <li>{noteText(id)}</li>)}</ul></>}
    {mhclgNotes.length > 0 && <><h3>MHCLG notes</h3><ul class="small">{mhclgNotes.map(id => <li id={`mhclg-${letter(id)}`}>Note {letter(id)}: {mhclgText(id) ?? 'see the parish return Notes sheet'}</li>)}</ul></>}
    <p class="small muted">Parish change is the parish part's change on the previous year, from the same row of the parish return, our calculation. The full bill change is not comparable: {noteText(townsData.fullChangeNote) ?? 'the previous year\'s Table 10 parts are not held'}</p>
  </div>
</section>

<script>
  type Key = 'pos' | 'place' | 'v' | 'pp' | 'ch';
  for (const section of document.querySelectorAll<HTMLElement>('[data-towns-table]')) {
    const panel = section.querySelector<HTMLElement>('[data-town-filters]');
    const table = section.querySelector<HTMLTableElement>('[data-town-table]');
    const status = section.querySelector<HTMLElement>('[data-f-count]');
    if (!panel || !table || !status) continue;
    const body = table.tBodies[0];
    const rows = [...body.rows];
    const original = new Map(rows.map((row, i) => [row, i]));
    const q = panel.querySelector<HTMLInputElement>('[data-f-q]');
    const council = panel.querySelector<HTMLSelectElement>('[data-f-council]');
    const pcon = panel.querySelector<HTMLSelectElement>('[data-f-pcon]');
    const larger = panel.querySelector<HTMLInputElement>('[data-f-larger]');
    const names = new Map(rows.map(row => [row, (row.cells[1].firstChild?.textContent ?? '').toLowerCase()]));
    const params = new URLSearchParams(location.search);
    if (q && params.get('q')) q.value = params.get('q')!;
    // A value with no matching option leaves a select blank, so fall back to "All".
    for (const [select, key] of [[council, 'council'], [pcon, 'constituency']] as const) {
      if (!select || !params.get(key)) continue;
      select.value = params.get(key)!;
      if (select.selectedIndex < 0) select.value = '';
    }
    if (larger && params.get('larger') === '1') larger.checked = true;
    const more = panel.querySelector<HTMLDetailsElement>('[data-f-more]');
    const phone = matchMedia('(max-width: 599px)');
    if (more) more.open = !phone.matches || Boolean(council?.value || pcon?.value || larger?.checked);
    panel.hidden = false;
    const total = rows.length;
    const scope = section.querySelector('.towns-parts') ? ' in this part' : '';
    const format = (n: number) => n.toLocaleString('en-GB');
    function apply() {
      const query = (q?.value ?? '').trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const ok = (!query || names.get(row)!.includes(query))
          && (!council?.value || row.dataset.c === council.value)
          && (!pcon?.value || (row.dataset.k ?? '').split(' ').includes(pcon.value))
          && (!larger?.checked || row.dataset.l === '1');
        row.hidden = !ok;
        if (ok) shown++;
      }
      status!.textContent = shown === total ? `All ${format(total)} areas${scope} shown.` : `Showing ${format(shown)} of ${format(total)} areas${scope}.`;
      const next = new URLSearchParams(location.search);
      for (const key of ['q', 'council', 'constituency', 'larger']) next.delete(key);
      if (query) next.set('q', query);
      if (council?.value) next.set('council', council.value);
      if (pcon?.value) next.set('constituency', pcon.value);
      if (larger?.checked) next.set('larger', '1');
      const search = next.toString();
      history.replaceState(null, '', `${location.pathname}${search ? `?${search}` : ''}${location.hash}`);
    }
    for (const control of [q, council, pcon, larger]) control?.addEventListener(control === q ? 'input' : 'change', apply);
    // Sorting: rows without a figure always stay after the rows with one.
    let current: {key: Key; dir: 1 | -1} = {key: 'pos', dir: 1};
    const headers = [...table.tHead!.rows[0].cells].filter(th => th.dataset.sort);
    const sortSelect = panel.querySelector<HTMLSelectElement>('[data-f-sort]');
    function sortBy(key: Key, dir: 1 | -1) {
      current = {key, dir};
      const value = (row: HTMLTableRowElement) => row.dataset[key] === undefined ? null : Number(row.dataset[key]);
      const sorted = [...rows].sort((a, b) => {
        if (key === 'place') return names.get(a)!.localeCompare(names.get(b)!, 'en-GB') * dir;
        const na = a.dataset.v === undefined, nb = b.dataset.v === undefined;
        if (na !== nb) return na ? 1 : -1;
        if (na) return original.get(a)!-original.get(b)!;
        if (key === 'pos') return (original.get(a)!-original.get(b)!) * dir;
        const va = value(a), vb = value(b);
        if (va === null && vb === null) return original.get(a)!-original.get(b)!;
        if (va === null) return 1;
        if (vb === null) return -1;
        return ((va as number)-(vb as number)) * dir || original.get(a)!-original.get(b)!;
      });
      body.append(...sorted);
      for (const th of headers) th.setAttribute('aria-sort', th.dataset.sort === key ? (dir === 1 ? 'ascending' : 'descending') : 'none');
      // Position and full Band D are one order, so the select has one option for each direction.
      const option = key === 'pos' && dir === -1 ? 'v:-1' : key === 'v' && dir === 1 ? 'pos:1' : `${key}:${dir}`;
      if (sortSelect) sortSelect.value = option;
    }
    for (const th of headers) {
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'town-sort';
      button.textContent = th.textContent; th.textContent = ''; th.append(button);
      th.setAttribute('aria-sort', th.dataset.sort === 'pos' ? 'ascending' : 'none');
      button.addEventListener('click', () => {
        const key = th.dataset.sort as Key;
        sortBy(key, current.key === key ? (current.dir === 1 ? -1 : 1) : 1);
      });
    }
    // The header is hidden when rows become cards, so the same sorts are offered as a select.
    sortSelect?.addEventListener('change', () => {
      const [key, dir] = sortSelect.value.split(':');
      if (!sortSelect.querySelector(`option[value="${sortSelect.value}"]`)) return;
      sortBy(key as Key, Number(dir) as 1 | -1);
    });
    apply();
  }
</script>

<style is:global>
/* Global so the thousands of rows carry no scoped style attribute. The shared
   league rules are in src/styles/league.css; these are the town columns:
   position, place, where, range, full Band D, parish part, parish change, status. */
.town-filters{display:grid;gap:var(--space-sm) var(--space-md);margin:var(--space-md) 0 var(--space-xs);align-items:start}
@media(min-width:1024px){.town-filters{grid-template-columns:minmax(14rem,20rem) minmax(0,1fr)}}
.town-filters .field input,.town-filters .field select{min-height:44px}
.town-more > summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:600;color:var(--accent)}
@media(min-width:600px){.town-more > summary{display:none}}
.town-more-grid{display:grid;gap:var(--space-sm) var(--space-md);align-items:end}
@media(min-width:600px){.town-more-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
.town-check{display:flex;gap:var(--space-xs);align-items:flex-start;grid-column:1/-1;min-height:44px;font-weight:600}
.town-check input{width:1.25rem;height:1.25rem;margin-top:.15rem;flex:none;accent-color:var(--accent)}
.town-check span{font-weight:400;font-size:var(--text-sm)}
/* Cells by position, so a row of a long table carries no class: position, place,
   where, range, full Band D, parish part, parish change, status. */
.town-table tbody tr > :nth-child(1){width:3.6rem;text-align:right;font-family:var(--font-display);font-weight:600;color:var(--text-faint);font-variant-numeric:tabular-nums lining-nums;white-space:nowrap}
.town-table th[scope="row"]{min-width:9rem;overflow-wrap:anywhere}
.town-table tbody tr > :nth-child(3){font-size:var(--text-sm);color:var(--text-muted);min-width:10rem;max-width:20rem}
.town-table tbody tr > :nth-child(3) > a{font-weight:600}
.town-table tbody tr > :nth-child(3) > span::before{content:"\00b7";margin:0 .4em;color:var(--text-faint)}
.town-table tbody tr > :nth-child(3) small{font-size:var(--text-xs)}
.town-table tbody tr > :nth-child(4){width:24%;min-width:6.5rem;padding-inline:.9rem;vertical-align:middle}
.town-table tbody tr > :nth-child(4) > i{display:block;position:relative;height:12px}
.town-table tbody tr > :nth-child(4) > i::before{content:"";position:absolute;left:0;right:0;top:5px;height:2px;border-radius:1px;background:linear-gradient(to right,color-mix(in srgb,var(--accent) 55%,transparent) 0 var(--p,0%),var(--border) var(--p,0%) 100%)}
.town-table tbody tr > :nth-child(4) > i::after{content:"";position:absolute;top:1px;left:var(--p,0%);width:10px;height:10px;margin-left:-5px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 2px var(--bg)}
@media(forced-colors:active){.town-table tbody tr > :nth-child(4) > i::before{background:CanvasText}.town-table tbody tr > :nth-child(4) > i::after{background:Highlight;box-shadow:none}}
.town-table tbody tr > :nth-child(5),.town-table tbody tr > :nth-child(6),.town-table tbody tr > :nth-child(7){text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums lining-nums}
.town-table tbody tr > :nth-child(5){font-weight:600;color:var(--text)}
.town-table tbody tr > :nth-child(6),.town-table tbody tr > :nth-child(7){color:var(--text-muted)}
.town-table .t-calc{color:var(--text-faint);font-size:var(--text-sm)}
.town-table .t-none > :nth-child(1){font-family:var(--font-sans);font-size:var(--text-xs);font-weight:400;white-space:normal}
.town-table .t-none > :nth-child(5),.town-table .t-none > :nth-child(6),.town-table .t-none > :nth-child(7){white-space:normal;font-weight:400;color:var(--text-muted);min-width:6.5rem}
.town-table .t-none > :nth-child(5){font-size:var(--text-sm)}
.town-table .town-chip{white-space:normal}
.town-chip{display:inline-block;padding:.1rem .55rem;border:1px solid var(--border-strong);border-radius:999px;font-size:var(--text-xs);line-height:1.5;white-space:nowrap}
.town-sort{font:inherit;font-weight:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;text-align:inherit;min-height:24px}
.town-sort::after{content:" \2195";color:var(--text-faint)}
th[aria-sort="ascending"] .town-sort::after{content:" \2191";color:var(--accent)}
th[aria-sort="descending"] .town-sort::after{content:" \2193";color:var(--accent)}
.town-legend dl{display:grid;gap:0 var(--space-lg);margin:0 0 var(--space-md);grid-template-columns:repeat(auto-fill,minmax(min(100%,20rem),1fr))}
.town-legend dl > div{padding:var(--space-xs) 0;border-top:1px solid var(--border)}
.town-legend dd{margin:var(--space-2xs) 0 0;color:var(--text-muted);font-size:var(--text-sm)}
.town-legend h3{font-size:var(--text-md);margin:var(--space-lg) 0 var(--space-xs)}
@media(max-width:599px){
  .town-table tbody tr > :nth-child(1){grid-column:1;grid-row:1/span 5;width:auto;text-align:left;font-size:var(--text-md)}
  .town-table tbody tr > :nth-child(3){grid-column:2/span 2;grid-row:3;max-width:none;min-width:0}
  .town-table tbody tr > :nth-child(4){grid-column:2/span 2;grid-row:2;width:auto;min-width:0;padding:.15rem 0}
  .town-table tbody tr > :nth-child(5){grid-column:3;grid-row:1;text-align:right}
  .town-table tbody tr > :nth-child(6),.town-table tbody tr > :nth-child(7){grid-row:4;font-size:var(--text-sm)}
