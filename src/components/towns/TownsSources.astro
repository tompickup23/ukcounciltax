---
/**
 * The record line for full Band D figures (F1): the method in a few words, the two
 * MHCLG sources by short title, any council schedules behind the rows shown, and a
 * link to the full reference in the page's Sources block (TownsPageSources), which
 * carries the method, every title, table and retrieval date in full. Before F1 this
 * printed the whole reference here, three or four times on every towns page.
 */
import RecordLine from '../RecordLine.astro';
import {scheduleSourcesFor, townSources} from '../../lib/towns-pages';
import type {Town} from '../../lib/towns';

interface Props {rows: readonly Town[]; lookups?: boolean; method?: string}
const {rows, lookups = false, method} = Astro.props;
const schedules = scheduleSourcesFor(rows);
const names = schedules.length <= 2 ? schedules.map(s => s.publisher).join(' and ') : `${schedules.length} council schedules`;
const tail = schedules.length > 0 ? `or, where a row says so, as printed by ${names}` : undefined;
---
<RecordLine entry="band-d" method={method ? 'Full Band D, positions and differences calculated from' : 'Full Band D calculated from'}
  sources={[townSources.components, townSources.parishes]} tail={tail} />
{lookups && <RecordLine entry="lookups" method="County and constituency from" sources={[{...townSources.parishWard, short: 'ward and constituency lookups'}]} />}
