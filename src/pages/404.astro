---
import CouncilFinder from "../components/CouncilFinder.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" path="/404/" noindex>
  <section class="not-found">
    <h1>Page not found</h1>
    <p>There is no page at this address. <a href="/">Go to the home page</a>, or find your council below.</p>
    <CouncilFinder id="not-found-council" />
    <h2 class="not-found-tools">Or start with a tool</h2>
    <ul class="not-found-links">
      <li><a href="/tools/budget/">Play your council's budget game</a></li>
      <li><a href="/tools/budget/#set-the-budget">Set the budget yourself</a></li>
      <li><a href="/compare/">Compare two councils</a></li>
      <li><a href="/council-tax/#map">Council tax across England on a map</a></li>
      <li><a href="/council-tax/">Council tax in England</a></li>
      <li><a href="/help/">Help with your bill</a></li>
      <li><a href="/scotland/">Council tax in Scotland</a></li>
      <li><a href="/wales/">Council tax in Wales</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
.not-found{padding-top:var(--space-xl);max-width:44rem}
.not-found-tools{font-size:var(--text-lg);margin-top:var(--space-xl)}
.not-found-links{display:grid;gap:var(--space-xs);padding-left:1.1rem}
</style>
