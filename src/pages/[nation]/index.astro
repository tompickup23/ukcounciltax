---
import SourceLine from '../../components/SourceLine.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {nationEditions,nationPath,devolvedSource,devolvedChangePercent} from '../../lib/devolved';
import {moneyPence} from '../../lib/tax-view';
import {yearLabel} from '../../lib/council-tax';
export function getStaticPaths(){return ['Scotland','Wales'].map(nation=>({params:{nation:nation.toLowerCase()},props:{nation}}));}
const {nation}=Astro.props;
const editions=nationEditions(nation);
const previous=editions.at(-2);
const previousByCode=new Map(previous?.records.map(row=>[row.gss,row]) ?? []); const current=editions.at(-1)!; const isScotland=nation==='Scotland';
---
<BaseLayout title={`Council tax in ${nation} ${yearLabel(current.year)}`} description={`Published council tax for every council in ${nation}, with official sources and clear coverage notes.`} path={nationPath(nation)}>
<Breadcrumbs items={[{label: nation}]} />
<header class="page-head"><p class="eyebrow">UK coverage / {nation}</p><h1>Council tax in {nation}</h1><p class="lede">{isScotland?'Every council. Every band from A to H. Three years of published charges.':'Band D averages for all 22 councils, with county, community and police elements.'}</p></header>
<div class="editorial-callout"><strong>{isScotland?'Council tax only, before water charges':'Published Band D averages, rounded to whole pounds'}</strong><p>{current.basis}. {isScotland?'Water and sewerage charges are separate and are not included in these figures.':'Wales has bands A to I. This release holds Band D only; other bands are not inferred from it. Community charges vary within a council area.'}</p></div>
<SourceLine source={devolvedSource(current)} />
<div class="table-wrap" tabindex="0" role="region" aria-label={`${nation} Band D table`}><table class="data"><caption>{yearLabel(current.year)} published Band D {isScotland?'council tax':'average'}</caption><thead><tr><th scope="col">Council</th><th scope="col" class="num">Band D</th>{isScotland && previous && <th scope="col" class="num">Calculated change from {yearLabel(previous.year)}</th>}</tr></thead><tbody>{current.records.map(r=><tr><th scope="row"><a href={nationPath(nation,r.slug)}>{r.name}</a></th><td class="num">{isScotland?moneyPence(r.bandsPence.D):new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP',maximumFractionDigits:0}).format(r.bandsPence.D/100)}</td>{isScotland && previous && <td class="num">{previousByCode.has(r.gss) ? `${moneyPence(r.bandsPence.D-previousByCode.get(r.gss)!.bandsPence.D)} (${devolvedChangePercent(r.bandsPence.D,previousByCode.get(r.gss)!.bandsPence.D)})` : 'Not available'}</td>}</tr>)}</tbody></table></div>
{isScotland && previous && <><p class="caveat">Calculated change compares the two published Band D charges, with water and sewerage excluded in both years.</p><SourceLine source={devolvedSource(previous)} /></>}
<p><a href="/coverage/">Compare coverage across the UK</a> · <a href="/data/">Sources catalogue</a></p>
</BaseLayout>
