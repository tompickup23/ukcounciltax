---
/**
 * What changed: one entry per data update and per findings note, the same
 * items the feed carries, newest first.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RecordLine from "../components/RecordLine.astro";
import PageSources from "../components/PageSources.astro";
import { DATE_WORD, longDate, releaseItems } from "../lib/releases";

const items = releaseItems();
// Each item with a source carries its own record line (publisher, short title
// and the sentence kept on the card), set in src/lib/releases.ts. The original
// description is reproduced word for word in Sources.
const records = items.filter(item => item.sourceUrl).map(item => {
  if (!item.record) throw new Error(`Release item ${item.id} has a source but no record line`);
  return {...item, ...item.record};
});
const recordFor = new Map(records.map(item => [item.id, item]));
---
<BaseLayout
  title="What changed: council tax data updates"
  description="Every data update on UK Council Tax and every findings note, newest first, each with its source edition date and a link to the page that holds the figures."
  path="/changes/"
>
  <Breadcrumbs items={[{ label: "What changed" }]} />
  <header class="page-head">
    <p class="eyebrow">Updates</p>
    <h1>What changed</h1>
    <p class="lede">Each data update the site holds, dated by the dataset's own edition: its publication date where the source manifest records one, otherwise the date it was accessed or generated. The same list is in the <a href="/rss.xml">feed</a>.</p>
  </header>
  <ol class="changes">
    {items.map((item) => (
      <li class="card">
        <p class="small muted"><time datetime={item.date}>{DATE_WORD[item.dateKind]} {longDate(item.date)}</time></p>
        <h2><a href={item.path}>{item.title}</a></h2>
        {item.sourceUrl ? (() => {const record = recordFor.get(item.id)!; return <>
          {record.narrative && <p>{record.narrative}</p>}
          <RecordLine entry={item.id} sources={[{publisher: record.publisher, title: item.title, short: record.short, url: item.sourceUrl}]} />
        </>;})() : <p>{item.description}</p>}
      </li>
    ))}
  </ol>
  <p class="small">Findings notes are on <a href="/findings/">Findings</a>. Every table is listed on <a href="/sources/">Sources</a>.</p>
<PageSources entries={records.map(item => ({key: item.id, label: item.title, sources: []}))}>
    {records.map(item => <Fragment slot={item.id}>
      <p>{DATE_WORD[item.dateKind]} {longDate(item.date)}.</p>
      <p>{item.description} <a href={item.sourceUrl}>Official source page</a></p>
    </Fragment>)}
  </PageSources>
</BaseLayout>

<style>
  .changes { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.85rem; }
  .changes h2 { font-size: 1.15rem; margin: 0.2rem 0 0.4rem; overflow-wrap: anywhere; }
  .changes p { margin: 0.2rem 0; overflow-wrap: anywhere; }
</style>
