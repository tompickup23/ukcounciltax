---
import ViewActions from '../components/ViewActions.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SourceLine from '../components/SourceLine.astro';
import {CURRENT_YEAR, YEARS, BANDS, yearLabel} from '../lib/council-tax';
import {taxRows, taxSources} from '../lib/tax-view-data';
import {englishRows} from '../lib/council-picker';
import {SITE_URL, jsonLd} from '../lib/site';
const picker = new Map(englishRows('profile').map(row => [row.gss, row]));
const rows = taxRows().map(row => ({...row, search: picker.get(row.gss)!.search}));
const sources = taxSources();
---
<BaseLayout title={`Compare council tax in England ${yearLabel(CURRENT_YEAR)}`} description="Compare the published area council tax charge for two councils of the same type, in the same band and financial year." path="/compare/">
  <Breadcrumbs items={[{label: 'Council tax', href: '/council-tax/'}, {label: 'Compare councils'}]} />
  <header class="page-head"><p class="eyebrow">Council tax, England</p><h1>Compare two councils</h1>
    <p class="lede">The same band. The same year. The same type of council.</p>
    <p class="muted">Choose your first council to see eligible comparisons. These are whole-area charges, including average parish precepts, rather than each council's own share.</p>
  </header>
  <section data-tax-compare>
    <section hidden data-comparison-results aria-label="Comparison result">
      <h2 data-comparison-heading tabindex="-1"></h2>
      <div class="card fact comparison-lead" data-fact>
        <strong class="difference-figure" data-figure data-result-difference></strong>
        <p class="source-line" data-difference-source></p>
        <p class="difference-detail" data-result-percentage></p>
        <p class="source-line" data-percentage-calculation></p>
        <p class="difference-detail" data-result-monthly-difference></p>
        <p class="source-line" data-monthly-calculation></p>
        <p class="caveat">Area averages including parish precepts. Your exact bill and any discounts can differ.</p>
      </div>
      <p><a href="#comparison-form">Change councils, band or year</a></p>
      <div class="task-grid">
        {['a','b'].map(side => <div class="card fact" data-fact data-result-side={side}>
          <h3><a data-result-name></a></h3><p class="fact-label" data-result-label></p>
          <strong class="fact-figure" data-figure data-result-annual></strong>
          <p class="source-line" data-result-source></p>
          <p class="caveat">Area average including parish precepts. Your exact bill and any discounts can differ.</p>
        </div>)}
      </div>
      <ViewActions id="comparison" />
      <p><a data-comparison-link>Link to this comparison</a>. You can bookmark this page or copy its address.</p>
    </section>
    <form id="comparison-form" class="card" data-comparison-form>
      <fieldset disabled data-comparison-fields>
        <legend>Choose your comparison</legend>
        <div class="task-grid">
          {['a','b'].map((side, i) => <div class="compare-chooser" data-chooser={side}>
            <label class="field" for={`compare-search-${side}`}>{i === 0 ? 'First' : 'Second'} council, county, region or postcode</label>
            <div class="chooser-input">
              <input id={`compare-search-${side}`} type="search" data-picker-filter={side} autocomplete="off" spellcheck="false" aria-describedby={`compare-note compare-count-${side}`} />
              <button class="button secondary" type="button" data-find={side} aria-label={`Find ${i === 0 ? 'first' : 'second'} council`}>Find</button>
            </div>
            <p class="small" id={`compare-count-${side}`} role="status" data-chooser-status={side}></p>
            <ul class="chooser-matches" data-chooser-matches={side} aria-label={`${i === 0 ? 'First' : 'Second'} council matches`}></ul>
            <button type="button" class="button secondary" data-chooser-more={side} hidden>Show more councils</button>
            <p class="chosen-council" data-chosen={side}>No council selected.</p>
            <select id={`council-${side}`} name={side} aria-label={`${i === 0 ? 'First' : 'Second'} council`} hidden>
              <option value="">Choose a council</option>
              {rows.map(row => <option value={row.slug}>{row.name} ({row.classLabel})</option>)}
            </select>
          </div>)}
        </div>
        <p class="small muted" id="compare-note">A postcode is sent to postcodes.io and not stored. <a href="/privacy/">Privacy</a></p>
        <p id="comparison-rule" class="small muted" data-comparison-rule>The second list is limited to the first council's type.</p>
        <div class="task-grid">
          <div class="field"><label for="compare-band">Band</label><select id="compare-band" name="band">{BANDS.map(band => <option selected={band === 'D'}>{band}</option>)}</select></div>
          <div class="field"><label for="compare-year">Financial year</label><select id="compare-year" name="year">{[...YEARS].reverse().map(year => <option value={year} selected={year === CURRENT_YEAR}>{yearLabel(year)}</option>)}</select></div>
        </div>
        <div class="action-links"><button class="button" type="submit">Compare</button><button class="button secondary" type="button" data-swap>Swap councils</button></div>
      </fieldset>
    </form>
    <p role="status" data-comparison-status>Choose two councils to see their published charges.</p>
    <script type="application/json" data-comparison-data set:html={jsonLd({site: SITE_URL, rows, sources, years: YEARS, currentYear: CURRENT_YEAR})} />
  </section>
  <noscript>
    <section aria-labelledby="compare-without-scripts" data-pagefind-ignore>
      <h2 id="compare-without-scripts">Choose two council pages</h2>
      <p>Open your first council below, then your second. Each link opens a new tab so you can read the published band tables side by side without JavaScript. Choose the same council type, band and year. Area averages include parish precepts.</p>
      <details><summary>Choose from all councils</summary><ul>
        {rows.map(row => <li><a href={`/councils/${row.slug}/`} target="_blank" rel="noopener">{row.name}</a> ({row.classLabel})</li>)}
      </ul></details>
      <p><a href="/council-tax/">Read the complete published tables</a>.</p>
    </section>
  </noscript>
  <details class="section"><summary>Sources and comparison rules</summary>
    <p>Comparisons use published area charges for the same council class, band and financial year. A changed authority code or an absent source value is not filled from an earlier area.</p>
    {YEARS.map(year => <SourceLine source={sources[year]} />)}
    <p><a href="/methodology/">Read the methodology</a>.</p>
  </details>
</BaseLayout>
<script>
  import '../lib/comparison-page';
</script>
<style>
  /* Keep the static controls in layout while the first answer is prepared. */
  :global(html.js) [data-tax-compare]:not([data-comparison-ready]),
  :global(html.js) [data-tax-compare]:not([data-comparison-ready]) ~ details,
  :global(html.js:has([data-tax-compare]:not([data-comparison-ready])) footer) { visibility: hidden; }
  :global(html:not(.js)) [data-comparison-form] { display: none; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-weight: 600; margin-bottom: 1rem; }
  select { width: 100%; min-width: 0; padding: 0.65rem; font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); }
  .compare-chooser { min-width: 0; }
  .chooser-input { display: flex; gap: 0.5rem; }
  .chooser-input input { min-width: 0; width: 100%; font: inherit; padding: 0.65rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); color: var(--text); background: var(--bg); }
  .chooser-matches { list-style: none; padding: 0; margin: 0; }
  .chosen-council { font-weight: 600; }
  .comparison-lead { margin-bottom: var(--space-md, 1rem); }
  .difference-figure { display: block; font-family: var(--font-display); font-size: clamp(1.4rem, 4vw, 2rem); line-height: 1.25; }
  .difference-detail { font-weight: 600; margin-bottom: 0.25rem; }
  [data-comparison-results] { margin-bottom: var(--space-lg, 2rem); }
  [data-comparison-heading] { scroll-margin-top: 1rem; }
  h3 { margin: 0 0 0.75rem; }
</style>

<style is:global>
  .chooser-matches button { display: block; width: 100%; min-height: 44px; text-align: left; font: inherit; padding: 0.6rem; color: var(--accent); background: var(--bg); border: 0; border-bottom: 1px solid var(--border); cursor: pointer; }
  .chooser-matches button:hover { background: var(--accent-wash); }
  .chooser-matches button span { display: block; color: var(--text-muted); font-size: 0.85rem; }
</style>
