---
/**
 * Two families of page from one route: a page per band (every council in
 * England, grouped by region) and a page per English region (every council in
 * it, all eight bands). Both list councils alphabetically within a region;
 * the one ordered table is on /council-tax/, within class.
 */
import TaxTableControls from "../../components/TaxTableControls.astro";
import { taxRows } from "../../lib/tax-view-data";
import TaxTable from "../../components/TaxTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hubCardPath } from "../../lib/og";
import SourceLine from "../../components/SourceLine.astro";
import BandNeighbours from "../../components/BandNeighbours.astro";
import { BAND_PROPORTIONS, LAST_REVIEWED, fullBandEdition, neighbourBands, proportionText } from "../../lib/band-neighbours";
import {
  BANDS,
  CURRENT_YEAR,
  PREVIOUS_YEAR,
  loadYear,
  pounds,
  yearLabel,
  type Band,
} from "../../lib/council-tax";
import {
  REGIONS,
  bandPath,
  bandSlug,
  councilPages,
  councilPath,
  regionPath,
  regionSlug,
  slugify,
  type Region,
} from "../../lib/paths";
import { councilTaxSource, longDate } from "../../lib/sources";

type PageProps = { kind: "band"; band: Band } | { kind: "region"; region: Region };

export function getStaticPaths() {
  return [
    ...BANDS.map((band) => ({ params: { slug: bandSlug(band) }, props: { kind: "band", band } as PageProps })),
    ...REGIONS.map((region) => ({ params: { slug: regionSlug(region) }, props: { kind: "region", region } as PageProps })),
  ];
}

const props = Astro.props as PageProps;
const data = loadYear(CURRENT_YEAR);
const year = yearLabel(CURRENT_YEAR);
const previous = yearLabel(PREVIOUS_YEAR);
const pages = councilPages();
const bandSource = councilTaxSource(CURRENT_YEAR, data.source.bandTable);
const inRegion = (region: string) => pages.filter((p) => p.tax.region === region);

const sides = props.kind === "band" ? neighbourBands(props.band) : null;
const neighbourSummary =
  props.kind === "band" && sides
    ? `Band ${props.band} beside ${[sides.lower, sides.higher].filter(Boolean).map((b) => `Band ${b}`).join(" and ")}`
    : "";
const scotland = props.kind === "band" ? fullBandEdition("Scotland", CURRENT_YEAR) : undefined;

let title: string;
let description: string;
let heading: string;
let crumb: string;
let path: string;
if (props.kind === "band") {
  const count = pages.length;
  title = `Council tax Band ${props.band} ${year} for every council in England`;
  heading = `Council tax Band ${props.band} in England, ${year}`;
  description = `How much Band ${props.band} council tax is in ${year} for all ${count} councils in England, a year and a month, and the change on ${previous}, from MHCLG.`;
  crumb = `Band ${props.band}`;
  path = bandPath(props.band);
} else {
  const count = inRegion(props.region).length;
  title = `Council tax in ${props.region} ${year}: every council by band`;
  heading = `Council tax in ${props.region}, ${year}`;
  description = `Council tax bands A to H in ${year} for all ${count} councils in ${props.region}, and the change in Band D on ${previous}, from MHCLG.`;
  crumb = props.region;
  path = regionPath(props.region);
}
---
<BaseLayout title={title} description={description} path={path} ogImage={hubCardPath("council-tax")}>
  <Breadcrumbs items={[{ label: "Council tax", href: "/council-tax/" }, { label: crumb }]} />
  <header class="page-head">
    <p class="eyebrow">Council tax, England</p>
    <h1>{heading}</h1>
    <p class="lede">
      {props.kind === "band"
        ? `Band ${props.band} for every council in England, by region, as a yearly charge and over ten monthly instalments.`
        : `Every band for every council in ${props.region}, as a yearly charge for a home with two adults.`}
    </p>
    <p class="caveat">
      Each figure is the area charge: the shares of every body that sets council tax there, with parish
      precepts as an average. A home
      in a parish with its own precept pays a different amount.
    </p>
  </header>

  {props.kind === "band" && (
    <>
      <nav aria-label="Other bands">
        <ul class="pill-nav">
          {BANDS.map((band) => (
            <li><a href={bandPath(band)} aria-current={band === props.band ? "page" : undefined}>Band {band}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Jump to a region">
        <ul class="pill-nav">
          {REGIONS.map((region) => <li><a href={`#${slugify(region)}`}>{region}</a></li>)}
        </ul>
      </nav>
      <p class="band-help">
        Not sure which band your home is in? See <a href="/help/#what-council-tax-band-am-i">What council tax band am I?</a> on the help page.
      </p>
      <TaxTableControls id="band-table-controls" caption={`English Band ${props.band} charges by region`} classes={[...new Map(taxRows().map(row => [row.classCode, row.classLabel])).entries()]} band={props.band} fixedBand />
      {REGIONS.map((region) => (
        <section class="section" id={slugify(region)} aria-labelledby={`${slugify(region)}-heading`}>
          <h2 id={`${slugify(region)}-heading`}>How much is Band {props.band} in {region}?</h2>
          <TaxTable id={`table-${slugify(region)}`} region={region} band={props.band} caption={region} controlsId="band-table-controls" />
          <details class="neighbour-details">
            <summary>{neighbourSummary} in {region}</summary>
            <BandNeighbours band={props.band} region={region} />
          </details>
        </section>
      ))}
      {scotland && (
        <section class="section" id="scotland" aria-labelledby="scotland-heading">
          <h2 id="scotland-heading">Band {props.band} in Scotland, {year}</h2>
          <p>
            Scottish councils publish their own charges, on a different basis ({scotland.basis.toLowerCase()}), so these
            figures sit apart from the English tables. The Welsh table this site holds gives an average Band D only, so Welsh councils have no lines here.
          </p>
          <BandNeighbours band={props.band} nation="Scotland" />
        </section>
      )}
      <section class="section" id="band-proportions" aria-labelledby="band-proportions-heading">
        <h2 id="band-proportions-heading">How bands relate to Band D</h2>
        <p>
          Section {BAND_PROPORTIONS.subsection} of the Local Government Finance Act 1992 says that, within the same billing
          authority area, the amounts for bands A to H are in the proportion 6, 7, 8, 9, 11, 13, 15 and 18. As a share of
          Band D, that is {BANDS.map((band) => `${band} ${proportionText(band)}`).join(", ")}.
        </p>
        <p>
          This is an explanation only. Every figure on this page is the published charge for its band, read from the
          published table, and none is worked out from these proportions. The section extends to {BAND_PROPORTIONS.extent};
          Wales adds a ninth band, Band I, under section 5(1A). Any Scottish figures above are the Scottish Government's
          published charges and are not read against this section.
        </p>
        <p class="source-line">
          Source: <a href={BAND_PROPORTIONS.url}>{BAND_PROPORTIONS.publisher}, {BAND_PROPORTIONS.title}</a>, accessed {longDate(BAND_PROPORTIONS.accessed)}.
        </p>
        <p class="small muted" data-last-reviewed>Last reviewed {longDate(LAST_REVIEWED)}.</p>
      </section>
    </>
  )}

  {props.kind === "region" && (
    <>
      <nav aria-label="Other regions">
        <ul class="pill-nav">
          {REGIONS.map((region) => (
            <li><a href={regionPath(region)} aria-current={region === props.region ? "page" : undefined}>{region}</a></li>
          ))}
        </ul>
      </nav>
      <section class="section" aria-labelledby="bands-heading">
        <h2 id="bands-heading">How much is council tax in {props.region} by band?</h2>
        <TaxTable id="region-charges" region={props.region} caption={props.region} />
        <details><summary>View the full eight-band table</summary>
        <p class="small muted">Scroll across for every band. The council name stays visible.</p>
        <div class="fact" data-fact>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Full council tax table">
            <table class="data" data-pagefind-ignore>
              <caption>Area council tax by band, {props.region}, {year}</caption>
              <thead>
                <tr>
                  <th scope="col">Council</th>
                  {BANDS.map((band) => <th scope="col" class="num">{band}</th>)}
                </tr>
              </thead>
              <tbody>
                {inRegion(props.region).map((row) => (
                  <tr data-ons={row.council.gss}>
                    <th scope="row"><a href={councilPath(row.council)}>{row.tax.name}</a></th>
                    {BANDS.map((band) => <td class="num" data-figure>{pounds(row.tax.bands[band])}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <SourceLine source={bandSource} />
        </div>
        </details>
      </section>

    </>
  )}
  <nav class="section" aria-label="Explore council tax">
    <h2>Explore council tax</h2>
    <ul class="pill-nav">
      {props.kind === 'band' && sides && [sides.lower, sides.higher].filter((band): band is Band => Boolean(band)).map(band => <li><a href={bandPath(band)}>Band {band}</a></li>)}
      {props.kind === 'region' && REGIONS.filter(region => region !== props.region).map(region => <li><a href={regionPath(region)}>{region}</a></li>)}
      <li><a href="/council-tax/ranked/">Rankings by council type</a></li>
    </ul>
  </nav>
</BaseLayout>
