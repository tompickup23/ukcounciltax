---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import DeskBand from '../../../components/DeskBand.astro';
import RecordLine from '../../../components/RecordLine.astro';
import PageSources from '../../../components/PageSources.astro';
import RankedClassNav from '../../../components/league/RankedClassNav.astro';
import '../../../styles/league.css';
import {CURRENT_YEAR, loadYear, pounds, yearLabel} from '../../../lib/council-tax';
import {rankingClasses, rankingPage, rankingRule} from '../../../lib/ranking-page';
import {rankingPath} from '../../../lib/paths';
import {councilTaxSource, type SourceRef} from '../../../lib/sources';
import PositionStrip from '../../../vendor/estate-kit/src/components/PositionStrip.astro';
import ChartActions from '../../../components/kit/ChartActions.astro';
import {classChartOptions, type ClassChartName} from '../../../lib/kit-charts';
import {sentenceCase} from '../../../lib/rankings';
const year = yearLabel(CURRENT_YEAR);
const title = `Council tax Band D ranked by type of council ${year}`;
const classes = rankingClasses.map(cls => ({cls,...rankingPage(loadYear(CURRENT_YEAR),cls)}));
const summaryRef: SourceRef = {...councilTaxSource(CURRENT_YEAR,'Tables 9, 8a, 8b and 8c'), short: `Council tax levels ${year}, Tables 9, 8a, 8b and 8c`};
---
<BaseLayout title={title} description={`Every type of council in England in ${year}, with its count and lowest and highest published Band D. Councils are ranked only within their own type.`} path="/council-tax/ranked/">
  <Breadcrumbs items={[{label:'Council tax',href:'/council-tax/'},{label:'Ranked'}]} />
  <DeskBand id="ranked-heading" level={1} top layout="stack" class="ranked-hub-desk" eyebrow={`Band D | ${year} | Ranked within each type`} title="Council tax Band D ranked" accent={`by type of council ${year}`}
    lede={`${rankingRule} Position 1 is the lowest published figure.`}>
    <div slot="foot" class="fact ranked-summary" data-fact>
      <div class="league-wrap" tabindex="0" role="region" aria-label="Council types ranked by Band D"><table class="league league-desk">
        <caption>Published Band D by type of council, {year}</caption>
        <thead><tr><th scope="col">Class</th><th scope="col" class="num">Councils</th><th scope="col" class="num">Lowest area Band D (counties: own)</th><th scope="col" class="num">Highest area Band D (counties: own)</th></tr></thead>
        <tbody>{classes.map(({cls,rows,county}) => <tr><th scope="row"><a href={rankingPath(cls.slug)}>{sentenceCase(cls.label)}</a>{county && <small>Own Band D, one part of the bill in each shire district</small>}</th>{rows ? <><td class="num ranked-count" data-figure>{rows.length}</td><td class="num ranked-end" data-figure><span class="lg-fig">{pounds(county ? rows[0].own : rows[0].area)}</span> in {rows[0].name}</td><td class="num ranked-end" data-figure><span class="lg-fig">{pounds(county ? rows.at(-1)!.own : rows.at(-1)!.area)}</span> in {rows.at(-1)!.name}</td></> : <td colspan="3">not ranked for {year}</td>}</tr>)}</tbody>
      </table></div>
      <RecordLine entry="summary" sources={[summaryRef]} />
    </div>
  </DeskBand>
  <RankedClassNav />
  <p class="ranked-hub-towns">For the whole Band D bill in each parish and unparished area, see <a href="/council-tax/towns/">council tax by parish and unparished area</a>, lowest to highest across England.</p>
  {classes.filter(({rows}) => rows).map(({cls,rows,county}) => { const chart = `ranked-${cls.slug}` as ClassChartName; return (
    <section class="section class-strip" aria-labelledby={`${cls.slug}-heading`}>
      <div class="class-strip-head">
        <h2 id={`${cls.slug}-heading`}>{sentenceCase(cls.label)}</h2>
        <a class="class-strip-all" href={rankingPath(cls.slug)}>All {rows!.length} {cls.label}, lowest to highest</a>
      </div>
      <p class="class-strip-copy">{county
        ? `The ${rows!.length} county councils by their own Band D precept, which is one part of the bill in each of their shire districts. The dot is the average MHCLG publishes for county councils.`
        : `The ${rows!.length} ${cls.label} by area Band D, the whole Band D bill averaged across each council's area. The dot is the average MHCLG publishes for the type. The median, the middle council, is marked separately and is calculated from the councils' own figures.`}</p>
      <div class="fact" data-fact id={`${cls.slug}-strip`}>
        <PositionStrip {...classChartOptions(chart)} />
        <ChartActions chart={chart} target={`${cls.slug}-strip`} />
      </div>
    </section>
  ); })}
  <PageSources entries={[{key: 'summary', label: 'Published Band D by type of council', sources: [summaryRef]}]} />
</BaseLayout>
<style>
.ranked-summary{margin:0}
.ranked-hub-desk :global(.record-line){margin:var(--space-sm) 0 0;font-size:var(--text-xs)}
/* The summary sits on the desk: ink on the ground, the same league rules. */
.league-desk caption{color:var(--desk-ink)}
.league-desk thead th{background:transparent;color:var(--desk-faint);border-bottom-color:var(--desk-ink);position:static}
.league-desk tbody th,.league-desk tbody td{border-bottom-color:color-mix(in srgb,var(--ground-ink) 18%,transparent);color:var(--desk-soft)}
.league-desk tbody th a{color:var(--desk-ink);font-family:var(--font-display);font-size:var(--text-md)}
.league-desk tbody th small{color:var(--desk-faint)}
.league-desk .lg-fig{display:block;color:var(--desk-ink);font-size:var(--text-md)}
.league-desk .ranked-end{white-space:normal;font-size:var(--text-sm)}
.league-desk .ranked-count{font-family:var(--font-display);font-size:var(--text-md);color:var(--desk-ink)}
.league-desk tbody tr:hover > *{background:color-mix(in srgb,var(--ground-ink) 6%,transparent)}
.ranked-hub-towns{max-width:48rem;color:var(--text-muted)}
.class-strip-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--space-2xs) var(--space-lg);border-top:2px solid var(--text);padding-top:var(--space-sm)}
.class-strip-head h2{margin:0}
.class-strip-all{font-weight:600}
.class-strip-copy{max-width:48rem;color:var(--text-muted)}
@media(max-width:599px){
  .league-desk tbody tr:first-child{border-top-color:var(--desk-ink)}
  .league-desk tbody tr{border-bottom-color:color-mix(in srgb,var(--ground-ink) 18%,transparent)}
  .league-desk tbody th[scope="row"]{grid-column:1/span 2;grid-row:1;font-size:inherit}
  .league-desk tbody .ranked-count{grid-column:3;grid-row:1;text-align:right}
  .league-desk tbody .ranked-count::after{content:" councils";font-family:var(--font-sans);font-size:var(--text-xs);color:var(--desk-faint)}
  .league-desk tbody .ranked-end{grid-column:1/span 3;text-align:left}
  .league-desk tbody td:nth-of-type(2)::before{content:"Lowest ";font-size:var(--text-xs);color:var(--desk-faint)}
  .league-desk tbody td:nth-of-type(3)::before{content:"Highest ";font-size:var(--text-xs);color:var(--desk-faint)}
  .league-desk .lg-fig{display:inline}
}
</style>
