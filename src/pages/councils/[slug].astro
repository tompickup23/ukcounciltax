---
/** Published charges, histories, precept context and links for one billing authority. */
import {councilTaxLink, councilLinksSource} from '../../lib/council-links';
import {national} from '../../lib/national-data';
import {localBills} from '../../lib/local-bill-data';
import {bandStockFor} from '../../lib/band-stock';
import {collectionFor} from '../../lib/collection-rates';
import {councilMetadata, NEXT_EDITION_STATUS} from '../../lib/council-metadata';
import {classFor, rankClass, positionWords, sentenceCase} from '../../lib/rankings';
import {rankingPath, budgetSetPages, budgetSetPath} from '../../lib/paths';
import {councilPageSources} from '../../lib/council-page-sources';
import {stockShare} from '../../lib/band-stock';
import RecordLine from '../../components/RecordLine.astro';
import PageSources from '../../components/PageSources.astro';
import IconSprite from '../../vendor/estate-kit/src/components/IconSprite.astro';
import Icon from '../../vendor/estate-kit/src/components/Icon.astro';
import NearbyCouncils from "../../components/NearbyCouncils.astro";
import NetworkStrip from "../../components/NetworkStrip.astro";
import NationalPrecepts from '../../components/NationalPrecepts.astro';
import LongTaxHistory from '../../components/LongTaxHistory.astro';
import PreceptContext from '../../components/PreceptContext.astro';
import BandMix from '../../components/BandMix.astro';
import CollectionRates from '../../components/CollectionRates.astro';
import BudgetSummary from '../../components/BudgetSummary.astro';
import CouncilActions from "../../components/CouncilActions.astro";
import PositionStrip from '../../vendor/estate-kit/src/components/PositionStrip.astro';
import ZeroBar from '../../vendor/estate-kit/src/components/ZeroBar.astro';
import ChartActions from '../../components/kit/ChartActions.astro';
import {profileChartOptions, rankingCardAlt} from '../../lib/kit-charts';
import {embedSnippet, hasLevelsPage, rankingCardPath} from '../../lib/levels-day';
import {glaDecision} from '../../lib/gla';
import {profileBandCells} from '../../lib/profile-bands';
import LocatorMap from '../../vendor/estate-kit/src/components/LocatorMap.astro';
import {boundarySource} from '../../lib/boundaries';
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BandSelector from "../../components/BandSelector.astro";
import PageContents from "../../components/PageContents.astro";
import Fact from "../../components/Fact.astro";
import {
  BANDS,
  AREA_TYPE_LABEL,
  CURRENT_YEAR,
  PREVIOUS_YEAR,
  areaTypeFor,
  bandChange,
  changePhrase,
  increasesYearPath,
  loadYear,
  percent,
  pounds,
  wholePounds,
  yearLabel,
  type Authority,
} from "../../lib/council-tax";
import { councilPages, councilPath, regionPath, scenarioGamePath, SCENARIO_GAME_SLUGS } from "../../lib/paths";
import { type Council } from "../../lib/registry";
import { OFFICIAL_BAND_CHECK, OFFICIAL_COUNCIL_LOOKUP, SITE_URL } from "../../lib/site";
import { councilCardPath } from "../../lib/og";
import { councilTaxSource, longDate } from "../../lib/sources";

export function getStaticPaths() {
  return councilPages().map(({ council, tax }) => ({
    params: { slug: council.slug },
    props: { council, tax },
  }));
}

interface Props {
  council: Council;
  tax: Authority;
}

const { council, tax } = Astro.props;
const hasScenarioGame = (SCENARIO_GAME_SLUGS as readonly string[]).includes(council.slug);
const current = loadYear(CURRENT_YEAR);
const charts = profileChartOptions(council.slug);
const paymentLink = councilTaxLink(council.gss);
const rankType = classFor(tax.classCode)!;
const classRanks = rankClass(current, rankType);
const position = classRanks?.find(row => row.gss === council.gss);
const name = tax.name;
const year = yearLabel(CURRENT_YEAR);
const previous = yearLabel(PREVIOUS_YEAR);
const bandD = tax.bands.D;
const changeD = bandChange(council.gss, "D");
const areaType = areaTypeFor(tax.classCode);
const englandArea = current.england.areaBandD;
const areaSource = englandArea ? councilTaxSource(CURRENT_YEAR, englandArea.table) : null;

/** The class of authority as a sentence, with the county for a district. */
const county = tax.classCode === "SD" && council.parentGss ? current.counties[council.parentGss] ?? null : null;
const TYPE_LINE: Record<Authority["classCode"], string> = {
  ILB: "An inner London borough",
  OLB: "An outer London borough",
  MD: "A metropolitan district",
  UA: "A unitary authority",
  SD: "A shire district",
};
const typeLine = county
  ? `${TYPE_LINE[tax.classCode]} in ${county.name}. ${county.name} County Council also sets council tax here.`
  : `${TYPE_LINE[tax.classCode]} in ${tax.region}.`;

/** The own share tables: the council's, and the county's for a district. */
const own = tax.own;
const ownSource = own ? councilTaxSource(CURRENT_YEAR, own.table) : null;
const countySource = county ? councilTaxSource(CURRENT_YEAR, county.table) : null;

const path = councilPath(council);
const question = `How much is council tax in ${name} in ${year}?`;

/** W9: the ledger row, record lines and the one Sources block. */
const hasSetPage = budgetSetPages().some(page => page.slug === council.slug);
const hasComponents = Boolean(national.components[council.gss]);
const stock = bandStockFor(council.gss);
const refs = councilPageSources({gss: council.gss, name, tax, rankType, county: county ? {name: county.name, table: county.table} : null, areaTable: englandArea && areaSource ? englandArea.table : null, hasPosition: Boolean(position && classRanks)});
const ownChange = own && typeof own.changePct === "number" ? `${own.changePct >= 0 ? "up" : "down"} ${percent(Math.abs(own.changePct), 2)} on ${previous}, as published` : null;
const ledgerCells = 1 + (own && typeof own.bandD === "number" ? 1 : 0) + (position && classRanks ? 1 : 0) + (stock && stock.bandDAndBelowShare !== null ? 1 : 0);
const historyStart = Object.keys(national.history[council.gss].area.values).find(year => national.history[council.gss].area.values[year] !== null)?.replace('-', '/');

const {title, description} = councilMetadata({name, currentPence: Math.round(bandD * 100), previousPence: changeD ? Math.round(changeD.from * 100) : null, basis: 'area average including average parish precepts', nation: 'England'});

---
<BaseLayout
  title={title}
  description={description}
  path={path}
  about={{"@type": "GovernmentOrganization", name: council.officialName, identifier: council.gss, areaServed: {"@type": "AdministrativeArea", name, identifier: council.gss}}}
  ogImage={councilCardPath(council.slug)}
  ogImageAlt={`${name}: council tax bands A to H, ${year}`}
>
  <IconSprite />
  <Breadcrumbs items={[{ label: "Councils", href: "/councils/" }, { label: name }]} />

  <header class="page-head council-head">
    <p class="eyebrow">Council</p>
    <h1>{title}</h1>
    <p class="muted">{typeLine}</p>
  </header>

  <div class="council-ledger" style={`--cells:${ledgerCells}`} data-council-ledger>
    <div class="ledger-cell" data-fact data-ledger="band-d">
      <p class="ledger-label">Band D, {year}, area average</p>
      <p class="ledger-value" data-figure>{pounds(bandD)}</p>
      {changeD && <p class="ledger-change">{changePhrase(changeD)} on {previous}</p>}
      <p class="ledger-note">Includes average parish precepts, before discounts.</p>
      {changeD && <details class="ledger-calc"><summary>Calculation</summary>
        <p>The change is the {year} Band D charge less the {previous} charge of {pounds(changeD.from)}, and that difference as a percentage of the {previous} charge, rounded to one decimal place.</p>
      </details>}
      {changeD ? <RecordLine entry="council-change" method={refs.change.method} sources={[refs.change]} /> : <RecordLine entry="council-bands" sources={[refs.bands]} />}
    </div>
    {own && refs.own && typeof own.bandD === "number" && <div class="ledger-cell" data-fact data-ledger="own">
      <p class="ledger-label">{name} council's own Band D, {year}</p>
      <p class="ledger-value" data-figure>{pounds(own.bandD)}</p>
      {ownChange && <p class="ledger-change">{ownChange}</p>}
      <p class="ledger-note">The council's own share of the bill.</p>
      <RecordLine entry="council-own" sources={[refs.own]} />
    </div>}
    {position && classRanks && <div class="ledger-cell" data-fact data-ledger="position">
      <p class="ledger-label">Area Band D within {rankType.label}</p>
      <p class="ledger-value" data-figure>{positionWords(position.areaPosition, position.areaTied)} of {classRanks.length}</p>
      <p class="ledger-note">Counted from the lowest.</p>
      <details class="ledger-calc"><summary>Calculation</summary>
        <p>Every one of the {classRanks.length} {rankType.label} in England put in order of its published area Band D for {year}, from the lowest. Equal figures share a position.</p>
      </details>
      <RecordLine entry="council-position" method="Positions calculated from the published figures" sources={[refs.position]} />
    </div>}
    {stock && refs.stock && stock.bandDAndBelowShare !== null && <div class="ledger-cell" data-fact data-ledger="stock">
      <p class="ledger-label">Properties in Band D or below</p>
      <p class="ledger-value" data-figure>{stockShare(stock.bandDAndBelowShare, null)}</p>
      <p class="ledger-note">Of the properties on the valuation list in {name}.</p>
      <details class="ledger-calc"><summary>Calculation</summary>
        <p>HMRC's printed counts for Bands A to D added together, divided by its printed total of all properties, to one decimal place. HMRC rounds every count to the nearest 10.</p>
      </details>
      <RecordLine entry="council-stock" method="Share calculated from the printed counts" sources={[refs.stock]} />
    </div>}
  </div>

  <div class="council-actions" role="group" aria-label="Council tax next steps">
    <a class="button" data-council-compare href={`/compare/?a=${council.slug}&band=D&year=${CURRENT_YEAR}`}><Icon name="scale" />Compare this council</a>
    {hasSetPage && <a class="button secondary" data-council-set href={budgetSetPath(council.slug)}><Icon name="sliders-horizontal" />Set the budget</a>}
    {hasComponents && <a class="button secondary" data-council-parts href="#precept-breakdown"><Icon name="list-checks" />What makes up this bill</a>}
    <CouncilActions slug={council.slug} />
  </div>
  <p class="small council-edition" data-next-edition>{NEXT_EDITION_STATUS}</p>

  <div class="council-body">
    <aside class="council-rail">
      <PageContents rail groups={[
        {label: 'Your council tax', items: [
          {id: 'council-tax', label: 'Bands A to H'},
          ...(hasComponents ? [{id: 'precept-breakdown', label: 'Where a Band D bill goes'}] : []),
          ...(englandArea && areaSource ? [{id: 'compared', label: `${sentenceCase(rankType.label)} and England`}] : []),
        ]},
        {label: 'Area and history', items: [
          {id: 'map', label: 'Map'},
          {id: 'history', label: `Band D since ${historyStart}`},
        ]},
        {label: 'Paying and precepts', items: [
          {id: 'discounts-and-paying', label: 'Discounts, exemptions and how to pay'},
          ...(own && ownSource ? [{id: 'who-sets-it', label: 'Who sets the charge'}] : []),
          ...(tax.region === 'London' && glaDecision() ? [{id: 'mayoral-precept', label: 'The mayoral precept'}] : []),
          {id: 'parish-precepts', label: 'Parish charges'},
        ]},
        {label: 'Council and local context', items: [
          ...(stock ? [{id: 'band-mix', label: 'Properties in each band'}] : []),
          ...(collectionFor(council.gss) ? [{id: 'collection', label: 'Collection rates'}] : []),
          {id: 'where-money-goes', label: 'Where the money goes'},
          {id: 'similar', label: 'Nearby and alike'},
          {id: 'next-steps', label: 'Next steps'},
          {id: 'more', label: `${name} across the network`},
          {id: 'sources', label: 'Sources'},
        ]},
      ]} />
    </aside>

    <div class="council-main">
  <section class="section" id="council-tax" aria-labelledby="council-tax-heading">
    <h2 id="council-tax-heading">{question}</h2>
    <p class="muted">Published yearly charge for each band, before discounts.</p>
    <div class="fact band-chart" data-fact id="band-bars">
      <ZeroBar {...charts.bands} />
      <ChartActions chart={`councils/${council.slug}/bands`} target="band-bars" />
    </div>
    <details class="band-figures" data-band-figures>
      <summary>Band table, with each charge divided by 10 and by 12</summary>
      <div class="fact" data-fact>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Published council tax bands and budgeting equivalents">
          <table class="data" data-band-table>
            <caption>Council tax bands A to H in {name}, {year}: the published yearly charge, and that charge divided by 10 and by 12</caption>
            <thead><tr><th scope="col">Band</th><th scope="col" class="num">Yearly charge</th><th scope="col" class="num">Divided by 10</th><th scope="col" class="num">Divided by 12</th></tr></thead>
            <tbody>{BANDS.map(band => <tr><th scope="row">{band}</th>{profileBandCells(tax.bands[band]).map((value, index) => <td class="num" data-figure={index === 0 ? '' : undefined}>{value}</td>)}</tr>)}</tbody>
          </table>
        </div>
        <p class="calc-label">The two right hand columns are our calculation: the published yearly charge divided by 10 and by 12, rounded to the penny. They are not your instalments. GOV.UK says “The cost is usually split into 10 monthly payments”, and your council can agree 12. Your bill sets the actual amounts and dates.</p>
        <RecordLine entry="council-bands" method={refs.bandsCalc.method} sources={[refs.bandsCalc]} />
        <p class="small">Instalment wording: <a href="https://www.gov.uk/council-tax/paying-your-bill">GOV.UK, How Council Tax works, Paying your bill</a>, updated 5 February 2025, read 9 November 2026.</p>
      </div>
    </details>
    <p class="caveat" data-parish-caveat>Every band includes the share of every body that sets council tax in {name}, with parish and town council precepts as an average across the area. A home in a parish pays that parish's own precept instead of the average, so its bill differs. Discounts, such as the single person discount, are not taken off.</p>
    {tax.notes.length > 0 && (
      <ul class="notes">
        {tax.notes.map((note) => <li>MHCLG note: {note.text}</li>)}
      </ul>
    )}
    <h3>Change on {previous} by band</h3>
    <p>Choose a band to see its change on {previous}. The band you choose is also set in the compare link above.</p>
    <BandSelector ons={council.gss} authority={tax} compact record={{entry: 'council-bands', source: refs.bands}} changeRecord={{entry: 'council-change', source: refs.change}} />
    {localBills.some(b=>b.gss===council.gss)&&<p data-find-your-bill>The full published schedule is held for this council: <a href="/precepts/#find-your-bill">find your own bill, by band and parish</a>, see what each part pays for and what changed since last year.</p>}
  </section>

  <NationalPrecepts gss={council.gss} name={name} classCode={tax.classCode} view="bill" />

  {englandArea && areaSource && refs.area && (
    <section class="section" id="compared" aria-labelledby="compared-heading">
      <h2 id="compared-heading">How does Band D in {name} compare?</h2>
      <div class="fact-grid">
        <div class="card">
          <Fact
            label={`England average area Band D, ${year}`}
            figure={wholePounds(englandArea.england.pounds)}
            change={`up ${percent(englandArea.england.changePct)} on ${previous}`}
            source={refs.area}
            record="council-averages"
          />
        </div>
        <div class="card">
          <Fact
            label={`Average area Band D for ${AREA_TYPE_LABEL[areaType]}, ${year}`}
            figure={wholePounds(englandArea.byAreaType[areaType].pounds)}
            change={`up ${percent(englandArea.byAreaType[areaType].changePct)} on ${previous}`}
            source={refs.area}
            record="council-averages"
          />
        </div>
      </div>
      {position && classRanks && <div class="fact" data-fact data-class-position>
        <p>Within {rankType.label} in {year}: {name} is {positionWords(position.areaPosition, position.areaTied)} of {classRanks.length} for area Band D and {positionWords(position.ownPosition, position.ownTied)} of {classRanks.length} for the council's own Band D, counted from the lowest.</p>
        <p><a href={rankingPath(rankType.slug)}>All {rankType.label} ranked by Band D</a>.</p>
        {tax.notes.length > 0 && <p>MHCLG publishes a note on this figure; it is under the band table.</p>}
        <RecordLine entry="council-position" method="Positions calculated from the published figures" sources={[refs.position]} />
      </div>}
      <div class="fact" data-fact id="class-position-chart">
        <PositionStrip {...charts.position} />
        <ChartActions chart={`councils/${council.slug}/position`} target="class-position-chart" />
      </div>
      {hasLevelsPage() && <details class="ranking-embed" data-ranking-embed>
        <summary>Share this ranking as an image</summary>
        <p>The strip above as a 1200 by 630 image, with its source and edition on the card. To show it on another web page with a link back here, paste:</p>
        <p class="prose"><code>{embedSnippet(SITE_URL, council.slug, rankingCardAlt(council.slug), councilPath(council))}</code></p>
        <p><a href={rankingCardPath(council.slug)}>Open the image</a>.</p>
      </details>}
      <p class="muted">
        Both averages include parish and adult social care precepts, the same basis as the {name} figure.
        <a href={`${regionPath(tax.region)}?type=${tax.classCode}`}>Band D in {tax.region}, starting with {rankType.label}</a>.
      </p>
    </section>
  )}

  <section class="section" id="map" aria-labelledby="map-heading">
    <h2 id="map-heading">Where {name} is</h2>
    <div class="fact locator-fact" data-fact id="locator-chart">
      <LocatorMap {...charts.map} />
      <ChartActions chart={`councils/${council.slug}/map`} target="locator-chart" />
      <p class="small">Shaded by area Band D, the average bill for each whole council area including adult social care and average parish precepts, which MHCLG publishes on the same basis for every class of council in Table 9. Illustrative boundaries, not property or billing boundaries.</p>
      <p class="small">Map detail: {boundarySource.method}</p>
    </div>
  </section>

  <section class="section" id="history" aria-labelledby="history-heading">
    <h2 id="history-heading">How has Band D in {name} changed?</h2>
    <LongTaxHistory gss={council.gss} name={name} view="chart" record={{entry: 'council-history', source: refs.history}} />
  </section>

  <section class="section" id="discounts-and-paying" aria-labelledby="discounts-heading">
    <h2 id="discounts-heading">Discounts, exemptions and how to pay in {name}</h2>
    <p>Discounts and exemptions depend on who lives in the home and the home itself. A household with one counted adult may get a 25% discount, and some people and some homes are not counted or are exempt. This site does not decide eligibility. <a href="/help/#check-discounts-and-reductions">Discounts, reductions and who is counted</a>.</p>
    <p>If paying is difficult, contact the council early. <a href="/help/#if-paying-is-difficult">If paying is difficult</a>.</p>
    {paymentLink ? <>
      <p><a href={paymentLink} data-council-payment>Pay or manage your council tax on {council.officialName}'s website</a>.</p>
      <p class="source-line">Link from <a href={councilLinksSource.url}>GOV.UK Local Links Manager</a>, service “Pay your Council Tax” (LGSL 57), export of {longDate(councilLinksSource.exportDate)}, checked by UK Places on {longDate(councilLinksSource.checkedOn)}.</p>
    </> : <p>We do not hold a checked link to {name}'s own council tax page. <a href={OFFICIAL_COUNCIL_LOOKUP}>Find your council on GOV.UK</a>.</p>}
    <p><a href="/help/">Help with your bill</a> · <a href="/help/#what-council-tax-band-am-i">What council tax band am I?</a> · <a href={OFFICIAL_BAND_CHECK}>Find your property band on GOV.UK</a> · <a href={OFFICIAL_COUNCIL_LOOKUP}>Find your council for your exact bill</a>.</p>
    <p>Check the payment dates on your bill. <a href="/help/#check-the-payment-schedule">How council tax is paid</a>.</p>
  </section>

  {own && ownSource && (
    <section class="section" id="who-sets-it" aria-labelledby="who-sets-heading">
      <h2 id="who-sets-heading">Who sets council tax in {name}?</h2>
      <p class="muted">
        The figures below show each council's own share and its published annual change. The national breakdown above also identifies police, fire and combined-authority charges for this billing area.
      </p>
      <div class="fact-grid">
        {typeof own.bandD === "number" && refs.own && (
          <div class="card">
            <Fact
              label={`${name} council's own Band D, ${year}`}
              figure={pounds(own.bandD)}
              change={ownChange}
              source={refs.own}
              record="council-own"
            />
          </div>
        )}
        {county && refs.county && typeof county.bandD === "number" && (
          <div class="card">
            <Fact
              label={`${county.name} County Council's Band D, ${year}`}
              figure={pounds(county.bandD)}
              change={typeof county.changePct === "number" ? `${county.changePct >= 0 ? "up" : "down"} ${percent(Math.abs(county.changePct), 2)} on ${previous}, as published` : null}
              source={refs.county}
              record="council-own"
            />
          </div>
        )}
      </div>
      {own.notes.length > 0 && (
        <ul class="notes">
          {own.notes.map((note) => <li>MHCLG note: {note.text}</li>)}
        </ul>
      )}
      <p class="muted"><a href={increasesYearPath(CURRENT_YEAR)}>How much every council raised its own share this year</a>.</p>
    </section>
  )}

  <PreceptContext region={tax.region} gss={council.gss} />
  <NationalPrecepts gss={council.gss} name={name} classCode={tax.classCode} view="parishes" parishRecord={{entry: 'council-parishes', source: refs.parishes}} />
  <BandMix gss={council.gss} name={name} record={refs.stock ? {entry: 'council-stock', source: refs.stock} : undefined} />
  <CollectionRates gss={council.gss} name={name} record={refs.collection ? {entry: 'council-collection', source: refs.collection} : undefined} />
  <BudgetSummary gss={council.gss} slug={council.slug} name={name} record={{entry: 'council-budget', source: refs.budget}} />
  {hasScenarioGame && <p>A separate <a href={scenarioGamePath(council.slug)} data-scenario-game-link>budget scenario game</a> starts from {name} Borough Council's own published budget gap and lets you set council tax, spending and reserves.</p>}

  <NearbyCouncils council={council} rankingHref={rankingPath(rankType.slug)} rankingLabel={rankType.label} />

  <section class="section" id="next-steps" aria-labelledby="next-steps-heading">
    <h2 id="next-steps-heading">Next steps</h2>
    <ul class="next-cards" data-next-steps>
      <li><a class="next-card" href={`/tools/budget/${council.slug}/`} data-council-game><Icon name="gamepad-2" /><span>Explore {name}'s budget and play the budget game</span></a></li>
      <li><a class="next-card" data-council-scenario href={`/tools/future-cost/?council=${council.slug}&band=D`}><Icon name="calculator" /><span>What could council tax cost</span></a></li>
      <li><a class="next-card" href="/precepts/"><Icon name="landmark" /><span>What makes up my bill</span></a></li>
      <li><a class="next-card" href="/increases/"><Icon name="chart-column" /><span>Council tax increases {year} by council</span></a></li>
    </ul>
  </section>

  <section class="section" id="more" aria-labelledby="more-heading">
    <h2 id="more-heading">{name} across the network</h2>
    <NetworkStrip council={council} name={name} />
  </section>

  <PageSources entries={refs.entries} />
    </div>
  </div>
</BaseLayout>

<style>
  .locator-fact { max-width: 40rem; }
  #council-tax { margin-top: 0; }
  .notes { font-size: 0.9rem; color: var(--text-muted); padding-left: 1.1rem; }

  /* W9: the ledger row under the H1. Figures already on the page, on a 2px ink rule with hairline dividers; each derived figure has its calculation behind a disclosure. */
  .council-head { margin-bottom: var(--space-sm); }
  .council-ledger { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 2px solid var(--text); margin-block: var(--space-sm) var(--space-md); }
  .ledger-cell { display: flex; flex-direction: column; min-width: 0; padding: var(--space-sm) var(--space-md) var(--space-xs); border-bottom: 1px solid var(--border); }
  .ledger-cell:nth-child(even) { border-left: 1px solid var(--border); }
