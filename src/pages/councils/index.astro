---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hubCardPath } from "../../lib/og";
import CouncilPicker from "../../components/CouncilPicker.astro";
import { englishRows } from "../../lib/council-picker";
import { CURRENT_YEAR, loadYear, pounds, yearLabel } from "../../lib/council-tax";
import { REGIONS, councilPages, regionPath } from "../../lib/paths";
import { councilTaxSource } from "../../lib/sources";

const pages = councilPages();
const year = yearLabel(CURRENT_YEAR);
const source = councilTaxSource(CURRENT_YEAR, loadYear(CURRENT_YEAR).source.bandTable);
const bandD = Object.fromEntries(
  pages.map(({ council, tax }) => [council.gss, typeof tax.bands.D === "number" ? { text: pounds(tax.bands.D), sort: tax.bands.D } : null]),
);
---
<BaseLayout
  title="Every council in England, by region"
  description={`All ${pages.length} councils in England that set council tax, by region, each with its council tax bands for the year and where the figures come from.`}
  path="/councils/"
  ogImage={hubCardPath("councils")}
>
  <Breadcrumbs items={[{ label: "Councils" }]} />
  <header class="page-head">
    <p class="eyebrow">Councils</p>
    <h1>Every council in England</h1>
    <p class="lede">Find a council by postcode or name.</p>
  </header>
  <CouncilPicker
    id="councils-picker"
    rows={englishRows("profile")}
    caption={`Every council in England that bills council tax, with its area Band D for ${year}`}
    figure={{ heading: `Area Band D ${year}`, values: bandD, missing: "not published", source }}
    outside="That postcode is not in an English billing authority. Use the postcode box on the homepage for Scotland and Wales."
  />
  <section class="section" aria-labelledby="about-councils">
    <h2 id="about-councils">About this list</h2>
    <p>
      The {pages.length} councils in England that bill council tax. Each page answers what the council
      charges and where the figures come from. Councils in Scotland, Wales and Northern Ireland follow.
    </p>
    <p>
      The figure beside each name is its area Band D for {year}: the whole Band D bill averaged across the
      council's area, including adult social care and average parish precepts. It is not the bill for any address.
    </p>
  </section>
  <nav aria-label="Council tax by region">
    <ul class="pill-nav">
      {REGIONS.map((region) => <li><a href={regionPath(region)}>{region}</a></li>)}
    </ul>
  </nav>
</BaseLayout>
