---
import BaseLayout from '../layouts/BaseLayout.astro';
import {YEARS, loadYear, yearLabel} from '../lib/council-tax';
import {national} from '../lib/national-data';
import {devolved} from '../lib/devolved';
import {localBills} from '../lib/local-bill-data';
const publications = [
  ...YEARS.flatMap(year => {
    const {source} = loadYear(year);
    return source.files.map(file => ({publisher:source.publisher, title:file.title, edition:yearLabel(year), table:year === '2024-25' ? file.title.split(':')[0] : 'Tables 1 to 9', retrieved:'Not recorded separately from import date', licence:source.licence, url:file.url}));
  }),
  ...Object.entries(national.sources).map(([key, source]) => ({publisher:source.publisher,title:source.title,edition:key === 'history' ? 'Revised April 2026; series from 1993/94' : '2026/27',table:source.tables.join(', '),retrieved:source.retrieved,licence:source.licence,url:source.fileUrl})),
  ...devolved.editions.map(edition => ({publisher:edition.nation === 'Scotland' ? 'Scottish Government' : 'Welsh Government',title:edition.source.title,edition:yearLabel(edition.year),table:edition.table,retrieved:devolved.retrieved,licence:devolved.licence,url:edition.source.fileUrl})),
  ...localBills.map(bill => ({publisher:bill.source.publisher,title:bill.source.title,edition:yearLabel(bill.year),table:'Component rows and locality totals, bands A to H',retrieved:bill.source.retrieved,licence:'Not recorded; check publisher terms',url:bill.source.url})),
  {publisher:'Greater London Authority',title:'MD3472: approval of 2026/27 council tax and precepts',edition:'2026/27; approved 26 February 2026',table:'Sections 2.2 and 2.3',retrieved:'Page checked 5 October 2026; original file not retained',licence:'Not recorded; check publisher terms',url:'https://www.london.gov.uk/md3472-approval-2026-27-council-tax-and-precepts-and-communication-council-taxpayers'},
];
---
<BaseLayout title="Council tax sources and official publications" description="Official council tax publications, publishers, editions, tables, retrieval dates and licences. Follow the original publisher links." path="/data/">
<header class="page-head"><p class="eyebrow">Official evidence</p><h1>Sources</h1><p class="lede">The publications behind the figures, linked to the original publisher.</p></header>
<p>UK Council Tax publishes pages, not compiled datasets. Source manifests and file checksums are retained in the project for verification. Read, share or print the supported views; use the publisher links below for original files.</p>
<div class="table-wrap" tabindex="0" role="region" aria-label="Official source publications">
<table class="data"><caption>Official publications used for council tax figures</caption><thead><tr><th scope="col">Publisher and publication</th><th scope="col">Edition and table</th><th scope="col">Retrieval and licence</th></tr></thead><tbody>
{publications.map(source => <tr data-source-publication><th scope="row"><span>{source.publisher}</span><br/><a href={source.url}>{source.title}</a></th><td>{source.edition}<br/>{source.table}</td><td>{source.retrieved}<br/>{source.licence}</td></tr>)}
</tbody></table></div>
<div class="prose"><h2>Interpretation and reuse</h2><p>Follow the licence recorded for each publication. Where a licence or separate retrieval date is absent from the retained record, that gap is stated above. The GLA reference links to its decision page because no original file was retained.</p><p>Amounts are before household discounts and premiums. Area averages are not address-level bills. Missing bands are not calculated from ratios. Scottish charges exclude water and sewerage. Welsh figures preserve the whole-pound display precision of Table 1. Calculated changes and illustrative scenarios are labelled separately.</p><p><a href="/methodology/">Read the methodology</a> · <a href="/coverage/">Check coverage before comparing</a> · <a href="/sources/">Council registry and postcode sources</a></p></div>
</BaseLayout>
<style>table{table-layout:fixed;width:100%;min-width:0}th,td{overflow-wrap:anywhere;vertical-align:top}th span{font-weight:400} @media(max-width:640px){table{font-size:.8rem}th,td{padding:.6rem .4rem}}</style>
