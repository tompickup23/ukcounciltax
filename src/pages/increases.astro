---
import BaseLayout from '../layouts/BaseLayout.astro';
import {taxRows} from '../lib/tax-view-data';
import {loadYear,CURRENT_YEAR} from '../lib/council-tax';
import {jsonLd} from '../lib/site';
const rows=taxRows();const current=loadYear(CURRENT_YEAR);
const data=rows.map(r=>({...r,own:current.authorities[r.gss].own}));
---
<BaseLayout title="Annual council tax increases" description="Explore whole-bill increases by band and council, and distinguish them from the increase in a council's own share." path="/increases/">
<header class="page-head"><p class="eyebrow">Follow the change</p><h1>How much has council tax increased?</h1><p class="lede">The change in your whole bill can differ from the percentage announced by one council.</p></header>
<div class="editorial-callout"><strong>Two measures, kept separate</strong><p>Whole-area changes are calculated from published band charges, including average parish precepts. The own-share percentage is MHCLG's published change for the billing council alone. It is not the percentage change in your complete bill.</p></div>
<section data-increases class="section"><div class="card task-grid"><label class="field">Find a council<input type="search" data-filter placeholder="Council name" /></label><label class="field"><span id="increase-band-label">Band</span><select data-band aria-labelledby="increase-band-label">{'ABCDEFGH'.split('').map(b=><option selected={b==='D'}>{b}</option>)}</select></label><label class="field"><span id="increase-period-label">Compare years</span><select data-period aria-labelledby="increase-period-label"><option value="2025-26">2025/26 to 2026/27</option><option value="2024-25">2024/25 to 2026/27</option></select></label><label class="field"><span id="increase-type-label">Council type</span><select data-class aria-labelledby="increase-type-label"><option value="all">All types, alphabetical</option>{[...new Map(rows.map(r=>[r.classCode,r.classLabel])).entries()].map(([c,l])=><option value={c}>{l}</option>)}</select></label></div><p data-count role="status">296 councils, listed alphabetically.</p>
<div class="table-wrap" tabindex="0" role="region" aria-label="Council tax annual changes"><table class="data"><caption>Whole-area charges and calculated changes; own-share change is always 2025/26 to 2026/27</caption><thead><tr><th scope="col">Council</th><th scope="col" class="num">Earlier charge</th><th scope="col" class="num">2026/27</th><th scope="col" class="num">Cash change</th><th scope="col" class="num">Whole-area change</th><th scope="col" class="num">Own-share change</th></tr></thead><tbody>{data.map(r=>{const a=r.years['2025-26'].D!;const b=r.years[CURRENT_YEAR].D!;return <tr data-row={r.slug}><th scope="row"><a href={`/councils/${r.slug}/`}>{r.name}</a></th><td class="num">£{(a/100).toFixed(2)}</td><td class="num">£{(b/100).toFixed(2)}</td><td class="num">£{((b-a)/100).toFixed(2)}</td><td class="num">{((b-a)/a*100).toFixed(2)}%</td><td class="num">{r.own?.changePct===null||r.own?.changePct===undefined?'Not published':r.own.changePct.toFixed(2)+'%'}</td></tr>;})}</tbody></table></div>
<p class="source-line">Source: <a href="/data/">MHCLG source editions 2024/25, 2025/26 and 2026/27</a>. Calculated percentage = (later charge − earlier charge) ÷ earlier charge × 100. Figures are nominal, before discounts. Missing figures are not carried forward.</p><noscript><p>The table shows Band D, 2025/26 to 2026/27. Enable JavaScript to filter or change bands.</p></noscript><script type="application/json" data-increase-data set:html={jsonLd(data)} /></section>
</BaseLayout>
<script>
import {moneyPence,type TaxRow,type TaxBand} from '../lib/tax-view';
const root=document.querySelector('[data-increases]')!;
const data=JSON.parse(root.querySelector('[data-increase-data]')!.textContent!) as TaxRow[];
const search=root.querySelector<HTMLInputElement>('[data-filter]')!,band=root.querySelector<HTMLSelectElement>('[data-band]')!,period=root.querySelector<HTMLSelectElement>('[data-period]')!,type=root.querySelector<HTMLSelectElement>('[data-class]')!;
const update=()=>{let count=0;for(const r of data){const tr=root.querySelector<HTMLTableRowElement>(`[data-row="${r.slug}"]`)!;tr.hidden=!r.name.toLowerCase().includes(search.value.trim().toLowerCase())||(type.value!=='all'&&r.classCode!==type.value);if(tr.hidden)continue;count++;const a=r.years[period.value]?.[band.value as TaxBand],b=r.years['2026-27']?.[band.value as TaxBand];const vals=a&&b?[moneyPence(a),moneyPence(b),moneyPence(b-a),((b-a)/a*100).toFixed(2)+'%']:['Unavailable','Unavailable','Unavailable','Unavailable'];vals.forEach((v,i)=>tr.cells[i+1].textContent=v);}root.querySelector('[data-count]')!.textContent=`${count} councils shown. Band ${band.value}, ${period.value.replace('-','/')} to 2026/27.`;};[search,band,period,type].forEach(e=>e.addEventListener('input',update));
</script>
