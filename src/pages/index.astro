---
import BaseLayout from "../layouts/BaseLayout.astro";
import BillAnatomy from "../vendor/estate-kit/src/components/BillAnatomy.astro";
import { BURNLEY_PARTS, siteFigures } from "../lib/figures";
import CouncilFinder from "../components/CouncilFinder.astro";
import BandDLine from "../components/BandDLine.astro";
import SourceLine from "../components/SourceLine.astro";
import Fact from "../components/Fact.astro";
import PostcodeDoor from "../components/PostcodeDoor.astro";
import { BANDS, CURRENT_YEAR, PREVIOUS_YEAR, increasesYearPath, loadYear, percent, wholePounds, yearLabel } from "../lib/council-tax";
import { REGIONS, bandPath, councilPages, regionPath } from "../lib/paths";
import { councilTaxSource } from "../lib/sources";

const data = loadYear(CURRENT_YEAR);
const area = data.england.areaBandD;
const year = yearLabel(CURRENT_YEAR);
const previous = yearLabel(PREVIOUS_YEAR);
const count = councilPages().length;
const figures = siteFigures();
const billKeys = BURNLEY_PARTS.map((k) => `burnley.bandd.${k}`);
---
<BaseLayout path="/" title={`Council tax ${year}: bands, bills and local precepts`}>
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">Independent data · Official sources · {year}</p>
      <h1 id="hero-heading">Council tax {year}</h1>
      <p class="lede">What your bill is, who charges it and how it has changed, from the councils' and MHCLG's own published tables.</p>
      <div class="hero-door" id="find-council">
        <PostcodeDoor id="postcode-home" heading="Your postcode" submitLabel="Show my council tax" bare />
        <p class="door-or">or</p>
        <CouncilFinder label="Council name" bare />
      </div>
      <p class="hero-coverage">296 English billing authorities · 32 Scottish councils · 22 Welsh Band D averages</p>
      <p class="hero-nations"><a href="/councils/">England</a> · <a href="/scotland/">Scotland</a> · <a href="/wales/">Wales</a> · <a href="/coverage/">Northern Ireland and coverage</a></p>
    </div>
    <aside class="bill-card" aria-labelledby="bill-heading">
      <div class="bill-card-head"><span class="eyebrow">Anatomy of a bill</span><span class="small muted">Published example</span></div>
      <h2 id="bill-heading">Burnley, unparished area, Band D</h2>
      <div data-fact class="bill-fact">
        <BillAnatomy set={figures} parts={billKeys} total="burnley.bandd.total" title="Four bodies charge a Burnley Band D bill" class="bill-figure" />
        <p class="source-line" set:html={figures.captionHtml([...billKeys, "burnley.bandd.total"])} />
      </div>
      <p class="caveat">A parish or town council precept adds to this Band D total where one applies. Before discounts.</p>
      <a class="bill-link" href="/precepts/">See the local breakdown and model each part</a>
    </aside>
  </section>
  <nav class="task-nav section" aria-label="Council tax tools">
    <a class="card" href="/precepts/"><span class="eyebrow">01 / Understand</span><strong>What makes up my bill</strong><span>National Band D components and parish charges, plus the complete Burnley schedule.</span></a>
    <a class="card" href="/increases/"><span class="eyebrow">02 / Track</span><strong>Council tax increases {year} by council</strong><span>Explore whole-area increases for every English council and band.</span></a>
    <a class="card" href="/tools/future-cost/"><span class="eyebrow">03 / Model</span><strong>What could council tax cost</strong><span>Change the assumptions and see annual and cumulative costs over time.</span></a>
    <a class="card" href="/compare/"><span class="eyebrow">04 / Compare</span><strong>How do areas compare?</strong><span>Compare the same band, year and council type, with sources alongside.</span></a>
  </nav>
  {area && (
    <section class="section" aria-labelledby="home-average">
      <h2 id="home-average">How much is council tax in England in {year}?</h2>
      <div class="fact-grid">
        <div class="card">
          <Fact
            label={`Average area Band D, England, ${year}`}
            figure={wholePounds(area.england.pounds)}
            change={`up ${percent(area.england.changePct)} on ${previous}`}
            source={councilTaxSource(CURRENT_YEAR, area.table)}
          ><p class="caveat">Includes adult social care and average parish precepts.</p></Fact>
        </div>
      </div>
      <p><a href="/council-tax/">Council tax for all {count} councils in England</a> · <a href={increasesYearPath(CURRENT_YEAR)}>How much each council raised its share</a></p>
    </section>
  )}

  {data.england.history && <section class="section" aria-labelledby="home-history">
    <h2 id="home-history">How the England average has changed</h2>
    <div data-fact class="fact">
      <BandDLine id="home-band-d-line" series={data.england.history.rows.map(r => ({year: r.year, value: r.pounds}))} format={(v) => wholePounds(v)} title={`Average area Band D in England, ${yearLabel(data.england.history.rows[0].year)} to ${year}`} basis="Average area Band D in England, including adult social care and average parish precepts" table={false} />
      <SourceLine source={councilTaxSource(CURRENT_YEAR, data.england.history.table)} />
      <p class="caveat">Cash figures, not adjusted for inflation. Includes adult social care and average parish precepts.</p>
      <a href="/council-tax/#history-heading">Read the complete history table</a>
    </div>
  </section>}
  <section class="editorial-callout section"><p class="eyebrow">More than a band lookup</p><h2>The bill you pay and the council share are different measures.</h2><p>Your bill can include county, district, police, fire, mayoral and parish charges. We keep the published area total separate from each council's own element, and show the source beside both.</p><a href="/precepts/">Understand the parts of your bill →</a></section>
  <section class="section" aria-labelledby="home-bands">
    <h2 id="home-bands">Council tax by band</h2>
    <ul class="pill-nav">
      {BANDS.map((band) => <li><a href={bandPath(band)}>Band {band}</a></li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="home-regions">
    <h2 id="home-regions">Council tax by region</h2>
    <ul class="pill-nav">
      {REGIONS.map((region) => <li><a href={regionPath(region)}>{region}</a></li>)}
    </ul>
  </section>
<section class="section"><h2>Council tax across the UK</h2><div class="task-nav"><a class="card" href="/scotland/"><strong>Scotland</strong><span>32 councils, bands A to H and three years of history.</span></a><a class="card" href="/wales/"><strong>Wales</strong><span>22 Band D averages and their components.</span></a><a class="card" href="/coverage/"><strong>UK coverage explained</strong><span>Understand the differences, including Northern Ireland domestic rates.</span></a></div></section>
</BaseLayout>

<style>
/* The hero: copy and both finders first, the bill drawing beside them from 900 px. */
.home-hero{display:grid;gap:var(--space-xl);align-items:start;padding:var(--space-xl) 0 var(--space-2xl);border-bottom:1px solid var(--border)}
@media(min-width:900px){.home-hero{grid-template-columns:minmax(0,1fr) minmax(0,30rem);gap:var(--space-2xl);padding-top:var(--space-2xl)}}
.hero-copy h1{font-size:clamp(2.3rem,1.6rem + 3vw,4rem);line-height:1.06;letter-spacing:-.01em;margin:var(--space-xs) 0 0}
.hero-copy .lede{font-size:var(--text-md);max-width:36rem;margin:var(--space-sm) 0 var(--space-lg)}
.hero-door{background:var(--accent-wash);border-radius:var(--radius);padding:var(--space-md);display:grid;gap:var(--space-xs);max-width:36rem}
.hero-door :global(.door-label),.hero-door :global(.field>span){font-weight:600;font-size:var(--text-base)}
.hero-door :global(.door-row){flex-wrap:wrap}
.hero-door :global(.door-row input){flex:1 1 9rem}
.hero-door :global(.door-row input),.hero-door :global(.field input){min-height:48px}
.hero-door :global(.door-row button){min-height:48px}
.hero-door :global(.door-status){min-height:0}
.hero-door :global(.door-status:empty){display:none}
.hero-door :global(.field){margin-bottom:0}
.door-or{font-size:var(--text-sm);color:var(--text-muted);margin:0}
.hero-coverage{font-size:var(--text-sm);color:var(--text-muted);margin:var(--space-md) 0 0}
.hero-nations{font-size:var(--text-sm);margin:var(--space-2xs) 0 0}
.bill-card{border:1px solid var(--border);border-top:4px solid var(--accent);border-radius:var(--radius);padding:var(--space-md);background:var(--bg-card);min-width:0}
.bill-card-head{display:flex;justify-content:space-between;gap:var(--space-sm);align-items:baseline;flex-wrap:wrap}
.bill-card h2{font-size:var(--text-lg);margin:var(--space-2xs) 0 var(--space-sm)}
.bill-card :global(.bill-figure){margin:0}
.bill-card .caveat{margin:var(--space-xs) 0 0}
.bill-link{display:inline-block;margin-top:var(--space-sm);font-weight:600}
.task-nav a{transition:transform .15s ease,border-color .15s ease}.task-nav a:hover{transform:translateY(-2px);border-color:var(--accent)}
@media(prefers-reduced-motion:reduce){.task-nav a{transition:none}.task-nav a:hover{transform:none}}
</style>
