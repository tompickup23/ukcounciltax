---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BandSelector from '../../../components/BandSelector.astro';
import DataDrawer from '../../../components/DataDrawer.astro';
import BudgetPublishedChart from '../../../components/BudgetPublishedChart.astro';
import {gameData} from '../../../lib/budget-game-data';
import {services} from '../../../lib/budget';
import BudgetTables from '../../../components/BudgetTables.astro';
import PerResident from '../../../components/PerResident.astro';
import BudgetBill from '../../../components/BudgetBill.astro';
import BudgetGame from '../../../components/BudgetGame.astro';
import SourceLine from '../../../components/SourceLine.astro';
import PageContents from '../../../components/PageContents.astro';
import {councilPages, type CouncilPage} from '../../../lib/paths';
import {budgetYear, budgetFor, budgetSource} from '../../../lib/budget';
export function getStaticPaths() {
  return councilPages().map(({council, tax}) => ({params: {slug: council.slug}, props: {council, tax}}));
}
interface Props extends CouncilPage {}
const {council, tax} = Astro.props;
const data = budgetFor(council.gss);
const available = data.council.status === 'available';
const game = available ? gameData(council.gss, council.slug, tax.name) : null;
const tableCount = [data.council, ...(data.county ? [data.county] : [])].reduce((sum, body) => sum + 4 + services(body).filter(row => row.value !== 0 && row.subLines.length).length, 0);
const title = available ? `${tax.name} budget game ${budgetYear}` : `${tax.name} budget ${budgetYear}: no return received`;
const description = available
  ? `Published ${budgetYear} budget for ${tax.name}: service spending, funding, reserves and the Band D bill split, from the MHCLG RA return.`
  : `No ${budgetYear} budget return for ${tax.name} was received in time for MHCLG's publication. The published Band D bill components are shown.`;
---
<BaseLayout title={title} description={description} path={`/tools/budget/${council.slug}/`}>
  <Breadcrumbs items={[{label: 'Tools', href: '/tools/'}, {label: 'Council budgets', href: '/tools/budget/'}, {label: tax.name}]} />
  {!available && <header class="page-head"><p class="eyebrow">Where the money goes | {budgetYear}</p><h1>{tax.name} budget</h1><p class="lede">The published budget, with service spending and council tax kept as separate measures.</p></header>}
  {available ? <>
    <BudgetGame gss={council.gss} slug={council.slug} name={tax.name} />
    <PageContents items={[{id: 'budget-game', label: 'Play the budget game'}, {id: 'council-budget', label: `${tax.name} budget`}, ...(data.county ? [{id: 'county-budget', label: `${data.county.name} County Council budget`}] : []), {id: 'your-bill', label: 'Your bill'}]} />
    <DataDrawer id="published-budget" title="The published budget" tableCount={tableCount + (game?.rounds.length ?? 0)}>
    {game?.rounds.map((round, index) => <BudgetPublishedChart round={round} index={index} slug={council.slug} location="published" />)}
    <BudgetTables council={data.council} name={tax.name} id="council-budget" />
    {data.county && <BudgetTables council={data.county} name={data.county.name} id="county-budget" county />}
    </DataDrawer>
  </> : <section class="section" data-no-budget-return><h2>No {budgetYear} budget return</h2><p>No {budgetYear} return for {tax.name} was received in time for MHCLG's publication on 11 June 2026. No budget game or earlier year's budget is shown. The bill breakdown below comes from the separate council tax return.</p><SourceLine source={budgetSource()} /></section>}
  <PerResident gss={council.gss} />
  <BudgetBill gss={council.gss} name={tax.name} />
  <section class="section" aria-labelledby="band-heading"><h2 id="band-heading">Published whole-bill charges by band</h2><p>Choose a band to read its published area average. The component breakdown above is available for Band D only; other bands' component charges are not inferred.</p><BandSelector ons={council.gss} authority={tax} showChange={false} /></section>
  <p><a href={`/councils/${council.slug}/`}>More council tax information for {tax.name}</a> · <a href="/tools/budget/">Choose another council</a></p>
</BaseLayout>
