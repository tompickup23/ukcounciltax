---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import BudgetModes from '../../../../components/BudgetModes.astro';
import raColumns from '../../../../../data/pilots/budget-freeze-columns.json';
import {budgetSetPages, budgetSetPath} from '../../../../lib/paths';
import { type FreezePilot } from '../../../../lib/budget-freeze-data';
import { FREEZE_YEAR, FREEZE_YEAR_TEXT, FREEZE_MODEL, FREEZE_ASSUMPTIONS, referendumExplanation, calculateFreeze, initialFreezeInputs, inputPounds, money } from '../../../../lib/budget-freeze';
import { referendumTriggerPence } from '../../../../scripts/budget-freeze';
import rules from '../../../../../data/pilots/budget-freeze-referendum.json';
import snapshot from '../../../../../data/pilots/budget-freeze.json';
import {pinnedBudgetLine} from '../../../../lib/budget-pin';
export function getStaticPaths() { return budgetSetPages().map(pilot => ({ params:{slug:pilot.slug}, props:{pilot} })); }
const {pilot} = Astro.props as {pilot:FreezePilot};
// C6: one line once the council tax pages have moved past this exercise's year.
const pinnedLine = pinnedBudgetLine(FREEZE_YEAR);
const initial = calculateFreeze(pilot, initialFreezeInputs(pilot));
const trigger = referendumTriggerPence(pilot);
const principle = rules.principles[pilot.rule];
const taxSource = pilot.sources[1];
const budgetSource = pilot.sources[0];
const baseText = (Number(pilot.taxBaseHundredths)/100).toLocaleString('en-GB',{maximumFractionDigits:2});
const cell = (key: keyof typeof pilot.evidence) => { const c = pilot.evidence[key]; return `${c.sheet}, ${c.column}${c.row}`; };
const raCell = (id: string) => `${pilot.evidence.raTotal.sheet}, ${raColumns[id as keyof typeof raColumns]}${pilot.evidence.raTotal.row}`;
const publishedMoney = (pence: string) => money(BigInt(pence)*100n);
// The same note printed in two MHCLG files is shown once, with both cells cited.
const notes = Object.values(pilot.reviewedNotes.reduce<Record<string, {text: string; explanation: string; citations: (typeof pilot.reviewedNotes)[number]['citation'][]}>>((groups, note) => {
  const key = `${note.text}\n${note.explanation}`;
  (groups[key] ??= {text: note.text, explanation: note.explanation, citations: []}).citations.push(note.citation);
  return groups;
}, {}));
---
<BaseLayout title={`Set ${pilot.name}'s budget ${FREEZE_YEAR_TEXT}`} description={`Set ${pilot.name}'s budget using the published ${FREEZE_YEAR_TEXT} ledger. Explore tax and spending with explicit assumptions.`} path={budgetSetPath(pilot.slug)} ephemeral ogImage={`/og/budget-set/${pilot.slug}.png`} ogImageAlt={`Set ${pilot.name}'s budget ${FREEZE_YEAR_TEXT}. An exploration, not a forecast.`}>
  <Breadcrumbs items={[{label:'Tools',href:'/tools/'},{label:'Council budgets',href:'/tools/budget/'},{label:pilot.name,href:`/tools/budget/${pilot.slug}/`},{label:'Set the budget'}]} />
  <div class="budget-set" data-freeze-pilot data-pilot={JSON.stringify(pilot)}>
      <BudgetModes gss={pilot.gss} slug={pilot.slug} current="set" />

      <header class="page-head">
        <div><p class="eyebrow"> {FREEZE_YEAR_TEXT} · User requested scenario | {FREEZE_MODEL}</p>
        <h1>Set {pilot.name}'s budget</h1>
        <p class="lede">Choose a charge. Adjust services. See the difference.</p></div>
        <button class="theme-icon" type="button" data-theme-toggle hidden aria-label="Change colour theme" title="Change colour theme"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16a8 8 0 0 0 0-16Z" fill="currentColor"/></svg></button>
      </header>
      {pinnedLine && <p class="source-line" data-budget-pinned>{pinnedLine}</p>}
      <section class="scenario-result" aria-labelledby="result-title">
        <h2 id="result-title" class="sr-only">Your scenario result</h2>
        <div class="result-board">
          <div data-result-status><h3>The remaining difference</h3><strong class="result-amount" data-remaining>{money(initial.remaining)}</strong><p class="source-line">Spending change minus financing change.</p></div>
          <dl data-result-details><div><dt>Net spending change</dt><dd><strong data-spending>{money(initial.spendingChange)}</strong><p class="source-line">Your services minus published services.</p></dd></div><div><dt>Own-tax financing change</dt><dd><strong data-financing>{money(initial.financingChange)}</strong><p class="source-line">Charge change × fixed tax base.</p></dd></div></dl>
        </div>
        <p data-state>{initial.status === 'balanced' ? 'The arithmetic balances under these assumptions.' : initial.status === 'shortfall' ? 'Shortfall under these assumptions.' : 'Surplus under these assumptions.'}</p>
        <p class="source-line baseline">Published own Band D: <a href={pilot.sources[2].url}>{publishedMoney(pilot.priorOwnPence)} prior</a>; <a href={taxSource.url}>{publishedMoney(pilot.ownPence)} current</a>. Fixed base: <a href={pilot.sources[3].url}>{baseText} Band D equivalents</a>. MHCLG Tables 8 and 10. Own-council share only, excluding parish precepts.</p>
        <p data-error role="alert" hidden></p>
        <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-announcement></p>
      </section>
      <noscript><p class="notice">The scenario controls need JavaScript. The published baseline, assumptions, ledger and freeze calculation remain available. Open the disclosures to read them.</p></noscript>
      <section class="controls" data-controls hidden aria-labelledby="controls-title">
        <h2 id="controls-title" class="sr-only">Your choices</h2>
        <div class="presets">
          <p class="preset-prompt">User requested scenarios | {FREEZE_MODEL}{pilot.ownPence === pilot.priorOwnPence && ". Charge frozen."} <a href="#preset-note">Assumptions</a></p>
          <div class="actions">{trigger !== null && <button type="button" data-trigger-preset aria-describedby="preset-note">Raise to the referendum trigger</button>}<button type="button" data-service-preset aria-describedby="preset-note">Reduce editable services by 5%</button></div>

        </div>
        <div class="control-card tax-control">
          <div class="card-heading"><h3>Own-council Band D</h3><strong data-own-value>{publishedMoney(pilot.priorOwnPence)}</strong></div>
          <label for="own">Your annual charge, pounds</label>
          <input id="own" data-own type="number" min="0" max={inputPounds(BigInt(pilot.ownPence)*2n)} step="0.01" value={inputPounds(pilot.priorOwnPence)} aria-describedby="tax-note control-limits" />
          <div class="tax-track"><input data-own-range type="range" min="0" max={inputPounds(BigInt(pilot.ownPence)*2n)} step="0.01" value={inputPounds(pilot.priorOwnPence)} list="tax-marks" aria-label="Own-council Band D slider, pounds" aria-valuetext={publishedMoney(pilot.priorOwnPence)} /><datalist id="tax-marks"><option value={inputPounds(pilot.ownPence)} label="Published charge"/>{trigger !== null && <option value={inputPounds(trigger)} label="Referendum trigger"/>}</datalist>
          <div class="tax-ticks" aria-hidden="true"><span class="published-tick" title="Published charge"></span>{trigger !== null && <span class="trigger-tick" style={`left:${Number(trigger)*100/Number(BigInt(pilot.ownPence)*2n)}%`} title="Referendum trigger"></span>}</div></div>
          <p class="source-line">Published mark: {publishedMoney(pilot.ownPence)}. MHCLG, <a href={taxSource.url}>{taxSource.title}</a>, {cell('annualCurrent')}; Table 10 {cell('table10Current')}.</p>
          {trigger !== null ? <p class="source-line" data-trigger-source>Trigger mark: {publishedMoney(String(trigger))}, the first whole penny satisfying the mapped rule from the prior charge. {rules.source.publisher}, <a href={principle.citation.url}>{rules.source.title}</a>, {rules.source.published}, Annex {principle.citation.annex}, paragraph {principle.citation.paragraph}, page {principle.citation.page}.</p> : <p>No official referendum limit is held for this council. No trigger mark or trigger preset is available.</p>}
          <p data-rule-result></p>
          <details><summary>Tax assumptions and source</summary><p id="tax-note">{referendumExplanation(pilot.rule)} This is a trigger, not a hard cap. The exercise does not assess the process for a higher charge or compliance with spending duties.</p><p class="source-line">MHCLG, <a href={pilot.sources[4].url}>{pilot.sources[4].title}</a>.</p></details>
        </div>
        <div class="service-heading"><h3>Net service spending</h3><p id="control-limits">Explore zero to twice each published amount. Service sliders and steppers move by 0.5% of the published figure; exact entries remain in pounds. Changes imply no service outcomes or achievable savings.</p></div>
        <div class="service-grid">{pilot.services.filter(s=>s.editable).map(service => <div class="control-card service-card">
          <h4>{service.label}</h4>
          <div class="service-value"><strong data-service-value={service.id}>{publishedMoney(service.pence)}</strong><span class="change-chip" data-service-delta={service.id}>£0.00 change</span></div>
          <div class="range-row"><button type="button" data-service-step={service.id} data-step="-1" aria-label={`Reduce ${service.label} by 0.5% of published spending`}>−</button><input data-service-range={service.id} data-percentage type="range" min="0" max="200" step="0.5" value="100" list={`marks-${service.id}`} aria-label={`${service.label} slider, pounds`} aria-valuetext={publishedMoney(service.pence)} aria-describedby={`basis-${service.id}`} /><button type="button" data-service-step={service.id} data-step="1" aria-label={`Increase ${service.label} by 0.5% of published spending`}>+</button></div>
          <datalist id={`marks-${service.id}`}><option value="100" label="Published spending"/></datalist>
          <p class="published-marker" id={`basis-${service.id}`}>Published tick: {publishedMoney(service.pence)} <a href={budgetSource.url}>MHCLG RA, {raCell(service.id)}</a></p>
          <div class="percentage-chips" role="group" aria-label={`${service.label} choices relative to published spending`}>{[90,95,100,105,110].map(percent => <button type="button" data-service-percent={service.id} data-percent={percent}>{percent === 100 ? 'Published' : `${percent>100?'+':'−'}${Math.abs(percent-100)}%`}</button>)}</div>
          <details><summary>Exact pounds and source</summary><label for={`service-${service.id}`}>Your net spending, pounds</label><input id={`service-${service.id}`} data-service={service.id} type="number" min="0" max={inputPounds(BigInt(service.pence)*2n)} step="0.01" value={inputPounds(service.pence)} aria-describedby="control-limits" /><p class="source-line">User requested scenario. Change is your amount minus the published reference: {publishedMoney(service.pence)}. MHCLG, <a href={budgetSource.url}>RA Part 1, {FREEZE_YEAR_TEXT}, {raCell(service.id)}, line {service.line}</a>. Percentage choices are relative to that reference, rounded to the nearest penny.</p></details>
        </div>)}</div>
        <div class="actions reset-actions"><button type="button" data-freeze-reset>Start again with a freeze</button><button type="button" data-published-reset>Restore published baseline</button></div>
      </section>
      <details class="assumptions"><summary>How this exercise works <span>Fixed tax base, grants and reserves. An exercise, not an actual deficit.</span></summary>
          <details class="preset-assumptions"><summary>Preset assumptions</summary><p class="source-line" id="preset-note" data-preset-note>Presets restore published services first. Trigger: change the own charge to the first penny requiring a referendum. Services: keep the previous own charge and use 95% of each editable published service. Tax base and all held entries stay fixed.</p></details>
        <p>User requested scenario | {FREEZE_MODEL}. Starts at the previous own charge with current published services. A shortfall needs additional financing or lower net spending; a surplus has financing above spending. Arithmetic balance does not establish a deliverable or legally compliant budget.</p>
        <ul>{FREEZE_ASSUMPTIONS.map(text => <li>{text}</li>)}</ul>
        {pilot.grantDsgThousands > 0 && <p>Dedicated Schools Grant is included in the published education and financing figures. Education stays fixed here. Reserve accounting also varies with High Needs Stability Grant treatment; reserves are not a spending control. Source: MHCLG RA and specific grants, notes 1, 2 and 6.</p>}
        <p>Money is displayed to pennies. The calculation keeps four decimal places and tests for an exact zero before rounding. A zero difference means the arithmetic balances under the stated assumptions.</p>
        <p class="source-line">Freeze starting calculation: ({publishedMoney(pilot.ownPence)} minus {publishedMoney(pilot.priorOwnPence)}) × {baseText}. Financing change is your charge minus the published current charge, multiplied by the fixed tax base.</p>
              <section class="baseline" aria-labelledby="baseline-title">
        <h2 id="baseline-title">The published starting point</h2>
        <div class="baseline-grid">
          <div><p class="fact-label">Own Band D, {`${Number(FREEZE_YEAR.slice(0,4))-1}/${FREEZE_YEAR.slice(2,4)}`}</p><strong>{publishedMoney(pilot.priorOwnPence)}</strong><p class="source-line">MHCLG, <a href={pilot.sources[2].url}>{pilot.sources[2].title}</a>, {cell('annualPrior')}; Table 10 {cell('table10Prior')}.</p></div>
          <div><p class="fact-label">Own Band D, {FREEZE_YEAR_TEXT}</p><strong>{publishedMoney(pilot.ownPence)}</strong><p class="source-line">MHCLG, <a href={taxSource.url}>{taxSource.title}</a>, {cell('annualCurrent')}; Table 10 {cell('table10Current')}.</p></div>
          <div><p class="fact-label">Fixed tax base, {FREEZE_YEAR_TEXT}</p><strong>{baseText}</strong><p class="source-line">Band D equivalents. MHCLG, <a href={pilot.sources[3].url}>Table 10, {cell('table10Base')}</a>.</p></div>
        </div>
        <p>These are this council's own charges excluding parish precepts, not the full household bill.{pilot.rule === 'district' && ' County council, police, fire and parish charges are outside this exercise.'}</p>
      </section>

        <section class="referendum-rule" aria-labelledby="rule-title"><h2 id="rule-title">The referendum rule</h2><p>{referendumExplanation(pilot.rule)} A referendum would be required when this trigger is reached. It is not a cap.</p><p class="source-line">{rules.source.publisher}, <a href={rules.source.url}>{rules.source.title}</a>, published {rules.source.published}. {pilot.ruleLocation}.</p></section>
      </details>
      <section class="section ledger" aria-labelledby="ledger-title">
        <h2 id="ledger-title">The published ledger stays unchanged</h2>
        <p>All service groups, including net income and published zeros, remain in the reference below. The rows after total service expenditure show revenue expenditure and its signed financing entries; they are not additional service totals.</p>
        <p class="source-line">MHCLG, <a href={budgetSource.url}>{budgetSource.title}</a>. Published unit: £ thousand. Display below preserves that unit.</p>
        <details><summary>Read the signed ledger and held service groups</summary>
          <div class="table-wrap"><table class="data"><caption>{pilot.name}, published RA {FREEZE_YEAR_TEXT}, £ thousand</caption><thead><tr><th scope="col">RA line</th><th scope="col">Item</th><th scope="col">Published</th><th scope="col">Treatment and source</th></tr></thead><tbody>{pilot.ledger.map(row=><tr><td data-label="RA line">{row.line}</td><th scope="row">{row.label}</th><td data-label="Published £ thousand">{row.thousands.toLocaleString('en-GB')}</td><td data-label="Treatment and source">{pilot.services.find(s=>s.id===row.id)?.heldReason ?? (pilot.services.find(s=>s.id===row.id)?.editable ? 'Scenario control above' : ['servicetot','revenuetot','ctrtot'].includes(row.id) ? 'Published reference total, not an additional control' : 'Held fixed because financing and non-service adjustments are not modelled')}<span class="source-line">RA Part 1, {raCell(row.id)}</span></td></tr>)}</tbody></table></div>
        </details>
        <details id="reconciliation"><summary>Source reconciliation and precision</summary>
          <p>The signed RA financing identity and service totals reconcile. The RA council-tax requirement is printed in thousands; Table 10 prints whole pounds. Their difference is {publishedMoney(pilot.reconciliation.raTotalDifferencePence)}, within half a printed thousand. Compatibility with that precision does not prove why the sources differ. This difference is kept separate from the scenario and is not a deficit.</p>
          <p>Table 10, Data_Billing: total ({pilot.evidence.table10Total.column}{pilot.evidence.table10Total.row}) including parish: {publishedMoney(pilot.reconciliation.table10TotalPence)}; own requirement ({pilot.evidence.table10Own.column}{pilot.evidence.table10Own.row}): {publishedMoney(pilot.reconciliation.table10OwnPence)}; parish requirement ({pilot.evidence.table10Parish.column}{pilot.evidence.table10Parish.row}): {publishedMoney(pilot.reconciliation.table10ParishPence)}.</p>
          {pilot.reconciliation.table10IdentityDifferencePence !== '0' && <p>Table 10 total minus its printed own and parish amounts is {publishedMoney(pilot.reconciliation.table10IdentityDifferencePence)}. Each is printed in whole pounds; this difference is compatible with that precision. All three printed figures remain unchanged.</p>}
          <p>The printed own Band D multiplied by the tax base differs from the published own requirement by {money(BigInt(pilot.reconciliation.ownYieldDifferenceUnits))}. Printed Band D is rounded to pennies. The model calculates changes from the published baseline; it does not replace the published requirement with this product.</p>
          <p>The RA total less its parish line, minus the Table 10 own requirement, is {publishedMoney(pilot.reconciliation.ownDifferencePence)}. This derived component is within the sum of the two half thousand pound bounds plus half a pound for its whole pound printing.</p>
          <p>The RA parish line minus the Table 10 parish requirement is {publishedMoney(pilot.reconciliation.parishDifferencePence)}. This is within half a printed thousand.</p>
          <p class="source-line">MHCLG, <a href={pilot.sources[3].url}>Table 10, Data_Billing, items 1, 2, 3, 7 and 9</a>, and <a href={budgetSource.url}>RA Part 1, {cell('raParish')} and {cell('raTotal')}, lines 821 and 990</a>.</p>
        </details>
      </section>
      {notes.length > 0 && <section class="section"><details><summary>Reviewed source notes</summary><ul>{notes.map(note=><li><p>{note.text}</p><p>{note.explanation}</p><p class="source-line">{note.citations.map(c=>`${c.file}, ${c.sheet}, ${c.column}${c.row}`).join('; ')}.</p></li>)}</ul></details></section>}
      <section class="section"><details><summary>Sources and next steps</summary><ul>{pilot.sources.map(source=><li><a href={source.url}>{source.title}</a></li>)}</ul><p>Sources checked on {snapshot.reviewedOn}. This exercise is not a consultation and sends no choices to a council. No storage, saved choices, scenario network requests or analytics events. Choices reset on reload.</p><p><a href={`/tools/budget/${pilot.slug}/`}>Open the published budget game</a> | <a href="/tools/budget/">Choose another council</a></p></details></section>
      <div class="mobile-result" data-mobile-result hidden aria-hidden="true"><span>User requested scenario</span><strong data-mobile-amount></strong><span data-mobile-state></span></div>
  </div>
  <script src="../../../../scripts/budget-freeze.ts"></script>
</BaseLayout>
<style>
  .budget-set{--card-pad:1rem;font-variant-numeric:tabular-nums}.eyebrow{font-size:var(--text-sm);color:var(--text-muted);margin:0}.page-head{margin-bottom:0;display:flex;align-items:start;justify-content:space-between;gap:.5rem;padding-block:.25rem .75rem}.page-head h1{font-size:clamp(2rem,4vw,3rem);line-height:1.08;margin:.3rem 0}.lede{margin:0}.theme-icon{flex:none;display:grid;place-items:center;width:44px;padding:0}
  .scenario-result{border:1px solid var(--border);border-top:4px solid var(--accent);background:var(--bg-card);border-radius:.6rem;padding:.85rem 1rem}.result-board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.result-board dl{display:contents}.result-board h3,.result-board dt{font:600 .95rem var(--font-sans);margin:0}.result-board strong,.result-board dd{display:block;font-size:clamp(1.1rem,2.4vw,1.9rem);font-weight:600;margin:.25rem 0;overflow-wrap:anywhere}.result-board .source-line{margin:0}.scenario-result [data-state]{margin:.6rem 0;font-size:.9rem}.baseline{margin:.4rem 0 0}.source-line{overflow-wrap:anywhere;font-size:.8rem;line-height:1.4}.assumptions{border-bottom:1px solid var(--border);padding:.25rem 0;margin:.5rem 0}.assumptions summary span{font-weight:400;font-size:.85rem;margin-left:.5rem}.assumptions .baseline-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.assumptions li{margin-block:.3rem}.assumptions .baseline{margin-block:1rem}
  .control-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem}.control-heading h2{font-size:1.4rem;margin:.5rem 0}.control-heading a{font-size:.85rem}.presets{padding:.65rem .8rem;background:var(--accent-wash);border:1px solid var(--border);border-radius:.6rem;margin:.4rem 0 .8rem}.presets p{margin:0 0 .45rem;font-size:.9rem}.presets p span{font-size:.8rem}.presets .source-line{font-size:.75rem;margin:.5rem 0 0}.actions{display:flex;flex-wrap:wrap;gap:.5rem}.control-card{padding:var(--card-pad);border:1px solid var(--border);border-radius:.6rem;background:var(--bg-card);min-width:0}.card-heading{display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem 1rem;justify-content:space-between}.card-heading h3,.control-card h4{margin:0;font-size:1.1rem}.card-heading strong,.service-value strong{font-size:1.45rem}.tax-control{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:1.5rem}.tax-control .card-heading,.tax-control>p,.tax-control>details{grid-column:1/-1}.tax-control label{grid-column:1}.tax-control input[type=number]{grid-column:1;grid-row:3}.tax-track{grid-column:2;grid-row:3;position:relative}.tax-ticks{position:absolute;left:8px;right:8px;bottom:0;height:8px;pointer-events:none}.tax-ticks span{position:absolute;height:8px;border-left:2px solid var(--text)}.published-tick{left:50%}.trigger-tick{top:8px;border-color:var(--accent)!important}.tax-control>p{margin:.65rem 0 0}.tax-control details{margin-top:.4rem}.tax-control label{font-size:.85rem}
  .service-heading h3{margin:1rem 0 .3rem}.service-heading p{font-size:.85rem;margin:0 0 .8rem}.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.service-card h4{min-height:2.6em}.service-value{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:.25rem}.change-chip{font-size:.75rem;border:1px solid var(--border);border-radius:1rem;padding:.1rem .5rem;background:var(--bg-subtle)}.range-row{display:grid;grid-template-columns:44px minmax(0,1fr) 44px;align-items:center;gap:.3rem}.range-row button{font-size:1.3rem;padding:0}.published-marker{font-size:.75rem;line-height:1.3;margin:.1rem 0 .5rem;text-align:center}.published-marker::before{content:'';display:block;border-left:2px solid var(--text);height:6px;width:0;margin:0 auto .2rem}.percentage-chips{display:flex;gap:.2rem;flex-wrap:wrap}.percentage-chips button{font-size:.8rem;flex:1;padding:.2rem}.service-card details{margin-top:.3rem}.service-card summary{font-size:.85rem}.service-card label{display:block;font-size:.85rem;margin:.3rem 0}
  input[type=number]{font:inherit;width:100%;min-height:44px;padding:.4rem .6rem;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:.3rem;box-sizing:border-box;min-width:0}input[type=range]{width:100%;min-width:0;min-height:44px;accent-color:var(--accent);margin:0}button{min-height:44px;min-width:44px;padding:.5rem .75rem;border:1px solid var(--border);border-radius:.35rem;background:var(--bg-subtle);color:var(--text);font:inherit;cursor:pointer}button:hover{border-color:var(--accent)}button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.reset-actions{margin-block:1rem}summary{cursor:pointer;min-height:44px;align-content:center;font-weight:600}.section{margin-block:1rem}.ledger h2{font-size:1.4rem;margin-bottom:.4rem}.ledger>p{font-size:.85rem;margin:.4rem 0}.ledger details{margin:.3rem 0}.ledger .source-line{display:block}.table-wrap{overflow:visible;max-height:none}table{min-width:0;width:100%;table-layout:fixed}th,td{white-space:normal;overflow-wrap:anywhere}th:first-child,td:first-child{width:4rem}[data-error]{border-inline-start:4px solid var(--accent);padding:.5rem}[hidden]{display:none!important}.mobile-result{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}input,button,summary{scroll-margin-block:8rem}
