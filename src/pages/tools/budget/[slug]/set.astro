---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import BudgetModes from '../../../../components/BudgetModes.astro';
import DeskBand from '../../../../components/DeskBand.astro';
import RecordLine from '../../../../components/RecordLine.astro';
import PageSources, {type SourceEntry} from '../../../../components/PageSources.astro';
import raColumns from '../../../../../data/pilots/budget-freeze-columns.json';
import {budgetSetPages, budgetSetPath} from '../../../../lib/paths';
import { type FreezePilot } from '../../../../lib/budget-freeze-data';
import { FREEZE_YEAR, FREEZE_YEAR_TEXT, FREEZE_MODEL, FREEZE_ASSUMPTIONS, referendumExplanation, calculateFreeze, initialFreezeInputs, inputPounds, money } from '../../../../lib/budget-freeze';
import { referendumTriggerPence, boardMoney, stateWord, stateSentence, gapScale, gapShare } from '../../../../scripts/budget-freeze';
import { formatMoney } from '../../../../lib/money';
import { gameNeighbours } from '../../../../lib/game-neighbours';
import { CURRENT_YEAR } from '../../../../lib/council-tax';
import { longDate, type SourceRef } from '../../../../lib/sources';
import rules from '../../../../../data/pilots/budget-freeze-referendum.json';
import snapshot from '../../../../../data/pilots/budget-freeze.json';
import {pinnedBudgetLine} from '../../../../lib/budget-pin';
export function getStaticPaths() { return budgetSetPages().map(pilot => ({ params:{slug:pilot.slug}, props:{pilot} })); }
const {pilot} = Astro.props as {pilot:FreezePilot};
// C6: one line once the council tax pages have moved past this exercise's year.
const pinnedLine = pinnedBudgetLine(FREEZE_YEAR);
const initial = calculateFreeze(pilot, initialFreezeInputs(pilot));
const trigger = referendumTriggerPence(pilot);
const principle = rules.principles[pilot.rule];
const taxSource = pilot.sources[1];
const budgetSource = pilot.sources[0];
const baseText = (Number(pilot.taxBaseHundredths)/100).toLocaleString('en-GB',{maximumFractionDigits:2});
const cell = (key: keyof typeof pilot.evidence) => { const c = pilot.evidence[key]; return `${c.sheet}, ${c.column}${c.row}`; };
const raCell = (id: string) => `${pilot.evidence.raTotal.sheet}, ${raColumns[id as keyof typeof raColumns]}${pilot.evidence.raTotal.row}`;
const publishedMoney = (pence: string) => money(BigInt(pence)*100n);
// RA returns publish £ thousand: the card prints £ million to one decimal and the
// disclosure prints the exact published pounds, never pennies the return does not hold.
const serviceCompact = (pence: string) => formatMoney(Number(pence), {unit:'pence', style:'compact'});
const serviceExact = (pence: string) => formatMoney(Number(BigInt(pence)/100000n), {unit:'thousands'});
const scale = gapScale(pilot);
const initialSide = initial.remaining === 0n ? 'none' : initial.remaining > 0n ? 'shortfall' : 'surplus';
const initialGap = `--gap:${gapShare(initial.remaining, scale) / 2}%`;
// The same note printed in two MHCLG files is shown once, with both cells cited.
const notes = Object.values(pilot.reviewedNotes.reduce<Record<string, {text: string; explanation: string; citations: (typeof pilot.reviewedNotes)[number]['citation'][]}>>((groups, note) => {
  const key = `${note.text}\n${note.explanation}`;
  (groups[key] ??= {text: note.text, explanation: note.explanation, citations: []}).citations.push(note.citation);
  return groups;
}, {}));

// Record lines (F1): publisher and a short title built from the data's own title and year.
const yearIn = (title: string) => /\d{4}\/\d{2}/.exec(title)?.[0] ?? FREEZE_YEAR_TEXT;
const mhclg = (source: {title: string; url: string}, short?: string): SourceRef => ({publisher:'MHCLG', title:source.title, url:source.url, short: short ?? `${source.title.split(',')[0]}, ${yearIn(source.title)}`});
const raRef = mhclg(budgetSource, `${budgetSource.title.split(',')[0]}, ${FREEZE_YEAR_TEXT}`);
const currentRef = mhclg(taxSource);
const priorRef = mhclg(pilot.sources[2]);
const table10Ref = mhclg(pilot.sources[3]);
const rulesRef: SourceRef = {publisher:rules.source.publisher, title:rules.source.title, url:principle.citation.url, date:rules.source.published, table:pilot.ruleLocation, short:`Referendum principles, ${FREEZE_YEAR_TEXT}`};
const checked = `Sources checked on ${longDate(snapshot.reviewedOn)}.`;
const entries: SourceEntry[] = [
  {key:'set-band-d', label:'Own Band D charges and the fixed tax base', method:'Own-council Band D excluding parish precepts, checked against Table 10; the tax base is in Band D equivalents, not households', sources:[priorRef, currentRef, table10Ref], note:checked},
  {key:'set-services', label:'Net service spending and the published ledger', method:'Published in £ thousand. Cards show £ million to one decimal; each card gives the exact published pounds and its cell', sources:[raRef], note:checked},
  {key:'set-referendum', label:'The rise that would need a referendum', method:'The smallest whole penny charge that meets the rule from the previous own charge', sources:[rulesRef], note:checked},
];
// The copied scenario names each source in full.
const copiedSources = [...pilot.sources.map(s => `MHCLG, ${s.title}, ${s.url}`), `${rules.source.publisher}, ${rules.source.title}, ${rules.source.url}`];

// What next: neighbours with their own set page, by name. Names only, never a figure.
const eligible = new Set(budgetSetPages().map(p => p.slug));
const near = gameNeighbours(pilot.gss);
const neighbours = near.neighbours.filter(n => eligible.has(n.slug)).sort((a, b) => a.name.localeCompare(b.name, 'en-GB')).slice(0, 4);
---
<BaseLayout title={`Set ${pilot.name}'s budget ${FREEZE_YEAR_TEXT}`} description={`Set ${pilot.name}'s budget using the published ${FREEZE_YEAR_TEXT} ledger. Explore tax and spending with explicit assumptions.`} path={budgetSetPath(pilot.slug)} ephemeral ogImage={`/og/budget-set/${pilot.slug}.png`} ogImageAlt={`Set ${pilot.name}'s budget ${FREEZE_YEAR_TEXT}. An exploration, not a forecast.`}>
  <Breadcrumbs items={[{label:'Tools',href:'/tools/'},{label:'Council budgets',href:'/tools/budget/'},{label:pilot.name,href:`/tools/budget/${pilot.slug}/`},{label:'Set the budget'}]} />
  <div class="budget-set" data-freeze-pilot data-pilot={JSON.stringify(pilot)} data-sources={JSON.stringify(copiedSources)} data-status={initial.status}>
      <div class="set-top">
        <BudgetModes gss={pilot.gss} slug={pilot.slug} current="set" />
        <button class="theme-icon" type="button" data-theme-toggle hidden aria-label="Change colour theme" title="Change colour theme"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16a8 8 0 0 0 0-16Z" fill="currentColor"/></svg></button>
      </div>
      {pinnedLine && <p class="source-line" data-budget-pinned>{pinnedLine}</p>}
      <noscript><p class="notice">The scenario controls need JavaScript. The published baseline, assumptions, ledger and freeze calculation remain available. Open the disclosures to read them.</p></noscript>
      <div class="set-layout">
      <DeskBand id="set-heading" level={1} top layout="stack" class="set-desk" data-scenario-board
        eyebrow={`${FREEZE_YEAR_TEXT} | User requested scenario | ${FREEZE_MODEL}`}
        title={`Set ${pilot.name}'s budget`}
        lede="Choose a charge. Adjust services. See the difference.">
        <div class="scenario-result">
          <div class="result-board">
            <div data-result-status>
              <h2 class="board-label" id="result-title">The remaining difference</h2>
              <strong class="result-amount" data-remaining>{boardMoney(initial.remaining)}</strong>
              <p class="state-row"><span class="state-word" data-state-word>{stateWord(initial.status)}</span> <span data-state>{stateSentence(initial.status)}</span></p>
              <div class="gap" aria-hidden="true">
                <div class="gap-bar" data-gap-bar data-side={initialSide} style={initialGap}><span class="gap-fill"></span><span class="gap-target"></span></div>
                <div class="gap-scale"><span>Surplus</span><span>Balanced</span><span>Shortfall</span></div>
              </div>
              <p class="stamp" data-stamp hidden={initial.status !== 'balanced'}>Spending and financing match</p>
              <p class="source-line">Spending change minus financing change.</p>
            </div>
            <dl data-result-details><div><dt>Net spending change</dt><dd><strong data-spending>{boardMoney(initial.spendingChange)}</strong><p class="source-line">Your services minus published services.</p></dd></div><div><dt>Own-tax financing change</dt><dd><strong data-financing>{boardMoney(initial.financingChange)}</strong><p class="source-line">Charge change × fixed tax base.</p></dd></div></dl>
            <details class="board-exact" data-result-exact><summary>Exact pounds</summary>
              <dl><div><dt>Remaining difference</dt><dd data-remaining-exact>{money(initial.remaining)}</dd></div><div><dt>Net spending change</dt><dd data-spending-exact>{money(initial.spendingChange)}</dd></div><div><dt>Own-tax financing change</dt><dd data-financing-exact>{money(initial.financingChange)}</dd></div></dl>
              <p class="source-line">The calculation keeps four decimal places and tests for an exact zero before rounding to pennies.</p>
            </details>
            <div class="copy-row"><button type="button" class="copy-button" data-copy hidden>Copy your scenario</button><p class="copy-status" role="status" data-copy-status></p></div>
          </div>
          <div class="desk-baseline"><p class="baseline">Published own Band D: {publishedMoney(pilot.priorOwnPence)} for {yearIn(pilot.sources[2].title)}, {publishedMoney(pilot.ownPence)} for {FREEZE_YEAR_TEXT}. Fixed tax base: {baseText} Band D equivalents. Own-council share only, excluding parish precepts.</p>
          <RecordLine entry="set-band-d" sources={[priorRef, currentRef, table10Ref]} /></div>
          <p data-error role="alert" hidden></p>
          <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-announcement></p>
        </div>
      </DeskBand>
      <section class="controls" data-controls hidden aria-labelledby="controls-title">
        <h2 id="controls-title" class="sr-only">Your choices</h2>
        <div class="presets">
          <p class="preset-prompt">Starting points{pilot.ownPence === pilot.priorOwnPence && ', charge frozen'}. <a href="#preset-note">Assumptions</a></p>
          <div class="actions">{trigger !== null && <button type="button" data-trigger-preset aria-describedby="preset-note">Try the rise that would need a referendum</button>}<button type="button" data-service-preset aria-describedby="preset-note">Reduce editable services by 5%</button></div>
        </div>
        <div class="control-card tax-control">
          <div class="tax-head">
            <div><h3>Own-council Band D</h3><strong class="tax-value" data-own-value>{publishedMoney(pilot.priorOwnPence)}</strong></div>
          <div class="tax-track"><input data-own-range type="range" min="0" max={inputPounds(BigInt(pilot.ownPence)*2n)} step="0.01" value={inputPounds(pilot.priorOwnPence)} list="tax-marks" aria-label="Own-council Band D slider, pounds" aria-valuetext={publishedMoney(pilot.priorOwnPence)} /><datalist id="tax-marks"><option value={inputPounds(pilot.ownPence)} label="Published charge"/>{trigger !== null && <option value={inputPounds(trigger)} label="The rise that would need a referendum"/>}</datalist>
          <div class="tax-ticks" aria-hidden="true"><span class="published-tick" title="Published charge"></span>{trigger !== null && <span class="trigger-tick" style={`left:${Number(trigger)*100/Number(BigInt(pilot.ownPence)*2n)}%`} title="The rise that would need a referendum"></span>}</div></div>
            <div class="tax-entry"><label for="own">Your annual charge, pounds</label>
            <input id="own" data-own type="number" min="0" max={inputPounds(BigInt(pilot.ownPence)*2n)} step="0.01" value={inputPounds(pilot.priorOwnPence)} aria-describedby="tax-note control-limits" /></div>
          </div>
          <div class="tax-row"><p class="tax-marks"><span><span class="key key-published" aria-hidden="true"></span>Published charge {publishedMoney(pilot.ownPence)}</span>{trigger !== null ? <span data-trigger-mark><span class="key key-trigger" aria-hidden="true"></span>The rise that would need a referendum: {publishedMoney(String(trigger))}</span> : <span>No official referendum limit is held for this council. No referendum mark or preset is available.</span>}</p><details class="tax-assumptions"><summary>Tax assumptions</summary><p id="tax-note">{referendumExplanation(pilot.rule)} This is the point a referendum is needed, not a hard cap. The exercise does not assess the process for a higher charge or compliance with spending duties.</p></details></div>
          <p class="rule-result" data-rule-result></p>
          <RecordLine entry="set-band-d" sources={[currentRef]} tail={`${cell('annualCurrent')}; Table 10 ${cell('table10Current')}`} />
          {trigger !== null && <div data-trigger-source><RecordLine entry="set-referendum" method="Referendum mark: the first whole penny that meets the rule" sources={[rulesRef]} /></div>}
        </div>
        <div class="service-heading"><h3>Net service spending</h3><p id="control-limits">Zero to twice each published amount, in steps of 0.5%; exact entries in pounds. Changes imply no service outcomes or achievable savings.</p>
          <RecordLine entry="set-services" sources={[raRef]} tail="each card gives its cell" />
        </div>
        <div class:list={["service-grid", {"service-grid--three": pilot.services.filter(s=>s.editable).length > 8}]}>{pilot.services.filter(s=>s.editable).map(service => <div class="control-card service-card">
          <div class="service-top">
            <h4>{service.label}</h4>
            <strong class="service-amount" data-service-value={service.id}>{serviceCompact(service.pence)}</strong>
            <p class="published-marker" id={`basis-${service.id}`}>Published {serviceCompact(service.pence)}</p>
            <span class="change-chip" data-service-delta={service.id}>No change</span>
          </div>
          <div class="range-row"><button type="button" data-service-step={service.id} data-step="-1" aria-label={`Reduce ${service.label} by 0.5% of published spending`}>−</button><input data-service-range={service.id} data-percentage type="range" min="0" max="200" step="0.5" value="100" list={`marks-${service.id}`} aria-label={`${service.label} slider, pounds`} aria-valuetext={publishedMoney(service.pence)} aria-describedby={`basis-${service.id}`} /><button type="button" data-service-step={service.id} data-step="1" aria-label={`Increase ${service.label} by 0.5% of published spending`}>+</button></div>
          <datalist id={`marks-${service.id}`}><option value="100" label="Published spending"/></datalist>
          <div class="chip-row"><div class="percentage-chips" role="group" aria-label={`${service.label} choices relative to published spending`}>{[90,95,100,105,110].map(percent => <button type="button" data-service-percent={service.id} data-percent={percent}>{percent === 100 ? 'Published' : `${percent>100?'+':'−'}${Math.abs(percent-100)}%`}</button>)}</div>
          <details class="service-exact"><summary>Exact pounds</summary><label for={`service-${service.id}`}>Your net spending, pounds</label><input id={`service-${service.id}`} data-service={service.id} type="number" min="0" max={inputPounds(BigInt(service.pence)*2n)} step="0.01" value={inputPounds(service.pence)} aria-describedby="control-limits" /><p class="source-line">Published {serviceExact(service.pence)}, printed as {(Number(BigInt(service.pence)/100000n)).toLocaleString('en-GB')} in £ thousand. MHCLG, <a href={budgetSource.url}>RA Part 1, {FREEZE_YEAR_TEXT}, {raCell(service.id)}, line {service.line}</a>. Change is your amount minus that figure; percentage choices are relative to it, rounded to the nearest penny.</p></details></div>
        </div>)}</div>
        <div class="actions reset-actions"><button type="button" data-freeze-reset>Start again with a freeze</button><button type="button" data-published-reset>Restore published baseline</button></div>
      </section>
      </div>
      <details class="assumptions"><summary>How this exercise works <span>Fixed tax base, grants and reserves. An exercise, not an actual deficit.</span></summary>
          <details class="preset-assumptions"><summary>Preset assumptions</summary><p class="source-line" id="preset-note" data-preset-note>Presets restore published services first. Referendum preset: change the own charge to the first penny at which a referendum would be needed. Services preset: keep the previous own charge and use 95% of each editable published service. Tax base and all held entries stay fixed.</p></details>
        <p>User requested scenario | {FREEZE_MODEL}. Starts at the previous own charge with current published services. A shortfall needs additional financing or lower net spending; a surplus has financing above spending. Arithmetic balance does not establish a deliverable or legally compliant budget.</p>
        <ul>{FREEZE_ASSUMPTIONS.map(text => <li>{text}</li>)}</ul>
        {pilot.grantDsgThousands > 0 && <p>Dedicated Schools Grant is included in the published education and financing figures. Education stays fixed here. Reserve accounting also varies with High Needs Stability Grant treatment; reserves are not a spending control. Source: MHCLG RA and specific grants, notes 1, 2 and 6.</p>}
        <p>Amounts on the result board and the service cards are in £ million to one decimal place; the exact pounds are one click away. The calculation keeps four decimal places and tests for an exact zero before rounding. A zero difference means the arithmetic balances under the stated assumptions. The gap bar's full width is the larger of the freeze starting gap and the gap from the 5% services preset.</p>
        <p class="source-line">Freeze starting calculation: ({publishedMoney(pilot.ownPence)} minus {publishedMoney(pilot.priorOwnPence)}) × {baseText}. Financing change is your charge minus the published current charge, multiplied by the fixed tax base.</p>
              <section class="baseline" aria-labelledby="baseline-title">
        <h2 id="baseline-title">The published starting point</h2>
        <div class="baseline-grid">
          <div><p class="fact-label">Own Band D, {`${Number(FREEZE_YEAR.slice(0,4))-1}/${FREEZE_YEAR.slice(2,4)}`}</p><strong>{publishedMoney(pilot.priorOwnPence)}</strong><RecordLine entry="set-band-d" sources={[priorRef]} tail={`${cell('annualPrior')}; Table 10 ${cell('table10Prior')}`} /></div>
          <div><p class="fact-label">Own Band D, {FREEZE_YEAR_TEXT}</p><strong>{publishedMoney(pilot.ownPence)}</strong><RecordLine entry="set-band-d" sources={[currentRef]} tail={`${cell('annualCurrent')}; Table 10 ${cell('table10Current')}`} /></div>
          <div><p class="fact-label">Fixed tax base, {FREEZE_YEAR_TEXT}</p><strong>{baseText}</strong><RecordLine entry="set-band-d" sources={[table10Ref]} tail={`${cell('table10Base')}, Band D equivalents`} /></div>
        </div>
        <p>These are this council's own charges excluding parish precepts, not the full household bill.{pilot.rule === 'district' && ' County council, police, fire and parish charges are outside this exercise.'}</p>
      </section>

        <section class="referendum-rule" aria-labelledby="rule-title"><h2 id="rule-title">The referendum rule</h2><p>{referendumExplanation(pilot.rule)} A referendum would be required when this rise is reached. It is not a cap.</p><RecordLine entry="set-referendum" sources={[rulesRef]} /></section>
      </details>
      <section class="section ledger" aria-labelledby="ledger-title">
        <h2 id="ledger-title">The published ledger stays unchanged</h2>
        <p>All service groups, including net income and published zeros, remain in the reference below. The rows after total service expenditure show revenue expenditure and its signed financing entries; they are not additional service totals. Published unit: £ thousand, kept in the table.</p>
        <RecordLine entry="set-services" sources={[raRef]} />
        <details><summary>Read the signed ledger and held service groups</summary>
          <div class="table-wrap"><table class="data"><caption>{pilot.name}, published RA {FREEZE_YEAR_TEXT}, £ thousand</caption><thead><tr><th scope="col">RA line</th><th scope="col">Item</th><th scope="col">Published</th><th scope="col">Treatment and source</th></tr></thead><tbody>{pilot.ledger.map(row=><tr><td data-label="RA line">{row.line}</td><th scope="row">{row.label}</th><td data-label="Published £ thousand">{row.thousands.toLocaleString('en-GB')}</td><td data-label="Treatment and source">{pilot.services.find(s=>s.id===row.id)?.heldReason ?? (pilot.services.find(s=>s.id===row.id)?.editable ? 'Scenario control above' : ['servicetot','revenuetot','ctrtot'].includes(row.id) ? 'Published reference total, not an additional control' : 'Held fixed because financing and non-service adjustments are not modelled')}<span class="source-line">RA Part 1, {raCell(row.id)}</span></td></tr>)}</tbody></table></div>
        </details>
        <details id="reconciliation"><summary>Source reconciliation and precision</summary>
          <p>The signed RA financing identity and service totals reconcile. The RA council-tax requirement is printed in thousands; Table 10 prints whole pounds. Their difference is {publishedMoney(pilot.reconciliation.raTotalDifferencePence)}, within half a printed thousand. Compatibility with that precision does not prove why the sources differ. This difference is kept separate from the scenario and is not a deficit.</p>
          <p>Table 10, Data_Billing: total ({pilot.evidence.table10Total.column}{pilot.evidence.table10Total.row}) including parish: {publishedMoney(pilot.reconciliation.table10TotalPence)}; own requirement ({pilot.evidence.table10Own.column}{pilot.evidence.table10Own.row}): {publishedMoney(pilot.reconciliation.table10OwnPence)}; parish requirement ({pilot.evidence.table10Parish.column}{pilot.evidence.table10Parish.row}): {publishedMoney(pilot.reconciliation.table10ParishPence)}.</p>
          {pilot.reconciliation.table10IdentityDifferencePence !== '0' && <p>Table 10 total minus its printed own and parish amounts is {publishedMoney(pilot.reconciliation.table10IdentityDifferencePence)}. Each is printed in whole pounds; this difference is compatible with that precision. All three printed figures remain unchanged.</p>}
          <p>The printed own Band D multiplied by the tax base differs from the published own requirement by {money(BigInt(pilot.reconciliation.ownYieldDifferenceUnits))}. Printed Band D is rounded to pennies. The model calculates changes from the published baseline; it does not replace the published requirement with this product.</p>
          <p>The RA total less its parish line, minus the Table 10 own requirement, is {publishedMoney(pilot.reconciliation.ownDifferencePence)}. This derived component is within the sum of the two half thousand pound bounds plus half a pound for its whole pound printing.</p>
          <p>The RA parish line minus the Table 10 parish requirement is {publishedMoney(pilot.reconciliation.parishDifferencePence)}. This is within half a printed thousand.</p>
          <p class="source-line">MHCLG, <a href={pilot.sources[3].url}>Table 10, Data_Billing, items 1, 2, 3, 7 and 9</a>, and <a href={budgetSource.url}>RA Part 1, {cell('raParish')} and {cell('raTotal')}, lines 821 and 990</a>.</p>
        </details>
      </section>
      {notes.length > 0 && <section class="section"><details><summary>Reviewed source notes</summary><ul>{notes.map(note=><li><p>{note.text}</p><p>{note.explanation}</p><p class="source-line">{note.citations.map(c=>`${c.file}, ${c.sheet}, ${c.column}${c.row}`).join('; ')}.</p></li>)}</ul></details></section>}
      <section class="section what-next" aria-labelledby="next-title" data-what-next>
        <h2 id="next-title">What next</h2>
        <ul class="next-links">
          <li><a href={`/councils/${pilot.slug}/`}>{pilot.name}'s council tax bill</a><span>Every band, with the published charges.</span></li>
          <li><a href="/increases/">Council tax increases</a><span>How bills changed across England.</span></li>
          <li><a href={`/compare/?a=${pilot.slug}&band=D&year=${CURRENT_YEAR}`} data-next-compare>Compare {pilot.name} with another council</a><span>{pilot.name} is filled in; choose the other side.</span></li>
          <li><a href={`/tools/budget/${pilot.slug}/`}>Guess {pilot.name}'s budget</a><span>The published budget as a game.</span></li>
        </ul>
        {neighbours.length > 0 && <div class="next-neighbours"><h3>Set a neighbour's budget</h3><p>{near.basis === 'county' ? `Other districts in ${near.county} with a set page.` : 'Councils whose areas touch this one, with a set page.'}</p><ul data-next-neighbours>{neighbours.map(n => <li><a href={budgetSetPath(n.slug)}>{n.name}</a></li>)}</ul></div>}
        <p><a href="/tools/budget/">Choose another council</a></p>
        <p class="privacy-note">Sources checked on {snapshot.reviewedOn}. This exercise is not a consultation and sends no choices to a council. No storage, saved choices, scenario network requests or analytics events. Choices reset on reload. Copy your scenario puts it on your clipboard only.</p>
      </section>
      <PageSources entries={entries} />
      <section class="print-scenario" aria-labelledby="print-title"><h2 id="print-title">Your scenario</h2><pre data-scenario-text></pre></section>
      <div class="mobile-result" data-mobile-result hidden aria-hidden="true"><span class="meter-label">Your scenario | {FREEZE_MODEL}</span><strong data-mobile-amount>{boardMoney(initial.remaining)}</strong><span class="meter-state" data-mobile-state>{stateWord(initial.status)}</span><span class="gap-bar meter-track" data-gap-bar data-side={initialSide} style={initialGap}><span class="gap-fill"></span><span class="gap-target"></span></span></div>
  </div>
  <script src="../../../../scripts/budget-freeze.ts"></script>
</BaseLayout>
<style>
  .budget-set{--card-pad:1rem;--meter-h:6.25rem;font-variant-numeric:tabular-nums}
  .set-top{display:flex;align-items:center;justify-content:space-between;gap:.5rem}.set-top :global(.budget-modes){margin-block:.25rem}
  .theme-icon{flex:none;display:grid;place-items:center;width:44px;padding:0}
  .source-line{overflow-wrap:anywhere;font-size:.8rem;line-height:1.4}

  /* The desk: the page's one band, holding the heading and the result board. Sticky beside the workbench on a desktop screen tall enough to hold it. */
