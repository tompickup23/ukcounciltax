---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SourceLine from '../../../components/SourceLine.astro';
import CouncilPicker from '../../../components/CouncilPicker.astro';
import DeskBand from '../../../components/DeskBand.astro';
import manifest from '../../../../data/pilots/budget-freeze-eligibility.json';
import {councilPages} from '../../../lib/paths';
import {englishRows} from '../../../lib/council-picker';
import {budgetYear, budgetFor, budgetSource} from '../../../lib/budget';
import {budgetSetEntry} from '../../../lib/budget-set-entry';
import {gameData} from '../../../lib/budget-game-data';
const pages = councilPages();
const available = pages.filter(({council}) => budgetFor(council.gss).council.status === 'available');
const missing = pages.filter(({council}) => budgetFor(council.gss).council.status === 'no return');
// Set mode for each council, from the C2 eligibility manifest: the link, or none where the council is not eligible.
const setLinks = Object.fromEntries(pages.map(({council}) => {
  const entry = budgetSetEntry(council.gss);
  return [council.gss, entry?.href?.endsWith('/set/') ? {href: entry.href, text: 'Set the budget'} : null];
}));
const setCount = Object.values(setLinks).filter(Boolean).length;
const featured = ['leeds', 'burnley', 'camden'].map(slug => pages.find(page => page.council.slug === slug)!);
// The same two counts the play band prints on the homepage and /tools/.
const sets = manifest.councils.filter((row) => row.eligible).length;
/** Each featured council's game as its round rail: the stops the game page's rail names, and no figure. */
const stopName = (kind: string, index: number) => kind === 'split' ? (index === 0 ? 'Council' : 'County') : kind === 'bill' ? 'Bill' : kind === 'funding' ? 'Funding' : 'Reserves';
const rails = featured.map(({council, tax}) => ({slug: council.slug, name: tax.name, setHref: setLinks[council.gss]?.href, stops: (gameData(council.gss, council.slug, tax.name)?.rounds ?? []).map((round, index) => stopName(round.kind, index))}));
---
<BaseLayout title="Council budget game" description={`Explore published ${budgetYear} council budgets, funding, reserves and Band D bill breakdowns for every English billing authority.`} path="/tools/budget/">
  <Breadcrumbs items={[{label: 'Tools', href: '/tools/'}, {label: 'Council budgets'}]} />
  <DeskBand id="hub-heading" level={1} hero top layout="stack" class="hub-desk" data-ground="desk" data-hub-band
    eyebrow={`Where the money goes | ${budgetYear}`} title="Explore your council's" accent="budget"
    lede="Find your council, then guess how it spends each pound or set the budget yourself. Both are built from the council's own published budget return.">
    <ul slot="copy" class="hub-ways">
      <li><span class="desk-kicker">Guess</span> Play the budget game, then see what the council published. <span class="hub-count">{available.length} councils</span></li>
      <li><span class="desk-kicker">Set</span> Change tax and service spending and see what is left to find. <span class="hub-count">{sets} councils</span></li>
    </ul>
    <div id="set-the-budget" class="hub-start">
      <h2 id="choose-a-council" class="hub-pick-title">Choose your council</h2>
      <CouncilPicker id="budget-picker" action={{heading: 'Play', links: setLinks, missing: 'Not available', pills: {lead: 'Guess', leadLabel: 'Guess, play the budget game', action: 'Set'}}} actionHash="#set-the-budget" rows={englishRows('budget')} caption={`English billing authorities and their ${budgetYear} budget game`} tailHeading={`No ${budgetYear} budget return received`} outside="That postcode is not in an English billing authority. The budget game covers councils in England only." />
    </div>
  </DeskBand>
  <section class="featured-budgets" aria-labelledby="featured-heading">
    <h2 id="featured-heading">Try a council</h2>
    <ul class="featured-rails">{rails.map(({slug, name, setHref, stops}) => <li class="featured-rail">
      <a class="featured-name" href={`/tools/budget/${slug}/`}>{name}</a>
      <ol class="featured-stops" aria-label={`The ${stops.length} rounds of the ${name} game`}>{stops.map((stop, index) => <li><span class="featured-stop-number" aria-hidden="true">{index + 1}</span>{stop}</li>)}</ol>
      <p class="featured-go"><a class="featured-pill" href={`/tools/budget/${slug}/`} aria-label={`Guess, play the budget game: ${name}`}>Guess</a>{setHref && <a class="featured-pill" href={setHref} aria-label={`Set the budget: ${name}`}>Set</a>}</p>
    </li>)}</ul>
  </section>
  <section class="section" aria-labelledby="about-budgets">
    <h2 id="about-budgets">About these budgets</h2>
    <p>Budget returns are available for {available.length} of {pages.length} English billing authorities. Set mode is available for {setCount} of the {pages.length}; each council's game page gives the reason where it is not. District pages also carry their county's budget. These are approved budgets, not outturn spending or a forecast of what will happen.</p>
    <SourceLine source={budgetSource()} />
    <p>Each game explores the service spending, funding and reserves behind the figures, and each answer links to the original source. The table lists every English billing authority in alphabetical order. The {missing.length} councils without a {budgetYear} return are listed after the others; their pages show the published council tax bill breakdown only.</p>
  </section>
  <details class="section"><summary>Councils without a budget return</summary><p>No {budgetYear} return was received in time for MHCLG's publication on 11 June 2026 for: {missing.map(({tax}) => tax.name).join(', ')}. Their pages show the published council tax bill breakdown only; no budget from another year is substituted.</p></details>
</BaseLayout>

<style>
.hub-start,#choose-a-council{scroll-margin-top:5rem}
.hub-desk{align-items:start}
.hub-ways{list-style:none;margin:var(--space-md) 0 0;padding:0;display:grid;gap:var(--space-xs);max-width:44rem}
.hub-ways li{color:var(--desk-soft)}
.hub-ways .desk-kicker{margin-right:.35rem}
.hub-count{white-space:nowrap;color:var(--desk-faint);font-size:var(--text-sm)}
.hub-count::before{content:"\00b7";margin:0 .35rem}
.hub-start{min-width:0}
.desk .hub-pick-title{margin:0;font-size:var(--text-lg);color:var(--desk-ink)}
.hub-start :global(.council-picker){margin-top:var(--space-sm)}
.hub-start :global(.picker-table){table-layout:fixed;width:100%}
.hub-start :global(.picker-action){width:9.5rem;border-left:1px solid var(--border)}
.hub-start :global(th[scope="row"] a){display:inline-flex;align-items:center;min-height:44px}
@media(max-width:599px){.hub-start :global(.picker-action){width:8.25rem}.hub-start :global(th[scope="row"]){overflow-wrap:anywhere}.hub-start :global(td.picker-pills a.picker-pill){padding:0 .7rem}}
.featured-budgets{margin-block:var(--space-xl)}
.featured-rails{list-style:none;margin:0;padding:0;display:grid;gap:var(--space-md)}
@media(min-width:700px){.featured-rails{grid-template-columns:repeat(3,minmax(0,1fr))}}
.featured-rail{display:flex;flex-direction:column;gap:var(--space-sm);min-width:0;padding:var(--space-md);border:1px solid var(--border);border-top:3px solid var(--accent);border-radius:var(--radius);background:var(--bg-card)}
.featured-name{font-family:var(--font-display);font-weight:600;font-size:var(--text-lg);line-height:1.2;text-decoration:none;min-height:44px;display:flex;align-items:center}
.featured-name:hover{text-decoration:underline}
.featured-stops{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.4rem}
.featured-stops li{display:inline-flex;align-items:center;gap:.4rem;padding:.25rem .65rem .25rem .3rem;border:1px solid var(--border);border-radius:999px;font-size:var(--text-sm);color:var(--text-muted);background:var(--bg)}
.featured-stop-number{display:inline-grid;place-items:center;width:1.5rem;height:1.5rem;border-radius:50%;background:var(--accent);color:var(--accent-ink);font-weight:600;font-size:var(--text-xs);font-variant-numeric:tabular-nums}
.featured-go{display:flex;gap:.4rem;margin:auto 0 0}
.featured-pill{display:inline-flex;align-items:center;min-height:44px;padding:0 1rem;border:1px solid var(--border-strong);border-radius:999px;font-weight:600;text-decoration:none}
.featured-pill:hover{border-color:var(--accent);background:var(--accent-wash)}
@media(forced-colors:active){.featured-pill,.featured-stops li{border-color:ButtonText}}
</style>
