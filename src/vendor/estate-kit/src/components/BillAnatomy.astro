---
/** One bill split by the bodies that charge it, reconciled to the published total; see src/charts/billAnatomy.ts. */
import ChartFigure from "./ChartFigure.astro";
import { billAnatomy, type BillAnatomyOptions } from "../../dist/src/index.js";

type Props = BillAnatomyOptions & { tableOpen?: boolean; class?: string };

const { tableOpen, class: className, ...opts } = Astro.props;
const out = billAnatomy(opts);
---
<ChartFigure out={out} keys={[...opts.parts, opts.total]} tableOpen={tableOpen} class={className} />
