---
/** One to four series figures as lines, drawn by Observable Plot at build; see src/charts/line.ts. */
import ChartFigure from "./ChartFigure.astro";
import { line, type LineOptions } from "../../dist/src/index.js";

type Props = LineOptions & { tableOpen?: boolean; class?: string };

const { tableOpen, class: className, ...opts } = Astro.props;
const out = line(opts);
---
<ChartFigure out={out} keys={opts.series} tableOpen={tableOpen} class={className} />
