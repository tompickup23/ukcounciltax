---
/** A place and its neighbours shaded by a rate, from figure keys and the site's own boundaries; see src/charts/locatorMap.ts. */
import ChartFigure from "./ChartFigure.astro";
import { locatorMap, type LocatorMapOptions } from "../../dist/src/index.js";

type Props = LocatorMapOptions & { tableOpen?: boolean; class?: string };

const { tableOpen, class: className, ...opts } = Astro.props;
const out = locatorMap(opts);
---
<ChartFigure out={out} keys={Object.values(opts.values)} tableOpen={tableOpen} class={className} />
